  )}

</Layout>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script is:inline>
  (function() {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/flatpickr';
    s.onload = function() {
      var today = new Date();
      today.setHours(0,0,0,0);
      flatpickr('#check_in_date', {
        dateFormat: 'Y-m-d',   // 実際の input value は YYYY-MM-DD（API送信用）
        altInput: true,         // 表示用の別インプットを生成
        altFormat: 'Y-m-d',    // ユーザーには YYYY-MM-DD で表示
        minDate: today,
        disableMobile: true,
        locale: { firstDayOfWeek: 0 }
      });
    };
    document.head.appendChild(s);
  })();
</script>
<script define:vars={{ maxGuests, currentUserPhone: currentUser.phone || '' }}>
  // Pre-fill phone number from user profile
  (function() {
    if (currentUserPhone) {
      let phoneLocal = document.getElementById('phone_local');
      let phoneSel = document.getElementById('phone_code');
      // Try to match country code from stored phone number
      let knownCodes = ['+880','+855','+856','+971','+966','+974','+972','+358','+420','+380','+234','+254','+212','+351','+852','+886','+977','+95','+92','+94','+91','+86','+82','+81','+66','+84','+65','+62','+63','+61','+64','+55','+57','+56','+54','+52','+51','+49','+48','+47','+46','+45','+44','+43','+41','+39','+36','+34','+33','+32','+31','+30','+27','+20','+90','+7','+1'];
      let matchedCode = '';
      let localPart = currentUserPhone;
      for (let i = 0; i < knownCodes.length; i++) {
        if (currentUserPhone.startsWith(knownCodes[i])) {
          matchedCode = knownCodes[i];
          localPart = currentUserPhone.slice(knownCodes[i].length);
          break;
        }
      }
      if (phoneLocal) phoneLocal.value = localPart;
      if (phoneSel && matchedCode) {
        // Find matching option (handle +1-CA etc)
        for (let j = 0; j < phoneSel.options.length; j++) {
          let optVal = phoneSel.options[j].value.replace(/-[A-Z]+$/, '');
          if (optVal === matchedCode) { phoneSel.selectedIndex = j; break; }
        }
      }
    }
  })();

  // Phone: combine country code + local number into hidden #guest_phone
  (function() {
    var sel = document.getElementById('phone_code');
    var manual = document.getElementById('phone_code_manual');

    // "Other" toggle
    if (sel && manual) {
      sel.addEventListener('change', function() {
        if (sel.value === 'other') {
          manual.classList.remove('hidden');
          manual.focus();
          sel.classList.add('hidden');
        }
        syncPhone();
      });
      manual.addEventListener('blur', function() {
        if (!manual.value.trim()) {
          manual.classList.add('hidden');
          sel.classList.remove('hidden');
          sel.value = '+1';
        }
      });
      manual.addEventListener('input', syncPhone);
    }

    function syncPhone() {
      let code = '';
      if (sel && sel.classList.contains('hidden') && manual) {
        code = manual.value.trim();
      } else {
        code = sel?.value || '';
      }
      var local = (document.getElementById('phone_local')?.value || '').trim();
      // strip "-CA" suffix (Canada shares +1)
      var dialCode = code.replace(/-[A-Z]+$/, '');
      var hidden = document.getElementById('guest_phone');
      if (hidden) hidden.value = local ? dialCode + local : '';
    }
    document.getElementById('phone_local')?.addEventListener('input', syncPhone);
    syncPhone();
  })();

  // date input — value is already in YYYY-MM-DD format, no sync needed

  // Max guests: show error immediately
  if (maxGuests > 0) {
    let guestSelIds = ['adults', 'children', 'infants'];

    function checkGuestTotal() {
      let total = 0;
      guestSelIds.forEach(function(id) {
        total += parseInt(document.getElementById(id)?.value || '0') || 0;
      });
      let errEl = document.getElementById('guests-error');
      let over = total > maxGuests;

      if (errEl) {
        errEl.style.display = over ? 'flex' : 'none';
      }

      // Highlight selects in red when over
      guestSelIds.forEach(function(id) {
        let el = document.getElementById(id);
        if (!el) return;
        if (over) {
          el.style.borderColor = '#ef4444';
          el.style.boxShadow = '0 0 0 2px rgba(239,68,68,0.2)';
        } else {
          el.style.borderColor = '';
          el.style.boxShadow = '';
        }
      });

      return !over;
    }

    guestSelIds.forEach(function(id) {
      let el = document.getElementById(id);
      el?.addEventListener('change', checkGuestTotal);
      el?.addEventListener('input', checkGuestTotal);  // for mobile
    });

    document.querySelector('form')?.addEventListener('submit', function(e) {
      if (!checkGuestTotal()) {
        e.preventDefault();
        document.getElementById('guests-error')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, true);
  }

  // ── Per-field blur/input: clear or re-validate error after user correction ──
  (function() {
    var isJa = window.location.pathname.startsWith('/ja/') || window.location.pathname === '/ja';

    function clearFieldError(fieldId) {
      var errEl = document.getElementById('err-' + fieldId);
      var inp    = document.getElementById(fieldId);
      if (errEl) {
        var sp = errEl.querySelector('span:last-child');
        if (sp) sp.textContent = '';
        errEl.classList.add('hidden');
      }
      if (inp) { inp.style.borderColor = ''; inp.style.boxShadow = ''; }
    }

    function showFieldError(fieldId, msg) {
      var errEl = document.getElementById('err-' + fieldId);
      var inp    = document.getElementById(fieldId);
      if (errEl) {
        var sp = errEl.querySelector('span:last-child');
        if (sp) sp.textContent = msg;
        errEl.classList.remove('hidden');
      }
      if (inp) {
        inp.style.borderColor = '#ef4444';
        inp.style.boxShadow   = '0 0 0 2px rgba(239,68,68,0.2)';
      }
    }

    // guest_name
    var nameEl = document.getElementById('guest_name');
    if (nameEl) {
      nameEl.addEventListener('input', function() {
        if (this.value.trim()) clearFieldError('guest_name');
      });
      nameEl.addEventListener('blur', function() {
        if (!this.value.trim()) {
          showFieldError('guest_name', isJa ? 'お名前を入力してください。' : 'Please enter your name.');
        } else {
          clearFieldError('guest_name');
        }
      });
    }

    // guest_email
    var emailEl = document.getElementById('guest_email');
    if (emailEl) {
      emailEl.addEventListener('input', function() {
        var v = this.value.trim();
        if (v && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) clearFieldError('guest_email');
      });
      emailEl.addEventListener('blur', function() {
        var v = this.value.trim();
        if (!v) {
          showFieldError('guest_email', isJa ? 'メールアドレスを入力してください。' : 'Please enter your email address.');
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
          showFieldError('guest_email', isJa ? '有効なメールアドレスを入力してください。' : 'Please enter a valid email address.');
        } else {
          clearFieldError('guest_email');
        }
      });
    }

    // phone_local
    var phoneLocalEl = document.getElementById('phone_local');
    if (phoneLocalEl) {
      phoneLocalEl.addEventListener('input', function() {
        if (this.value.trim()) clearFieldError('phone_local');
      });
      phoneLocalEl.addEventListener('blur', function() {
        if (!this.value.trim()) {
          showFieldError('phone_local', isJa ? '電話番号を入力してください。' : 'Please enter your phone number.');
        } else {
          clearFieldError('phone_local');
        }
      });
    }

    // check_in_date: flatpickr sets the value and fires a 'change' event
    var dateEl = document.getElementById('check_in_date');
    if (dateEl) {
      dateEl.addEventListener('change', function() {
        if (this.value) clearFieldError('check_in_date');
      });
    }
  })();

  // ── Keep the summary showing what is actually being booked, not just the
  // plan: date, party size and any request the guest typed.
  (function () {
    var dateEl = document.getElementById('check_in_date');
    var notesEl = document.getElementById('notes');
    var outDate = document.getElementById('sum-date');
    var outGuests = document.getElementById('sum-guests');
    var outNotes = document.getElementById('sum-notes');
    var notesWrap = document.getElementById('sum-notes-wrap');
    if (!outDate && !outGuests) return;
    var isJa = document.documentElement.lang === 'ja';

    function n(id) { return parseInt(document.getElementById(id)?.value || '0') || 0; }

    function fmtDate(v) {
      if (!v) return '—';
      var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v);
      if (!m) return v;
      var d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
      if (isNaN(d.getTime())) return v;
      try {
        return d.toLocaleDateString(isJa ? 'ja-JP' : 'en-US',
          { year: 'numeric', month: 'short', day: 'numeric', weekday: 'short' });
      } catch (e) { return v; }
    }

    function sync() {
      if (outDate) outDate.textContent = fmtDate(dateEl?.value);
      if (outGuests) {
        var a = n('adults'), c = n('children'), i = n('infants');
        var parts = [];
        if (isJa) {
          parts.push('大人 ' + a);
          if (c) parts.push('子供 ' + c);
          if (i) parts.push('幼児 ' + i);
        } else {
          parts.push(a + (a === 1 ? ' adult' : ' adults'));
          if (c) parts.push(c + (c === 1 ? ' child' : ' children'));
          if (i) parts.push(i + (i === 1 ? ' infant' : ' infants'));
        }
        outGuests.textContent = parts.join(' · ');
      }
      var natEl = document.getElementById('guest_nationality');
      var outNat = document.getElementById('sum-nationality');
      var natWrap = document.getElementById('sum-nationality-wrap');
      if (outNat && natWrap) {
        var nv = (natEl?.value || '').trim();
        outNat.textContent = nv;
        natWrap.classList.toggle('hidden', !nv);
      }
      if (outNotes && notesWrap) {
        var v = (notesEl?.value || '').trim();
        outNotes.textContent = v;
        notesWrap.classList.toggle('hidden', !v);
      }
    }

    ['check_in_date', 'adults', 'children', 'infants', 'notes', 'guest_nationality'].forEach(function (id) {
      var el = document.getElementById(id);
      el?.addEventListener('change', sync);
      el?.addEventListener('input', sync);
    });
    sync();
  })();

  // ── Add-ons: keep the displayed total in step with what the server will
  // charge. The server re-prices everything on create/capture; this is display
  // only, using the same formula.
  (function () {
    // The fee note is a button, not a hover title, so it also works on touch.
    var feeBtn = document.getElementById('fee-info-btn');
    var feeText = document.getElementById('fee-info-text');
    feeBtn?.addEventListener('click', function () {
      var open = feeText.classList.toggle('hidden') === false;
      feeBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    var boxes = document.querySelectorAll('.booking-option');
    if (!boxes.length) return;
    var basePriceUsd = Number(document.getElementById('sum-total')?.dataset.baseUsd || 0);
    var currency = document.getElementById('sum-total')?.dataset.currency || 'USD';
    var isJaPage = document.documentElement.lang === 'ja';

    // "x 1 + 1" told the guest nothing. Spell out who is being charged.
    function partyLabel(adults, children, infants) {
      var parts = [];
      if (isJaPage) {
        parts.push('大人' + adults);
        if (children) parts.push('子供' + children);
        if (infants) parts.push('幼児' + infants);
        return parts.join('・');
      }
      parts.push(adults + (adults === 1 ? ' adult' : ' adults'));
      if (children) parts.push(children + (children === 1 ? ' child' : ' children'));
      if (infants) parts.push(infants + (infants === 1 ? ' infant' : ' infants'));
      return parts.join(' + ');
    }
    function guestsLabel(n) {
      return isJaPage ? (n + '名') : (n + (n === 1 ? ' guest' : ' guests'));
    }
    var zeroDecimal = ['JPY','HUF','TWD','KRW','VND','CLP','ISK'].indexOf(currency) !== -1;

    function money(v) {
      var digits = zeroDecimal ? 0 : 2;
      try {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: currency, minimumFractionDigits: 0, maximumFractionDigits: digits }).format(v);
      } catch (e) {
        return currency + ' ' + v.toFixed(digits);
      }
    }
    // Same shape as the plan price: local amount with the USD equivalent.
    function dual(local, usd) {
      var u = '$' + usd.toFixed(2);
      return currency === 'USD' ? u : money(local) + ' (≈ ' + u + ' USD)';
    }

    function num(id) { return parseInt(document.getElementById(id)?.value || '0') || 0; }

    function recalc() {
      var adults = Math.max(1, num('adults'));
      var children = num('children');
      var infants = num('infants');
      var optionsUsd = 0, optionsLocal = 0;
      var lines = [];
      Array.prototype.forEach.call(boxes, function (b) {
        if (!b.checked) return;
        var unit = Number(b.dataset.priceUsd || 0);
        var child = b.dataset.childPriceUsd === '' ? 0 : Number(b.dataset.childPriceUsd || 0);
        var unitL = Number(b.dataset.priceLocal || unit);
        var childL = b.dataset.childPriceLocal === '' ? 0 : Number(b.dataset.childPriceLocal || 0);
        var infantU = b.dataset.infantPriceUsd === '' ? 0 : Number(b.dataset.infantPriceUsd || 0);
        var infantL = b.dataset.infantPriceLocal === '' ? 0 : Number(b.dataset.infantPriceLocal || 0);
        var type = b.dataset.pricingType;
        var usd, loc, qty;
        if (type === 'per_person') {
          // The hotel decides which bands this option counts.
          var people = (b.dataset.countsAdults === '1' ? adults : 0)
            + (b.dataset.countsChildren === '1' ? children : 0)
            + (b.dataset.countsInfants === '1' ? infants : 0);
          usd = unit * people; loc = unitL * people;
          qty = guestsLabel(people);
        } else if (type === 'per_adult_child') {
          usd = unit * adults + child * children + infantU * infants;
          loc = unitL * adults + childL * children + infantL * infants;
          // Infants only appear when they actually cost something.
          qty = partyLabel(adults, children, infantU ? infants : 0);
        } else {
          usd = unit; loc = unitL; qty = '';
        }
        optionsUsd += usd; optionsLocal += loc;
        lines.push('<div class="flex justify-between gap-2"><span>' + (b.dataset.label || '') +
          (qty ? ' <span class="text-gray-300">' + qty + '</span>' : '') +
          '</span><span class="whitespace-nowrap">' + dual(loc, Math.round(usd * 100) / 100) + '</span></div>');
      });
      optionsUsd = Math.round(optionsUsd * 100) / 100;
      optionsLocal = zeroDecimal ? Math.round(optionsLocal) : Math.round(optionsLocal * 100) / 100;

      var chargeable = Math.round((basePriceUsd + optionsUsd) * 100) / 100;
      var processing = Math.round(chargeable * 0.06 * 100) / 100;
      var serviceBase = Math.round(chargeable * 0.10 * 100) / 100;
      var service = serviceBase < 10 ? Math.round((10 - serviceBase) * 100) / 100 : 0;
      var total = Math.round((chargeable + processing + service) * 100) / 100;

      var optRow = document.getElementById('sum-options-row');
      if (optRow) optRow.classList.toggle('hidden', optionsUsd <= 0);
      var optEl = document.getElementById('sum-options');
      if (optEl) optEl.textContent = dual(optionsLocal, optionsUsd);
      var linesEl = document.getElementById('sum-options-lines');
      if (linesEl) linesEl.innerHTML = lines.join('');
      var procEl = document.getElementById('sum-processing');
      if (procEl) procEl.textContent = '$' + processing.toFixed(2);
      var svcRow = document.getElementById('sum-service-row');
      if (svcRow) svcRow.classList.toggle('hidden', service <= 0);
      var svcEl = document.getElementById('sum-service');
      if (svcEl) svcEl.textContent = '$' + service.toFixed(2);
      var totEl = document.getElementById('sum-total');
      if (totEl) totEl.textContent = '$' + total.toFixed(2);
    }

    Array.prototype.forEach.call(boxes, function (b) { b.addEventListener('change', recalc); });
    ['adults', 'children', 'infants'].forEach(function (id) {
      document.getElementById(id)?.addEventListener('change', recalc);
    });
    recalc();
  })();
</script>
