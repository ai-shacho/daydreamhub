---
import Layout from '../layouts/Layout.astro';
import { resolvePayPalConfig } from '../lib/paypal';
import PayPalButton from './PayPalButton.astro';
import { getLocale, t, localePath } from '../lib/i18n';
import { formatMoney, convertLocalToUsd, formatLocalWithUsd } from '../lib/currency';
import { getExchangeRates } from '../lib/tools';
import { COUNTRIES } from '../lib/data/countries';
import type { GuestSession } from '../lib/guestSession';

// The whole booking screen, rendered by both /booking/[planId] and
// /ja/booking/[planId]. It reads its language from the URL, so the two routes
// stay one implementation instead of a fork that quietly drifts.
interface Props { planId: string; currentUser: GuestSession }
const { planId, currentUser } = Astro.props;

const locale = getLocale(Astro.url);
const planIdNum = parseInt(planId || '0');
const isTestMode = Astro.url.searchParams.get('test_pay') === '1';

let plan: any = null;
let dbAvailable = false;
let paypalClientId = '';
let planOptions: any[] = [];

try {
  const runtime = (Astro.locals as any).runtime;
  const db = runtime?.env?.DB;
  paypalClientId = (resolvePayPalConfig(runtime?.env).clientId || import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || '').trim();
  if (db) {
    dbAvailable = true;
    plan = await db.prepare(
      "SELECT p.*, p.cancellation_hours, h.name as hotel_name, h.name_ja as hotel_name_ja, h.slug as hotel_slug, h.city, h.country, h.cancellation_policy as hotel_cancellation_policy, h.currency as hotel_currency, h.infant_max_age, h.child_max_age FROM plans p JOIN hotels h ON h.id = p.hotel_id WHERE p.id = ?"
    ).bind(planIdNum).first();
    // Paid add-ons the hotel offers with this plan.
    try {
      const optRes = await db.prepare(
        'SELECT * FROM plan_options WHERE plan_id = ? AND is_active = 1 ORDER BY sort_order ASC, id ASC'
      ).bind(planIdNum).all();
      planOptions = (optRes?.results || []) as any[];
    } catch { planOptions = []; }
  }
} catch (e) {
  dbAvailable = false;
}

if (!dbAvailable) {
  const samplePlans = [
    { id: 1, name: "4-Hour Workspace", name_ja: "4時間ワークスペース", price_usd: 25, check_in_time: "09:00", check_out_time: "13:00", plan_type: "day-use", max_guests: 1, duration_hours: 4, hotel_name: "The Work Loft Bangkok", hotel_name_ja: "ザ ワークロフト バンコク", hotel_slug: "work-loft-bangkok", city: "Bangkok", country: "Thailand" },
    { id: 2, name: "Full Day Office", name_ja: "1日オフィス", price_usd: 45, check_in_time: "09:00", check_out_time: "18:00", plan_type: "day-use", max_guests: 2, duration_hours: 9, hotel_name: "The Work Loft Bangkok", hotel_name_ja: "ザ ワークロフト バンコク", hotel_slug: "work-loft-bangkok", city: "Bangkok", country: "Thailand" },
    { id: 6, name: "6-Hour Layover", name_ja: "6時間レイオーバー", price_usd: 40, check_in_time: "00:00", check_out_time: "06:00", plan_type: "day-use", max_guests: 2, duration_hours: 6, hotel_name: "Airport Transit Hotel", hotel_name_ja: "エアポート トランジットホテル", hotel_slug: "airport-transit-hotel", city: "Singapore", country: "Singapore" },
    { id: 10, name: "Romantic Half Day", name_ja: "ロマンチック半日", price_usd: 80, check_in_time: "12:00", check_out_time: "18:00", plan_type: "day-use", max_guests: 2, duration_hours: 6, hotel_name: "Romance Suite Bali", hotel_name_ja: "ロマンス スイート バリ", hotel_slug: "romance-suite-bali", city: "Bali", country: "Indonesia" },
    { id: 14, name: "Luxury Day Pass", name_ja: "ラグジュアリーデイパス", price_usd: 150, check_in_time: "10:00", check_out_time: "18:00", plan_type: "day-use", max_guests: 2, duration_hours: 8, hotel_name: "The Ritz-Carlton KL", hotel_name_ja: "ザ・リッツカールトン KL", hotel_slug: "ritz-carlton-kl", city: "Kuala Lumpur", country: "Malaysia" },
    { id: 18, name: "Beach & Pool Day", name_ja: "ビーチ＆プールデイ", price_usd: 55, check_in_time: "09:00", check_out_time: "17:00", plan_type: "day-use", max_guests: 4, duration_hours: 8, hotel_name: "Daycation Paradise", hotel_name_ja: "デイケーション パラダイス", hotel_slug: "daycation-paradise", city: "Bali", country: "Indonesia" },
  ];
  plan = samplePlans.find((p) => p.id === planIdNum) || null;
  paypalClientId = 'sandbox';
}

const displayPlanName = plan ? (locale === 'ja' && plan.name_ja ? plan.name_ja : plan.name) : '';
const displayHotelName = plan ? (locale === 'ja' && plan.hotel_name_ja ? plan.hotel_name_ja : plan.hotel_name) : '';
const timeSlot = plan?.check_in_time && plan?.check_out_time ? `${plan.check_in_time} - ${plan.check_out_time}` : '';
const today = new Date().toISOString().split('T')[0];
const dateParam = Astro.url.searchParams.get('date') || today;
const todayParts = today.split('-');
const bookingMonths = [
  { val: '01', label: 'Jan' }, { val: '02', label: 'Feb' }, { val: '03', label: 'Mar' },
  { val: '04', label: 'Apr' }, { val: '05', label: 'May' }, { val: '06', label: 'Jun' },
  { val: '07', label: 'Jul' }, { val: '08', label: 'Aug' }, { val: '09', label: 'Sep' },
  { val: '10', label: 'Oct' }, { val: '11', label: 'Nov' }, { val: '12', label: 'Dec' },
];
const bookingCurYear = new Date().getFullYear();
const bookingYears = [bookingCurYear, bookingCurYear + 1, bookingCurYear + 2];
const bookingDays = Array.from({ length: 31 }, (_, i) => String(i + 1).padStart(2, '0'));
const maxGuests = plan?.max_guests || 10;
const adultOptions = Array.from({ length: maxGuests }, (_, i) => i + 1);       // 1〜maxGuests
const guestOptions = Array.from({ length: maxGuests + 1 }, (_, i) => i);       // 0〜maxGuests

const planTypeColors = {
  'day-use': 'bg-blue-100 text-blue-700',
  'overnight': 'bg-indigo-100 text-indigo-700',
  'hourly': 'bg-green-100 text-green-700',
};
const planTypeClass = plan ? (planTypeColors[plan.plan_type || ''] || 'bg-gray-100 text-gray-700') : '';

// Displayed totals use the same payment-time conversion as payments/create.ts
// (daily-cached rate) so the amount shown equals the amount charged.
let effectivePriceUsd: number = Number(plan?.price_usd || 0);
try {
  const runtime = (Astro.locals as any).runtime;
  const dbFx = runtime?.env?.DB;
  const cur = String((plan as any)?.hotel_currency || 'USD').toUpperCase();
  if (dbFx && plan && cur !== 'USD' && (plan as any).price_local != null) {
    const fxRates = await getExchangeRates(dbFx);
    const fresh = convertLocalToUsd(Number((plan as any).price_local), cur, fxRates);
    if (fresh != null) effectivePriceUsd = fresh;
  }
} catch {}
---

<Layout title={plan ? `${t('booking.title', locale)} - ${displayPlanName} | ${t('site.name', locale)}` : t('booking.plan_not_found', locale)} description={plan ? `${t('booking.title', locale)} - ${displayHotelName}` : t('booking.plan_not_found_desc', locale)}>

  {plan ? (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
      <!-- Breadcrumb -->
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center text-sm text-gray-500 space-x-2">
          <li>
            <a href={localePath('/', locale)} class="hover:text-[#45A2C1] transition-colors">
              {t('breadcrumb.home', locale)}
            </a>
          </li>
          <li><span class="mx-1">/</span></li>
          <li>
            <a href={localePath('/search', locale)} class="hover:text-[#45A2C1] transition-colors">
              {t('breadcrumb.hotels', locale)}
            </a>
          </li>
          <li><span class="mx-1">/</span></li>
          <li>
            <a href={localePath(`/hotel/${plan.hotel_slug}`, locale)} class="hover:text-[#45A2C1] transition-colors truncate max-w-[150px] inline-block">
              {displayHotelName}
            </a>
          </li>
          <li><span class="mx-1">/</span></li>
          <li class="text-gray-800 font-medium" aria-current="page">
            {t('breadcrumb.book', locale)}
          </li>
        </ol>
      </nav>

      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">
        {t('booking.title', locale)}
      </h1>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left column: Booking Form -->
        <div class="lg:col-span-2">
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-5">
              {t('booking.guest_info', locale)}
            </h2>
            <form id="booking-form" class="space-y-5" novalidate>
              <div>
                <label for="guest_name" class="block text-sm font-medium text-gray-700 mb-1">
                  {t('booking.guest_name', locale)} <span class="text-red-500">*</span>
                </label>
                <input type="text" id="guest_name" name="guest_name" required value={currentUser.name || ''} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none transition-colors" placeholder={locale === 'ja' ? '山田 太郎' : 'John Doe'} />
                <p id="err-guest_name" class="hidden mt-1.5 text-xs text-red-600 flex items-center gap-1"><span>⚠</span><span></span></p>
              </div>
              <div>
                <label for="guest_email" class="block text-sm font-medium text-gray-700 mb-1">
                  {t('booking.email', locale)} <span class="text-red-500">*</span>
                </label>
                <input type="email" id="guest_email" name="guest_email" required value={currentUser.email || ''} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none transition-colors" placeholder="email@example.com" />
                <p id="err-guest_email" class="hidden mt-1.5 text-xs text-red-600 flex items-center gap-1"><span>⚠</span><span></span></p>
              </div>
              <div>
                <label for="phone_local" class="block text-sm font-medium text-gray-700 mb-1">
                  {t('booking.phone', locale)} <span class="text-red-500">*</span>
                </label>
                <div class="flex gap-2">
                  <select id="phone_code" class="flex-shrink-0 w-32 px-2 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none bg-white transition-colors">
                    <option value="+1" selected>🇺🇸 +1 US</option>
                    <option value="+1-CA">🇨🇦 +1 Canada</option>
                    <option value="+81">🇯🇵 +81 Japan</option>
                    <option value="+44">🇬🇧 +44 UK</option>
                    <option value="+82">🇰🇷 +82 Korea</option>
                    <option value="+86">🇨🇳 +86 China</option>
                    <option value="+852">🇭🇰 +852 HK</option>
                    <option value="+886">🇹🇼 +886 Taiwan</option>
                    <option value="+65">🇸🇬 +65 Singapore</option>
                    <option value="+66">🇹🇭 +66 Thailand</option>
                    <option value="+84">🇻🇳 +84 Vietnam</option>
                    <option value="+62">🇮🇩 +62 Indonesia</option>
                    <option value="+60">🇲🇾 +60 Malaysia</option>
                    <option value="+63">🇵🇭 +63 Philippines</option>
                    <option value="+855">🇰🇭 +855 Cambodia</option>
                    <option value="+856">🇱🇦 +856 Laos</option>
                    <option value="+95">🇲🇲 +95 Myanmar</option>
                    <option value="+91">🇮🇳 +91 India</option>
                    <option value="+92">🇵🇰 +92 Pakistan</option>
                    <option value="+94">🇱🇰 +94 Sri Lanka</option>
                    <option value="+977">🇳🇵 +977 Nepal</option>
                    <option value="+880">🇧🇩 +880 Bangladesh</option>
                    <option value="+61">🇦🇺 +61 Australia</option>
                    <option value="+64">🇳🇿 +64 NZ</option>
                    <option value="+971">🇦🇪 +971 UAE</option>
                    <option value="+966">🇸🇦 +966 Saudi</option>
                    <option value="+974">🇶🇦 +974 Qatar</option>
                    <option value="+972">🇮🇱 +972 Israel</option>
                    <option value="+90">🇹🇷 +90 Turkey</option>
                    <option value="+49">🇩🇪 +49 Germany</option>
                    <option value="+33">🇫🇷 +33 France</option>
                    <option value="+39">🇮🇹 +39 Italy</option>
                    <option value="+34">🇪🇸 +34 Spain</option>
                    <option value="+351">🇵🇹 +351 Portugal</option>
                    <option value="+31">🇳🇱 +31 Netherlands</option>
                    <option value="+32">🇧🇪 +32 Belgium</option>
                    <option value="+41">🇨🇭 +41 Switzerland</option>
                    <option value="+43">🇦🇹 +43 Austria</option>
                    <option value="+46">🇸🇪 +46 Sweden</option>
                    <option value="+47">🇳🇴 +47 Norway</option>
                    <option value="+45">🇩🇰 +45 Denmark</option>
                    <option value="+358">🇫🇮 +358 Finland</option>
                    <option value="+48">🇵🇱 +48 Poland</option>
                    <option value="+420">🇨🇿 +420 Czech</option>
                    <option value="+36">🇭🇺 +36 Hungary</option>
                    <option value="+30">🇬🇷 +30 Greece</option>
                    <option value="+353">🇮🇪 +353 Ireland</option>
                    <option value="+7">🇷🇺 +7 Russia</option>
                    <option value="+380">🇺🇦 +380 Ukraine</option>
                    <option value="+55">🇧🇷 +55 Brazil</option>
                    <option value="+52">🇲🇽 +52 Mexico</option>
                    <option value="+54">🇦🇷 +54 Argentina</option>
                    <option value="+56">🇨🇱 +56 Chile</option>
                    <option value="+57">🇨🇴 +57 Colombia</option>
                    <option value="+51">🇵🇪 +51 Peru</option>
                    <option value="+27">🇿🇦 +27 S. Africa</option>
                    <option value="+234">🇳🇬 +234 Nigeria</option>
                    <option value="+254">🇰🇪 +254 Kenya</option>
                    <option value="+20">🇪🇬 +20 Egypt</option>
                    <option value="+212">🇲🇦 +212 Morocco</option>
                    <option value="other">🌐 Other...</option>
                  </select>
                  <input type="text" id="phone_code_manual" placeholder="+___" maxlength="5"
                    class="hidden flex-shrink-0 w-20 px-2 py-2.5 border border-gray-300 rounded-lg text-sm text-center focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none transition-colors" />
                  <input type="tel" id="phone_local" autocomplete="tel-national"
                    class="flex-1 px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none transition-colors"
                    placeholder="90-1234-5678" />
                </div>
                <input type="hidden" id="guest_phone" name="guest_phone" />
                <p id="err-phone_local" class="hidden mt-1.5 text-xs text-red-600 flex items-center gap-1"><span>⚠</span><span></span></p>
              </div>
              <div>
                <label for="guest_nationality" class="block text-sm font-medium text-gray-700 mb-1">
                  {locale === 'ja' ? '国籍' : 'Nationality'}
                </label>
                <select id="guest_nationality" name="guest_nationality"
                  class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none bg-white transition-colors">
                  <option value="">{locale === 'ja' ? '— 選択してください —' : '— Select —'}</option>
                  {COUNTRIES.map(([code, name]) => (
                    <option value={name}>{name}</option>
                  ))}
                </select>
                <p class="mt-1.5 text-xs text-gray-500">
                  {locale === 'ja'
                    ? 'ホテルの受け入れ準備（本人確認書類や宿泊者名簿の記載）のためにお伺いしています。'
                    : 'Hotels ask for this to prepare for your arrival — the ID they expect and any guest register they must keep.'}
                </p>
              </div>
              <div>
                <label for="check_in_date" class="block text-sm font-medium text-gray-700 mb-1">
                  {t('booking.date', locale)} <span class="text-red-500">*</span>
                </label>
                <input type="text" id="check_in_date" name="check_in_date" required
                  placeholder={locale === 'ja' ? '日付を選択' : 'Select date'} autocomplete="off" readonly
                  value={dateParam}
                  class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none bg-white cursor-pointer"
                />
                <p id="err-check_in_date" class="hidden mt-1.5 text-xs text-red-600 flex items-center gap-1"><span>⚠</span><span></span></p>
              </div>
              {plan?.max_guests && (
                <div class="flex items-center gap-1.5 text-xs text-slate-500 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2">
                  <svg class="w-3.5 h-3.5 text-[#45A2C1]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                  </svg>
                  Max <strong class="text-slate-700 mx-1">{plan.max_guests}</strong> guests total (adults + children + infants)
                </div>
              )}
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label for="adults" class="block text-sm font-medium text-gray-700 mb-1">
                    {t('booking.adults', locale)} <span class="text-red-500">*</span>
                  </label>
                  <select id="adults" name="adults" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none bg-white transition-colors">
                    {adultOptions.map(n => <option value={n} selected={n === 1}>{n}</option>)}
                  </select>
                </div>
                <div>
                  <label for="children" class="block text-sm font-medium text-gray-700 mb-1">
                    {t('booking.children', locale)}
                  </label>
                  <select id="children" name="children" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none bg-white transition-colors">
                    {guestOptions.map(n => <option value={n} selected={n === 0}>{n}</option>)}
                  </select>
                </div>
                <div>
                  <label for="infants" class="block text-sm font-medium text-gray-700 mb-1">
                    {t('booking.infants', locale)}
                  </label>
                  <select id="infants" name="infants" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none bg-white transition-colors">
                    {guestOptions.map(n => <option value={n} selected={n === 0}>{n}</option>)}
                  </select>
                </div>
              </div>
              <div id="guests-error" style="display:none" class="flex items-center gap-2 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <span>This plan allows a maximum of <strong>{maxGuests}</strong> guests in total (adults + children + infants).</span>
              </div>
              <p id="err-adults" class="hidden mt-1.5 text-xs text-red-600 flex items-center gap-1"><span>⚠</span><span></span></p>
              <p class="text-xs text-gray-500">
                {(plan.infant_max_age != null || plan.child_max_age != null) && (
                  <span class="block">
                    {locale === 'ja'
                      ? `このホテルでは${plan.infant_max_age != null ? `幼児は${plan.infant_max_age}歳以下` : ''}${plan.infant_max_age != null && plan.child_max_age != null ? '、' : ''}${plan.child_max_age != null ? `子供は${plan.child_max_age}歳以下` : ''}として扱われます。それ以上は大人料金です。`
                      : `This hotel counts ${plan.infant_max_age != null ? `infants as ${plan.infant_max_age} years old and under` : ''}${plan.infant_max_age != null && plan.child_max_age != null ? ', and ' : ''}${plan.child_max_age != null ? `children as ${plan.child_max_age} and under` : ''}. Anyone older is charged as an adult.`}
                  </span>
                )}
                <span class="block">
                  {locale === 'ja'
                    ? 'チェックイン時に年齢の確認をさせていただく場合があります。実際の年齢が異なる場合、現地で追加料金が発生することがあります。'
                    : 'The hotel may ask to verify ages at check-in. If ages differ from what was booked, an extra charge may apply on arrival.'}
                </span>
              </p>
              <div>
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">
                  {t('booking.special_requests', locale)}
                </label>
                <textarea id="notes" name="notes" rows="3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#45A2C1] focus:border-[#45A2C1] outline-none transition-colors resize-vertical" placeholder={t('booking.special_requests_placeholder', locale)}></textarea>
                <p class="mt-1.5 text-xs text-gray-500">
                  {locale === 'ja'
                    ? 'ご要望はホテルにお伝えしますが、お応えできるかはホテルの判断によります。確約されるものではなく、内容によっては別途料金がかかる場合があります。'
                    : 'We pass your request to the hotel, but whether it can be met is the hotel’s decision. It is not guaranteed, and some requests may carry an extra charge payable to the hotel.'}
                </p>
              </div>
              <div class="pt-2 border-t border-gray-200">
            {planOptions.length > 0 && (
              <>
                <div class="border-t border-gray-200 my-4"></div>
                <div class="mb-3">
                  <p class="text-sm font-semibold text-gray-800 mb-2">
                    {locale === 'ja' ? 'オプション（任意）' : 'Add-ons (optional)'}
                  </p>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {planOptions.map((o: any) => {
                      const cur = String((plan as any).hotel_currency || 'USD').toUpperCase();
                      const unitLocal = Number(o.price_local ?? o.price_usd);
                      const childLocal = o.child_price_local == null ? null : Number(o.child_price_local);
                      const infantLocal = o.infant_price_local == null ? null : Number(o.infant_price_local);
                      const isAgeBand = o.pricing_type === 'per_adult_child';
                      const per = o.pricing_type === 'per_person'
                        ? (locale === 'ja' ? '／人' : ' per guest')
                        : isAgeBand
                          ? ''
                          : (locale === 'ja' ? '／1予約' : ' per booking');
                      const adultLabel = locale === 'ja' ? '大人' : 'Adult';
                      return (
                        <label class="flex items-start gap-2.5 border border-gray-200 rounded-lg px-3 py-2.5 cursor-pointer hover:border-[#45A2C1] transition-colors">
                          <input
                            type="checkbox"
                            class="booking-option mt-0.5 w-4 h-4 accent-[#45A2C1]"
                            value={o.id}
                            data-price-usd={Number(o.price_usd || 0)}
                            data-child-price-usd={o.child_price_usd == null ? '' : Number(o.child_price_usd)}
                            data-price-local={unitLocal}
                            data-child-price-local={childLocal == null ? '' : childLocal}
                            data-infant-price-usd={o.infant_price_usd == null ? '' : Number(o.infant_price_usd)}
                            data-infant-price-local={infantLocal == null ? '' : infantLocal}
                            data-pricing-type={o.pricing_type}
                            data-counts-adults={(o.counts_adults == null || o.counts_adults) ? '1' : '0'}
                            data-counts-children={(o.counts_children == null || o.counts_children) ? '1' : '0'}
                            data-counts-infants={o.counts_infants ? '1' : '0'}
                            data-label={locale === 'ja' && o.name_ja ? o.name_ja : o.name}
                          />
                          <span class="flex-1 min-w-0">
                            <span class="block text-sm font-medium text-gray-800">{locale === 'ja' && o.name_ja ? o.name_ja : o.name}</span>
                            <span class={isAgeBand
                              ? 'block text-xs text-gray-500 mt-0.5'
                              : 'block text-sm text-gray-600 mt-0.5'}>
                              {isAgeBand && <>{adultLabel}: </>}{formatLocalWithUsd(unitLocal, cur, Number(o.price_usd || 0))}{per}
                            </span>
