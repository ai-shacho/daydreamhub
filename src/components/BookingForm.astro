            <div class="border-t border-gray-200 my-4"></div>
            {(() => {
              const hotelCurrency = String((plan as any).hotel_currency || 'USD').toUpperCase();
              const isUsdHotel = hotelCurrency === 'USD';
              const processingFee = Math.round(effectivePriceUsd * 0.06 * 100) / 100;
              const serviceFeeBase = Math.round(effectivePriceUsd * 0.10 * 100) / 100;
              const serviceFee = serviceFeeBase < 10 ? Math.round((10 - serviceFeeBase) * 100) / 100 : 0;
              const total = Math.round((effectivePriceUsd + processingFee + serviceFee) * 100) / 100;
              return (
                <div class="space-y-1.5 text-sm mb-3">
                  <div class="flex justify-between text-gray-600">
