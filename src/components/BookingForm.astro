                  <p id="fee-info-text" class="hidden text-xs text-gray-500 bg-gray-50 border border-gray-200 rounded-lg px-3 py-2">
                    {locale === 'ja' ? 'カード決済・不正防止などのシステム処理に必要な費用です。' : 'This covers payment processing and fraud protection costs.'}
                  </p>
                  <div id="sum-service-row" class:list={['flex justify-between text-gray-600', serviceFee > 0 ? '' : 'hidden']}>
                    <span>{locale === 'ja' ? 'サービス料' : 'Service Fee'}</span>
                    <span id="sum-service">${serviceFee.toFixed(2)}</span>
                  </div>
                  <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                    <p class="text-base font-semibold text-gray-800">{t('booking.total', locale)}</p>
                    <p class="text-2xl font-bold text-[#45A2C1]">
                      <span id="sum-total" data-base-usd={effectivePriceUsd} data-currency={hotelCurrency}>${total.toFixed(2)}</span> <span class="text-sm font-normal text-gray-500">{t('hotel.usd', locale)}</span>
                    </p>
                  </div>
                  {!isUsdHotel && (
                    <p class="text-xs text-amber-700 pt-1">{locale === 'ja' ? 'お支払いはUSD（米ドル）で処理されます。現地通貨の表示は参考価格です。' : 'Payment is processed in USD. Local-currency amounts are for reference only.'}</p>
                  )}
                </div>
              );
            })()}
            <!-- Approval-based booking notice -->
            <div class="flex items-start gap-3 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800 mb-3">
              <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
              </svg>
              <div>
                <p class="font-medium">{locale === 'ja' ? '予約承認制について' : 'Approval-based Booking'}</p>
                <p class="mt-0.5 text-xs text-amber-700">
                  {locale === 'ja'
                    ? 'ご予約はホテルによる承認制です。お支払いは予約時にお預かりしますが、承認されなかった場合は全額返金いたします。'
                    : 'Bookings are subject to hotel approval. Payment is collected at the time of booking, but you will receive a full refund if your request is not approved.'}
                </p>
              </div>
            </div>
            <PayPalButton planId={plan.id} priceUsd={plan.price_usd} clientId={paypalClientId} testMode={isTestMode} hotelSlug={plan.hotel_slug} locale={locale === 'ja' ? 'ja_JP' : 'en_US'} hotelName={plan.hotel_name || ''} hotelCity={plan.city || ''} confirmationPath={localePath('/booking/confirmation', locale)} />
          </div>
        </div>
      </div>
    </div>
  ) : (
    <!-- 404: Plan Not Found -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 text-center">
      <svg class="w-20 h-20 mx-auto text-gray-300 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
      <h1 class="text-2xl font-bold text-gray-700 mb-3">
        {t('booking.plan_not_found', locale)}
      </h1>
      <p class="text-gray-500 mb-8 max-w-md mx-auto">
        {t('booking.plan_not_found_desc', locale)}
