                              <span class="block text-xs text-gray-500 mt-0.5">
                                {locale === 'ja' ? '子供' : 'Child'}: {formatLocalWithUsd(childLocal, cur, Number(o.child_price_usd || 0))}
                              </span>
                            )}
                            {infantLocal != null && (
                              <span class="block text-xs text-gray-500 mt-0.5">
                                {locale === 'ja' ? '幼児' : 'Infant'}: {Number(o.infant_price_usd || 0) === 0
                                  ? (locale === 'ja' ? '無料' : 'Free')
                                  : formatLocalWithUsd(infantLocal, cur, Number(o.infant_price_usd || 0))}
                              </span>
                            )}
                            {o.description && <span class="block text-xs text-gray-400 mt-0.5">{o.description}</span>}
                          </span>
                        </label>
                      );
                    })}
                  </div>

                </div>
              </>
            )}
            <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-sm text-amber-900">
              <p class="font-semibold mb-1.5">
                {planOptions.length > 0
                  ? (locale === 'ja' ? '⚠️ オプション・人数は予約後に変更できません' : '⚠️ Add-ons and guest numbers cannot be changed after booking')
