---
import Layout from '../layouts/Layout.astro';
import { formatDisplayDate } from '../lib/dateFormat';
import { getLocale, localePath } from '../lib/i18n';
import type { GuestSession } from '../lib/guestSession';

// The whole My Bookings screen, rendered by both /mypage and /ja/mypage. The
// two used to be separate files and the Japanese one had drifted — it called a
// showToast() it never defined, so every failed review or cancellation threw.
interface Props { currentUser: GuestSession }
const { currentUser } = Astro.props;
const locale = getLocale(Astro.url);
const ja = locale === 'ja';

const DB = (Astro.locals as any).runtime?.env?.DB;

// Fetch bookings for the logged-in user
let bookings: any[] = [];
let error = '';

try {
  if (DB) {
    const result = await DB.prepare(`
      SELECT
        b.id, b.status, b.check_in_date, b.total_price_usd, b.local_currency, b.local_amount,
        b.adults, b.children, b.created_at, b.paypal_order_id,
        b.notes,
        h.name as hotel_name, h.slug as hotel_slug,
        h.city, h.country, h.thumbnail_url,
        p.name as plan_name, p.check_in_time, p.check_out_time
      FROM bookings b
      LEFT JOIN hotels h ON h.id = b.hotel_id
      LEFT JOIN plans p ON p.id = b.plan_id
      WHERE b.guest_email = ?
      ORDER BY b.created_at DESC
      LIMIT 50
    `).bind(currentUser.email).all();
    bookings = result?.results ?? [];

    // Fetch unread message counts per booking (hotel→guest, unread by guest)
    if (bookings.length > 0) {
      const bookingIds = bookings.map((b: any) => b.id);
      const ph = bookingIds.map(() => '?').join(',');
      const unreadResult = await DB.prepare(
        `SELECT booking_id, COUNT(*) as unread_count FROM booking_messages
         WHERE booking_id IN (${ph}) AND sender_type = 'hotel' AND is_read = 0
         GROUP BY booking_id`
      ).bind(...bookingIds).all();
      const unreadMap: Record<number, number> = {};
      for (const r of (unreadResult?.results || []) as any[]) {
        unreadMap[r.booking_id] = r.unread_count;
      }
      bookings = bookings.map((b: any) => ({ ...b, unread_messages: unreadMap[b.id] || 0 }));
      // Add-ons the guest paid for, fetched for the whole list in one query and
      // attached to each booking so the card can explain its own total.
      const optResult = await DB.prepare(
        `SELECT * FROM booking_options WHERE booking_id IN (${ph}) ORDER BY id`
      ).bind(...bookingIds).all().catch(() => null);
      const optMap: Record<number, any[]> = {};
      for (const o of (optResult?.results || []) as any[]) {
        (optMap[o.booking_id] ||= []).push(o);
      }
      bookings = bookings.map((b: any) => ({ ...b, add_ons: optMap[b.id] || [] }));
    }
  }
} catch (e: any) {
  error = ja ? '予約情報の読み込みに失敗しました。' : 'Failed to load bookings.';
}


// Who an add-on was charged for, so the amount on the card is explainable.
function optionCoverage(o: any): string {
  const n = (v: any) => Number(v) || 0;
  const plural = (v: number, one: string, many: string) => `${v} ${v === 1 ? one : many}`;
  if (o.pricing_type === 'per_adult_child') {
    const parts: string[] = [];
    if (n(o.quantity) > 0) parts.push(ja ? `大人${n(o.quantity)}名` : plural(n(o.quantity), 'adult', 'adults'));
    if (n(o.child_quantity) > 0) parts.push(ja ? `子供${n(o.child_quantity)}名` : plural(n(o.child_quantity), 'child', 'children'));
    if (n(o.infant_quantity) > 0) parts.push(ja ? `幼児${n(o.infant_quantity)}名` : plural(n(o.infant_quantity), 'infant', 'infants'));
    return parts.join(ja ? '＋' : ' + ');
  }
  if (o.pricing_type === 'per_person') return ja ? `${n(o.quantity)}名` : plural(n(o.quantity), 'guest', 'guests');
  return ja ? '1予約' : plural(n(o.quantity) || 1, 'booking', 'bookings');
}

const statusConfig: Record<string, { label: string; color: string; icon: string }> = {
  pending:              { label: ja ? 'お支払い待ち' : 'Payment Pending', color: 'bg-yellow-100 text-yellow-700 border-yellow-200', icon: '⏳' },
  pending_confirmation: { label: ja ? 'ホテル確認待ち' : 'Awaiting Hotel', color: 'bg-blue-100 text-blue-700 border-blue-200',       icon: '📨' },
  confirmed:            { label: ja ? '確定済み' : 'Confirmed', color: 'bg-green-100 text-green-700 border-green-200',    icon: '✅' },
  completed:            { label: ja ? '利用済み' : 'Completed', color: 'bg-gray-100 text-gray-600 border-gray-200',       icon: '🏁' },
  cancelled:            { label: ja ? 'キャンセル済み' : 'Cancelled', color: 'bg-red-100 text-red-600 border-red-200',          icon: '❌' },
  failed:               { label: ja ? '失敗' : 'Failed', color: 'bg-red-100 text-red-600 border-red-200',          icon: '⚠️' },
};

---

<Layout title={ja ? "マイページ — DayDreamHub" : "My Bookings — DayDreamHub"}>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">{ja ? "マイページ" : "My Bookings"}</h1>
        <p class="text-sm text-gray-500 mt-1">{ja ? "おかえりなさい、" : "Welcome back, "}<span class="font-medium text-gray-700">{currentUser.name}</span>{ja ? "さん" : ""}</p>
      </div>
      <a href={localePath("/search", locale)} class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        {ja ? "新しい予約" : "New Booking"}
      </a>
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mb-6">{error}</div>
    )}

    {bookings.length === 0 ? (
      <!-- Empty state -->
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
        <div class="text-6xl mb-4">🏨</div>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">{ja ? "まだ予約がありません" : "No bookings yet"}</h2>
        <p class="text-gray-400 mb-6 text-sm">{ja ? "デイユースホテルの予約がここに表示されます。" : "Your day-use hotel bookings will appear here."}</p>
        <a href={localePath("/search", locale)} class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">{ja ? "ホテルを探す" : "Browse Hotels"}</a>
      </div>
    ) : (
      <!-- Bookings list -->
      <div class="space-y-4">
        {bookings.map((b: any) => {
          const status = statusConfig[b.status] || { label: b.status, color: 'bg-gray-100 text-gray-600 border-gray-200', icon: '•' };
          const guestCount = b.children > 0 ? `${b.adults}+${b.children}` : `${b.adults}`;
          return (
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden hover:shadow-md transition-shadow">
              <div class="flex flex-col sm:flex-row">
                <!-- Hotel thumbnail -->
                <div class="sm:w-36 h-28 sm:h-auto flex-shrink-0 bg-gray-100 overflow-hidden">
                  {b.thumbnail_url ? (
                    <img src={b.thumbnail_url} alt={b.hotel_name} class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                  )}
                </div>

                <!-- Booking info -->
                <div class="flex-1 p-4 sm:p-5">
                  <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                    <div>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-mono text-gray-400">#{b.id}</span>
                        <span class={`inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full border ${status.color}`}>
                          {status.icon} {status.label}
                        </span>
                      </div>
                      <h2 class="font-semibold text-gray-900 mt-1 text-base">
                        <a href={localePath(`/hotel/${b.hotel_slug}`, locale)} class="hover:text-teal-700 transition-colors">{b.hotel_name || (ja ? 'ホテル' : 'Hotel')}</a>
                      </h2>
                      <p class="text-xs text-gray-400">{b.city}{b.country ? (ja ? `、${b.country}` : `, ${b.country}`) : ''}</p>
                    </div>
                    <div class="text-right">
                      <div class="text-lg font-bold text-teal-700">${Number(b.total_price_usd || 0).toFixed(2)}</div>
                      {b.local_currency && b.local_currency !== 'USD' && b.local_amount != null && (
                        <div class="text-xs text-gray-400">{b.local_currency} {b.local_amount}</div>
                      )}
                      <div class="text-xs text-gray-400">USD</div>
                    </div>
                  </div>

                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
                    <div>
                      <div class="text-xs text-gray-400 mb-0.5">{ja ? "プラン" : "Plan"}</div>
                      <div class="font-medium text-gray-700 text-xs leading-snug">{b.plan_name || '-'}</div>
                    </div>
                    <div>
                      <div class="text-xs text-gray-400 mb-0.5">{ja ? "日付" : "Date"}</div>
                      <div class="font-medium text-gray-700 text-xs">{formatDisplayDate(b.check_in_date, locale)}</div>
                    </div>
                    <div>
                      <div class="text-xs text-gray-400 mb-0.5">{ja ? "時間" : "Time"}</div>
                      <div class="font-medium text-gray-700 text-xs">
                        {b.check_in_time && b.check_out_time ? `${b.check_in_time} – ${b.check_out_time}` : '-'}
                      </div>
                    </div>
                    <div>
                      <div class="text-xs text-gray-400 mb-0.5">{ja ? "人数" : "Guests"}</div>
                      <div class="font-medium text-gray-700 text-xs">{ja ? `${guestCount}名` : `${guestCount} guest${guestCount !== '1' ? 's' : ''}`}</div>
                    </div>
                  </div>

                  {(b.add_ons || []).length > 0 && (
                    <div class="mt-3 pt-3 border-t border-gray-100">
                      <div class="text-xs text-gray-400 mb-1">{ja ? "オプション" : "Add-ons"}</div>
                      <ul class="space-y-1">
                        {(b.add_ons || []).map((o: any) => (
                          <li class="flex justify-between gap-3 text-xs text-gray-700">
                            <span>{o.name} <span class="text-gray-400">({optionCoverage(o)})</span></span>
                            <span class="whitespace-nowrap">
                              {o.currency && o.currency !== 'USD' && o.amount_local != null
                                ? `${o.currency} ${o.amount_local} (≈ $${Number(o.amount_usd || 0).toFixed(2)})`
                                : `$${Number(o.amount_usd || 0).toFixed(2)}`}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <!-- Status messages -->
                  {b.status === 'pending_confirmation' && (
                    <div class="mt-3 bg-blue-50 border border-blue-100 rounded-lg px-3 py-2 text-xs text-blue-700">
                      {ja
                        ? '📨 予約リクエストをホテルに送信しました。通常24時間以内に確認が届きます。'
                        : '📨 Your booking request has been sent to the hotel. Confirmation usually arrives within 24 hours.'}
                    </div>
                  )}
                  {b.status === 'confirmed' && (
                    <div class="mt-3 bg-green-50 border border-green-100 rounded-lg px-3 py-2 text-xs text-green-700">
                      {ja
                        ? `✅ 予約が確定しました！${formatDisplayDate(b.check_in_date, locale)}に${b.check_in_time || 'チェックイン時間'}までにホテルにお越しください。`
                        : `✅ Your booking is confirmed! Please arrive at the hotel on ${formatDisplayDate(b.check_in_date, locale)} by ${b.check_in_time || 'check-in time'}.`}
                    </div>
                  )}
                  {(b.status === 'cancelled' || b.status === 'failed') && (
                    <div class="mt-3 bg-red-50 border border-red-100 rounded-lg px-3 py-2 text-xs text-red-700">
                      {ja
                        ? 'キャンセル済み、または決済が完了していない予約です。未完了の決済は請求されず、二重請求も発生しないよう保護されています。ご不明点は'
                        : 'This booking was canceled or payment did not complete. You are not charged for incomplete payments, and we prevent double charges. Need help? '}
                      <a href={localePath('/contact', locale)} class="underline font-medium">{ja ? 'お問い合わせ' : 'Contact us'}</a>{ja ? 'ください。' : '.'}
                    </div>
                  )}

                  <!-- Footer row -->
                  <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-50">
                    <span class="text-xs text-gray-300">{ja ? `予約日 ${formatDisplayDate(b.created_at, locale)}` : `Booked ${formatDisplayDate(b.created_at)}`}</span>
                    <div class="flex gap-2 flex-wrap justify-end">
                      <a href={localePath(`/hotel/${b.hotel_slug}`, locale)}
                        class="text-xs text-teal-600 hover:text-teal-700 font-medium border border-teal-200 hover:border-teal-400 px-3 py-1.5 rounded-lg transition-colors">
                        {ja ? 'ホテルを見る' : 'View Hotel'}
                      </a>
                      {(b.status !== 'failed') && (
                        <button
                          class="btn-message-hotel relative text-xs text-blue-600 hover:text-blue-700 font-medium border border-blue-200 hover:border-blue-400 px-3 py-1.5 rounded-lg transition-colors"
                          data-booking-id={b.id}
                          data-hotel-name={b.hotel_name}
                        >
                          {ja ? '💬 メッセージ' : '💬 Message'}
                          {b.unread_messages > 0 && (
                            <span class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">{b.unread_messages}</span>
                          )}
                        </button>
                      )}
                      {(b.status === 'confirmed' || b.status === 'completed') && new Date(b.check_in_date) < new Date(new Date().toDateString()) && (
                        <button
                          class="btn-write-review text-xs text-amber-600 hover:text-amber-700 font-medium border border-amber-200 hover:border-amber-400 px-3 py-1.5 rounded-lg transition-colors"
                          data-booking-id={b.id}
                          data-hotel-name={b.hotel_name}
                        >
                          {ja ? '⭐ レビュー' : '⭐ Review'}
                        </button>
                      )}
                      {(b.status === 'pending_confirmation' || b.status === 'confirmed') && (
                        <button
                          class="btn-cancel-booking text-xs text-red-500 hover:text-red-700 font-medium border border-red-200 hover:border-red-400 px-3 py-1.5 rounded-lg transition-colors"
                          data-booking-id={b.id}
                          data-hotel-name={b.hotel_name}
                        >
                          {ja ? 'キャンセルを依頼' : 'Request cancellation'}
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}

    <!-- Help section -->
    <div class="mt-8 bg-gray-50 rounded-xl p-5 flex flex-col sm:flex-row items-center gap-4">
      <div class="flex-1">
        <h3 class="font-semibold text-gray-800 text-sm mb-1">{ja ? "予約についてお困りですか？" : "Need help with a booking?"}</h3>
        <p class="text-xs text-gray-500">{ja ? "月〜金 9:00〜18:00 JST にサポートチームが対応します。通常数時間以内にご返信いたします。" : "Our team is available Mon–Fri 9:00–18:00 JST. We typically respond within a few hours."}</p>
      </div>
      <a href={localePath("/contact", locale)} class="flex-shrink-0 bg-white border border-gray-200 hover:border-teal-400 text-gray-700 hover:text-teal-700 text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">
        {ja ? "サポートに連絡" : "Contact Support"}
      </a>
    </div>
  </div>
<!-- Review modal -->
<div id="review-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-1">{ja ? "レビューを書く" : "Write a Review"}</h3>
    <p class="text-sm text-gray-500 mb-4">{ja ? "ホテル：" : "Hotel: "}<span id="review-hotel-name" class="font-medium text-gray-700"></span></p>
    <div class="flex gap-2 mb-4" id="star-rating">
      {[1,2,3,4,5].map(n => (
        <button class="star-btn text-3xl text-gray-300 hover:text-amber-400 transition-colors" data-value={n}>★</button>
      ))}
    </div>
    <textarea id="review-content" rows="4" placeholder={ja ? "ご感想をどうぞ（任意）" : "Share your experience (optional)"}
      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-400 outline-none resize-none mb-4"></textarea>
    <div class="flex gap-3">
      <button id="review-modal-close" class="flex-1 py-2.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50">{ja ? "閉じる" : "Cancel"}</button>
      <button id="review-modal-confirm" class="flex-1 py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-sm font-bold">{ja ? "レビューを送信" : "Submit Review"}</button>
    </div>
  </div>
</div>

<!-- Message modal -->
<div id="message-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-1">{ja ? "ホテルへのメッセージ" : "Message the Hotel"}</h3>
    <p class="text-sm text-gray-500 mb-4">{ja ? "ホテル：" : "Hotel: "}<span id="message-hotel-name" class="font-medium text-gray-700"></span></p>
    <div id="message-thread" class="max-h-48 overflow-y-auto mb-3 space-y-2 bg-gray-50 rounded-lg p-3 hidden"></div>
    <textarea id="message-content" rows="3" placeholder={ja ? "メッセージを入力..." : "Type your message..."}
      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-400 outline-none resize-none mb-4"></textarea>
    <div class="flex gap-3">
      <button id="message-modal-close" class="flex-1 py-2.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50">{ja ? "閉じる" : "Close"}</button>
      <button id="message-modal-send" class="flex-1 py-2.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg text-sm font-bold">{ja ? "送信" : "Send Message"}</button>
    </div>
  </div>
</div>

<!-- Cancel modal -->
<div id="cancel-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-2">{ja ? "予約のキャンセル" : "Cancel Booking"}</h3>
    <p class="text-sm text-gray-500 mb-1">{ja ? "予約先：" : "Booking at: "}<span id="cancel-hotel-name" class="font-medium text-gray-700"></span></p>
    <p class="text-sm text-gray-500 mb-2">{ja ? "キャンセル理由をお知らせください。" : "Please let us know why you're cancelling."}</p>
    <p class="text-xs text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-lg px-3 py-2 mb-4">{ja ? "決済が完了していない場合は請求されません。二重請求も発生しないよう保護されています。" : "If payment was not completed yet, you are not charged. We also protect you from double charges."}</p>
    <textarea id="cancel-reason" rows="3" placeholder={ja ? "キャンセル理由（任意）" : "Reason for cancellation (optional)"}
      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-400 focus:border-red-400 outline-none resize-none mb-4"></textarea>
    <div class="flex gap-3">
      <button id="cancel-modal-close" class="flex-1 py-2.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
        {ja ? "予約を続ける" : "Keep Booking"}
      </button>
      <button id="cancel-modal-confirm" class="flex-1 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-lg text-sm font-bold transition-colors">
        {ja ? "キャンセルを確定" : "Confirm Cancel"}
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  // One script serves both routes, so the wording follows the path.
  var ja = location.pathname.indexOf('/ja/') === 0;
  var T = function(en, jaText) { return ja ? jaText : en; };

  function showToast(message, kind) {
    var el = document.createElement('div');
    var color = kind === 'error' ? 'bg-red-600' : kind === 'success' ? 'bg-emerald-600' : 'bg-slate-800';
    el.className = 'fixed top-4 right-4 z-[70] text-white text-sm px-4 py-2.5 rounded-lg shadow-lg ' + color;
    el.textContent = message;
    document.body.appendChild(el);
    setTimeout(function(){ el.style.opacity = '0'; el.style.transition = 'opacity .25s'; }, 2200);
    setTimeout(function(){ el.remove(); }, 2500);
  }

  // --- Review modal ---
  var reviewModal = document.getElementById('review-modal');
  var reviewHotelName = document.getElementById('review-hotel-name');
  var reviewContent = document.getElementById('review-content');
  var reviewConfirm = document.getElementById('review-modal-confirm');
  var reviewClose = document.getElementById('review-modal-close');
  var currentReviewBookingId = null;
  var currentRating = 0;

  document.querySelectorAll('.star-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      currentRating = Number(btn.dataset.value);
      document.querySelectorAll('.star-btn').forEach(function(s, i) {
        s.classList.toggle('text-amber-400', i < currentRating);
        s.classList.toggle('text-gray-300', i >= currentRating);
      });
    });
  });

  document.querySelectorAll('.btn-write-review').forEach(function(btn) {
    btn.addEventListener('click', function() {
      currentReviewBookingId = btn.dataset.bookingId;
      reviewHotelName.textContent = btn.dataset.hotelName;
      currentRating = 0;
      reviewContent.value = '';
      document.querySelectorAll('.star-btn').forEach(function(s) { s.classList.add('text-gray-300'); s.classList.remove('text-amber-400'); });
      reviewModal.classList.remove('hidden'); reviewModal.classList.add('flex');
    });
  });

  reviewClose.addEventListener('click', function() { reviewModal.classList.add('hidden'); reviewModal.classList.remove('flex'); });
  reviewModal.addEventListener('click', function(e) { if (e.target === reviewModal) { reviewModal.classList.add('hidden'); reviewModal.classList.remove('flex'); } });

  reviewConfirm.addEventListener('click', async function() {
    if (!currentRating) { showToast(T('Please select a star rating.', '星評価を選択してください。')); return; }
    reviewConfirm.textContent = T('Submitting...', '送信中...'); reviewConfirm.disabled = true;
    try {
      var res = await fetch('/api/guest/review', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ booking_id: Number(currentReviewBookingId), rating: currentRating, content: reviewContent.value.trim() }) });
      var data = await res.json();
      if (data.success) { reviewModal.classList.add('hidden'); reviewModal.classList.remove('flex'); showToast(T('Thank you for your review!', 'レビューありがとうございます！')); }
      else { showToast(data.error || T('Failed', '送信に失敗しました')); }
    } catch { showToast(T('Error submitting review', 'レビューの送信中にエラーが発生しました')); }
    reviewConfirm.textContent = T('Submit Review', 'レビューを送信'); reviewConfirm.disabled = false;
  });

  // --- Message modal ---
  var msgModal = document.getElementById('message-modal');
  var msgHotelName = document.getElementById('message-hotel-name');
  var msgContent = document.getElementById('message-content');
  var msgSend = document.getElementById('message-modal-send');
  var msgClose = document.getElementById('message-modal-close');
  var msgThread = document.getElementById('message-thread');
  var currentMsgBookingId = null;

  async function loadMessages(bookingId) {
    try {
      var res = await fetch('/api/guest/message?booking_id=' + bookingId);
      var data = await res.json();
      if (data.messages && data.messages.length > 0) {
        msgThread.classList.remove('hidden');
        msgThread.innerHTML = data.messages.map(function(m) {
          var isGuest = m.sender_type === 'guest';
          return '<div class="' + (isGuest ? 'text-right' : 'text-left') + '"><span class="inline-block px-3 py-1.5 rounded-xl text-xs max-w-[85%] ' + (isGuest ? 'bg-blue-500 text-white' : 'bg-white border text-gray-700') + '">' + m.content + '</span><div class="text-xs text-gray-300 mt-0.5">' + m.sender_name + '</div></div>';
        }).join('');
        msgThread.scrollTop = msgThread.scrollHeight;
      }
    } catch {}
  }

  document.querySelectorAll('.btn-message-hotel').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      currentMsgBookingId = btn.dataset.bookingId;
      msgHotelName.textContent = btn.dataset.hotelName;
      msgContent.value = '';
      msgThread.innerHTML = ''; msgThread.classList.add('hidden');
      msgModal.classList.remove('hidden'); msgModal.classList.add('flex');
      await loadMessages(currentMsgBookingId);
    });
  });

  msgClose.addEventListener('click', function() { msgModal.classList.add('hidden'); msgModal.classList.remove('flex'); });
  msgModal.addEventListener('click', function(e) { if (e.target === msgModal) { msgModal.classList.add('hidden'); msgModal.classList.remove('flex'); } });

  msgSend.addEventListener('click', async function() {
    if (!msgContent.value.trim()) return;
    msgSend.textContent = T('Sending...', '送信中...'); msgSend.disabled = true;
    try {
      var res = await fetch('/api/guest/message', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ booking_id: Number(currentMsgBookingId), content: msgContent.value.trim() }) });
      var data = await res.json();
      if (data.success) { msgContent.value = ''; await loadMessages(currentMsgBookingId); }
      else { showToast(data.error || T('Failed', '送信に失敗しました')); }
    } catch { showToast(T('Error sending message', 'メッセージの送信中にエラーが発生しました')); }
    msgSend.textContent = T('Send Message', '送信'); msgSend.disabled = false;
  });

  // --- Cancel modal ---
  var modal = document.getElementById('cancel-modal');
  var hotelNameEl = document.getElementById('cancel-hotel-name');
  var reasonEl = document.getElementById('cancel-reason');
  var confirmBtn = document.getElementById('cancel-modal-confirm');
  var closeBtn = document.getElementById('cancel-modal-close');
  var currentBookingId = null;

  function openModal(bookingId, hotelName) {
    currentBookingId = bookingId;
    hotelNameEl.textContent = hotelName;
    reasonEl.value = '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    currentBookingId = null;
  }

  document.querySelectorAll('.btn-cancel-booking').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openModal(btn.dataset.bookingId, btn.dataset.hotelName);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

  confirmBtn.addEventListener('click', async function() {
    if (!currentBookingId) return;
    confirmBtn.textContent = T('Cancelling...', 'キャンセル中...');
    confirmBtn.disabled = true;
    try {
      var res = await fetch('/api/guest/cancel-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ booking_id: Number(currentBookingId), reason: reasonEl.value.trim() }),
      });
      var data = await res.json();
      if (data.success) {
        closeModal();
        window.location.reload();
      } else {
        showToast(data.error || T('Failed to cancel booking', '予約のキャンセルに失敗しました'));
        confirmBtn.textContent = T('Confirm Cancel', 'キャンセルを確定');
        confirmBtn.disabled = false;
      }
    } catch (e) {
      showToast(T('Error cancelling booking. Please contact support.', 'キャンセル中にエラーが発生しました。サポートにお問い合わせください。'));
      confirmBtn.textContent = T('Confirm Cancel', 'キャンセルを確定');
      confirmBtn.disabled = false;
    }
  });
})();
</script>
</Layout>
