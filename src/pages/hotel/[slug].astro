---
import HotelDetail from '../../components/HotelDetail.astro';
import { hotelIsVisible } from '../../lib/guestSession';

const { slug } = Astro.params;
const db = (Astro.locals as any).runtime?.env?.DB;
if (!(await hotelIsVisible(db, slug || ''))) Astro.response.status = 404;
---

<HotelDetail slug={slug || ''} />
