---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { verifyAdmin } from '../../lib/adminAuth';
import { HOTEL_EMAIL_ROWS } from '../../lib/data/hotelEmailUpdateRows';

const runtime = (Astro.locals as any).runtime;
const db = runtime?.env?.DB;
const jwtSecret = runtime?.env?.JWT_SECRET || 'dev-secret';
const admin = await verifyAdmin(Astro.request, jwtSecret);
if (!admin) return Astro.redirect('/admin/login');

const norm = (s: string) => (s || '').toLowerCase().trim().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
const em = (s: string) => (s || '').trim().toLowerCase();

let hotels: any[] = [];
if (db) {
  try { hotels = ((await db.prepare('SELECT id, name, email, status FROM hotels ORDER BY id').all())?.results as any[]) || []; } catch {}
}
const byNorm = new Map<string, any[]>();
const byEmail = new Map<string, any[]>();
for (const h of hotels) {
  const n = norm(h.name); (byNorm.get(n) || byNorm.set(n, []).get(n))!.push(h);
  const e = em(h.email); if (e) (byEmail.get(e) || byEmail.set(e, []).get(e))!.push(h);
}

type Matched = { id: number; db_name: string; csv_name: string; method: string; cur_email: string; new_book: string; new_contact: string; email_changes: boolean; contact_differs: boolean };
const matched: Matched[] = [];
const ambiguous: { csv_name: string; candidates: any[] }[] = [];
const unmatched: { name: string; book: string; contact: string }[] = [];

for (const row of HOTEL_EMAIL_ROWS) {
  let hs = byNorm.get(norm(row.name)) || [];
  let method = 'name';
  if (hs.length !== 1) {
    const cand: any[] = [];
    for (const e of [em(row.book), em(row.contact)]) if (e) cand.push(...(byEmail.get(e) || []));
    const uniq = Array.from(new Map(cand.map((h) => [h.id, h])).values());
    if (uniq.length === 1) { hs = uniq; method = 'email'; }
    else if (hs.length > 1) {
      const ids = new Set(hs.map((h) => h.id));
      const dis = uniq.filter((h) => ids.has(h.id));
      if (dis.length === 1) { hs = dis; method = 'name+email'; }
      else { ambiguous.push({ csv_name: row.name, candidates: hs }); continue; }
    } else if (uniq.length > 1) { ambiguous.push({ csv_name: row.name, candidates: uniq }); continue; }
    else hs = [];
  }
  if (hs.length === 1) {
    const h = hs[0];
    matched.push({ id: h.id, db_name: h.name, csv_name: row.name, method, cur_email: h.email || '', new_book: row.book, new_contact: row.contact, email_changes: em(h.email) !== em(row.book), contact_differs: em(row.contact) !== em(row.book) });
  } else {
    unmatched.push({ name: row.name, book: row.book, contact: row.contact });
  }
}
matched.sort((a, b) => a.id - b.id);
const changeCount = matched.filter((m) => m.email_changes).length;
---

<AdminLayout title="Hotel Email Update" activeNav="hotel-email-update">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-slate-900">Hotel Email Update — CSV reconciliation</h1>
    <p class="text-sm text-slate-500 mt-1">Matches the source form CSV against live hotels. Review before applying. Booking notifications are intended to reach both the booking email and the contact email.</p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800">Matched: {matched.length}</span>
      <span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-800">Booking email changes: {changeCount}</span>
      <span class="px-2.5 py-1 rounded-full bg-rose-100 text-rose-700">Ambiguous: {ambiguous.length}</span>
      <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Unmatched: {unmatched.length}</span>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <button data-dl="matched" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700">⬇︎ Matched CSV ({matched.length})</button>
      <button data-dl="ambiguous" class="px-4 py-2 bg-amber-600 text-white text-sm font-medium rounded-lg hover:bg-amber-700">⬇︎ Ambiguous CSV</button>
      <button data-dl="unmatched" class="px-4 py-2 bg-slate-600 text-white text-sm font-medium rounded-lg hover:bg-slate-700">⬇︎ Unmatched CSV</button>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
    <div class="px-4 py-3 border-b border-slate-200 bg-slate-50 font-semibold text-sm text-slate-800">Matched ({matched.length}) — booking-email changes highlighted</div>
    <div class="max-h-[28rem] overflow-auto">
      <table class="w-full text-xs">
        <thead class="bg-slate-100 text-slate-600 sticky top-0"><tr>
          <th class="text-left px-3 py-2">ID</th><th class="text-left px-3 py-2">DB名</th><th class="text-left px-3 py-2">Method</th><th class="text-left px-3 py-2">現email</th><th class="text-left px-3 py-2">新・予約管理</th><th class="text-left px-3 py-2">新・担当者</th>
        </tr></thead>
        <tbody class="divide-y divide-slate-100">
          {matched.map((m) => (
            <tr class={m.email_changes ? 'bg-amber-50' : ''}>
              <td class="px-3 py-1.5 text-slate-500">{m.id}</td>
              <td class="px-3 py-1.5 text-slate-800">{m.db_name}</td>
              <td class="px-3 py-1.5 text-slate-500">{m.method}</td>
              <td class="px-3 py-1.5 font-mono text-slate-500">{m.cur_email || '—'}</td>
              <td class={`px-3 py-1.5 font-mono ${m.email_changes ? 'text-amber-700 font-semibold' : 'text-slate-600'}`}>{m.new_book}</td>
              <td class="px-3 py-1.5 font-mono text-slate-600">{m.new_contact}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <details class="mb-4">
    <summary class="cursor-pointer text-sm font-semibold text-slate-700">Ambiguous ({ambiguous.length}) — one CSV name maps to several hotels</summary>
    <div class="mt-2 bg-white rounded-xl border border-slate-200 overflow-auto max-h-96 text-xs">
      <table class="w-full"><tbody class="divide-y divide-slate-100">
        {ambiguous.map((a) => a.candidates.map((h: any, i: number) => (
          <tr><td class="px-3 py-1.5 text-slate-700">{i === 0 ? a.csv_name : ''}</td><td class="px-3 py-1.5 text-slate-500">#{h.id}</td><td class="px-3 py-1.5">{h.name}</td><td class="px-3 py-1.5 font-mono text-slate-500">{h.email}</td></tr>
        )))}
      </tbody></table>
    </div>
  </details>

  <details class="mb-8">
    <summary class="cursor-pointer text-sm font-semibold text-slate-700">Unmatched ({unmatched.length}) — likely not registered</summary>
    <div class="mt-2 bg-white rounded-xl border border-slate-200 p-4 text-xs text-slate-600 max-h-96 overflow-auto">
      {unmatched.map((u) => <div>{u.name}</div>)}
    </div>
  </details>

  <script is:inline define:vars={{ matched, ambiguous, unmatched }}>
    function csvEscape(v) { const s = String(v == null ? '' : v); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; }
    function toCsv(header, rows) { return '﻿' + [header.join(',')].concat(rows.map((r) => r.map(csvEscape).join(','))).join('\r\n'); }
    function download(name, text) { const b = new Blob([text], { type: 'text/csv;charset=utf-8' }); const u = URL.createObjectURL(b); const a = document.createElement('a'); a.href = u; a.download = name; document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(u); }
    const builders = {
      matched: () => toCsv(['hotel_id','DB名','CSV名','マッチ方法','現在のemail','新_予約管理メール','新_担当者メール','予約管理が変わる','担当者は別'], matched.map((m) => [m.id, m.db_name, m.csv_name, m.method, m.cur_email, m.new_book, m.new_contact, m.email_changes ? 'YES' : '', m.contact_differs ? 'YES' : ''])),
      ambiguous: () => toCsv(['CSV名','候補hotel_id','候補DB名','候補email'], ambiguous.flatMap((a) => a.candidates.map((h) => [a.csv_name, h.id, h.name, h.email]))),
      unmatched: () => toCsv(['CSV名','予約管理メール','担当者メール'], unmatched.map((u) => [u.name, u.book, u.contact])),
    };
    document.querySelectorAll('button[data-dl]').forEach((btn) => btn.addEventListener('click', () => download('hotel_email_' + btn.dataset.dl + '.csv', builders[btn.dataset.dl]())));
  </script>
</AdminLayout>
