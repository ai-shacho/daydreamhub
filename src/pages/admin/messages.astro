---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { verifyAdmin } from '../../lib/adminAuth';
import { formatDisplayDate } from '../../lib/dateFormat';

const runtime = Astro.locals.runtime as any;
const db = runtime?.env?.DB;
const jwtSecret = runtime?.env?.JWT_SECRET || "dev-secret";

const admin = await verifyAdmin(Astro.request, jwtSecret);
if (!admin) return Astro.redirect("/admin/login");

const url = new URL(Astro.request.url);
// Two different things live under "Messages": the outbound email delivery log,
// and the guest↔hotel conversation attached to a booking. The second was not
// visible to admin at all, which is why owner emails used to tell hotels to
// reply straight to the guest — an exchange nobody here could see.
const view = url.searchParams.get("view") === "threads" ? "threads" : "email";
const statusFilter = url.searchParams.get("status") || "";
const directionFilter = url.searchParams.get("direction") || "";
const search = url.searchParams.get("search") || "";

let messages: any[] = [];
let threads: any[] = [];
let threadCount = 0;
let error = "";

if (db && view === "threads") {
  try {
    let q = `SELECT bm.id, bm.booking_id, bm.sender_type, bm.sender_name, bm.content,
                    bm.is_read, bm.created_at,
                    b.guest_name, b.guest_email, b.check_in_date, b.status AS booking_status,
                    h.name AS hotel_name, h.id AS hotel_id
               FROM booking_messages bm
               LEFT JOIN bookings b ON b.id = bm.booking_id
               LEFT JOIN hotels h ON h.id = b.hotel_id
              WHERE 1=1`;
    const tb: any[] = [];
    if (search) {
      q += " AND (bm.content LIKE ? OR b.guest_name LIKE ? OR b.guest_email LIKE ? OR h.name LIKE ?)";
      tb.push(`%${search}%`, `%${search}%`, `%${search}%`, `%${search}%`);
    }
    q += " ORDER BY bm.created_at DESC LIMIT 300";
    const r = await db.prepare(q).bind(...tb).all();
    threads = r?.results || [];
    const c: any = await db.prepare("SELECT COUNT(*) AS n FROM booking_messages").first();
    threadCount = Number(c?.n || 0);
  } catch (e: any) {
    error = e.message || "Failed to load conversations";
  }
}

if (db && view === "email") {
  try {
    let query = `SELECT * FROM messages WHERE 1=1`;
    const binds: any[] = [];

    if (statusFilter) {
      query += " AND status = ?";
      binds.push(statusFilter);
    }
    if (directionFilter) {
      query += " AND direction = ?";
      binds.push(directionFilter);
    }
    if (search) {
      query += " AND (subject LIKE ? OR recipient_email LIKE ? OR sender_email LIKE ?)";
      binds.push(`%${search}%`, `%${search}%`, `%${search}%`);
    }

    query += " ORDER BY created_at DESC LIMIT 200";
    const result = await db.prepare(query).bind(...binds).all();
    messages = result?.results || [];
  } catch (e: any) {
    error = e.message || "Failed to load messages";
  }
}

const statusOptions = ["", "sent", "delivered", "failed", "pending", "queued"];
const directionOptions = ["", "inbound", "outbound"];
const statusColors: Record<string, string> = {
  sent: "bg-emerald-100 text-emerald-700",
  delivered: "bg-blue-100 text-blue-700",
  failed: "bg-red-100 text-red-700",
  pending: "bg-amber-100 text-amber-700",
  queued: "bg-slate-100 text-slate-600",
};
const directionColors: Record<string, string> = {
  inbound: "bg-indigo-100 text-indigo-700",
  outbound: "bg-cyan-100 text-cyan-700",
};
---

<AdminLayout title="Messages" activeNav="messages">
  <div class="flex gap-2 mb-5">
    <a href="/admin/messages"
       class={`px-4 py-2 text-sm font-medium rounded-lg transition-colors ${view === "email" ? "bg-teal-600 text-white" : "bg-white text-slate-600 border border-slate-200 hover:bg-slate-50"}`}>
      ✉️ Email log
    </a>
    <a href="/admin/messages?view=threads"
       class={`px-4 py-2 text-sm font-medium rounded-lg transition-colors ${view === "threads" ? "bg-teal-600 text-white" : "bg-white text-slate-600 border border-slate-200 hover:bg-slate-50"}`}>
      💬 Guest ↔ Hotel
    </a>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/admin/messages" class="flex flex-wrap items-end gap-4">
      {view === "threads" && <input type="hidden" name="view" value="threads" />}
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-slate-500 mb-1">Search</label>
        <input type="text" name="search" value={search} placeholder={view === "threads" ? "Message text, guest, or hotel..." : "Subject, recipient, or sender..."} class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" />
      </div>
      <div class="min-w-[160px]" class:list={[view === "threads" && "hidden"]}>
        <label class="block text-xs font-medium text-slate-500 mb-1">Status</label>
        <select name="status" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent bg-white">
          <option value="">All Statuses</option>
          {statusOptions.filter((s) => s).map((s) => (
            <option value={s} selected={s === statusFilter}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>
          ))}
        </select>
      </div>
      <div class="min-w-[160px]" class:list={[view === "threads" && "hidden"]}>
        <label class="block text-xs font-medium text-slate-500 mb-1">Direction</label>
        <select name="direction" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent bg-white">
          <option value="">All Directions</option>
          {directionOptions.filter((d) => d).map((d) => (
            <option value={d} selected={d === directionFilter}>{d.charAt(0).toUpperCase() + d.slice(1)}</option>
          ))}
        </select>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="px-4 py-2 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors">
          Filter
        </button>
        <a href="/admin/messages" class="px-4 py-2 bg-slate-100 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-200 transition-colors">
          Reset
        </a>
      </div>
    </form>
  </div>

  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">{error}</div>
  )}

  {view === "threads" ? (
    <>
      <p class="text-sm text-slate-500 mb-4">
        {threads.length} of {threadCount} message{threadCount !== 1 ? "s" : ""} between guests and hotels
      </p>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        {threads.length === 0 ? (
          <p class="px-4 py-10 text-center text-slate-400 text-sm">No conversations yet.</p>
        ) : (
          <div class="divide-y divide-slate-100">
            {threads.map((m: any) => (
              <div class="px-4 py-4">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${m.sender_type === "guest" ? "bg-blue-100 text-blue-700" : "bg-indigo-100 text-indigo-700"}`}>
                    {m.sender_type === "guest" ? "Guest" : "Hotel"}
                  </span>
                  <span class="text-sm font-medium text-slate-800">{m.sender_name || (m.sender_type === "guest" ? m.guest_name : m.hotel_name) || "—"}</span>
                  {m.booking_id && (
                    <a href={`/admin/bookings/${m.booking_id}`} class="text-xs text-teal-600 hover:underline">#{m.booking_id}</a>
                  )}
                  {m.hotel_name && (
                    <a href={`/admin/hotels/${m.hotel_id}`} class="text-xs text-slate-500 hover:text-teal-600 hover:underline">{m.hotel_name}</a>
                  )}
                  {m.check_in_date && <span class="text-xs text-slate-400">{formatDisplayDate(m.check_in_date)}</span>}
                  {m.sender_type === "guest" && !m.is_read && (
                    <span class="text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5">unread by hotel</span>
                  )}
                  <span class="text-xs text-slate-300 ml-auto">{String(m.created_at || "").slice(0, 16)}</span>
                </div>
                <p class="text-sm text-slate-700 whitespace-pre-wrap break-words">{m.content}</p>
                {m.guest_email && (
                  <p class="text-xs text-slate-400 mt-1">{m.guest_email}</p>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </>
  ) : (
  <>
  <p class="text-sm text-slate-500 mb-4">{messages.length} message{messages.length !== 1 ? "s" : ""} found</p>

  <!-- Messages Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="text-left px-4 py-3 font-medium text-slate-600">ID</th>
            <th class="text-left px-4 py-3 font-medium text-slate-600">Subject</th>
            <th class="text-left px-4 py-3 font-medium text-slate-600">Recipient</th>
            <th class="text-left px-4 py-3 font-medium text-slate-600">Sender</th>
            <th class="text-center px-4 py-3 font-medium text-slate-600">Direction</th>
            <th class="text-center px-4 py-3 font-medium text-slate-600">Type</th>
            <th class="text-center px-4 py-3 font-medium text-slate-600">Status</th>
            <th class="text-left px-4 py-3 font-medium text-slate-600">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {messages.length === 0 ? (
            <tr>
              <td colspan="8" class="px-4 py-12 text-center text-slate-400">No messages found</td>
            </tr>
          ) : messages.map((m: any) => (
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-mono text-slate-500">#{m.id}</td>
              <td class="px-4 py-3">
                <div class="font-medium text-slate-900 max-w-[300px] truncate">{m.subject || "-"}</div>
                {m.booking_id && <div class="text-xs text-slate-400">Booking #{m.booking_id}</div>}
              </td>
              <td class="px-4 py-3 text-slate-600">{m.recipient_email || "-"}</td>
              <td class="px-4 py-3 text-slate-600">{m.sender_email || "-"}</td>
              <td class="px-4 py-3 text-center">
                {m.direction && (
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${directionColors[m.direction] || "bg-slate-100 text-slate-600"}`}>
                    {m.direction}
                  </span>
                )}
              </td>
              <td class="px-4 py-3 text-center text-slate-500 text-xs">{m.message_type || "-"}</td>
              <td class="px-4 py-3 text-center">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColors[m.status] || "bg-slate-100 text-slate-600"}`}>
                  {m.status || "-"}
                </span>
                {m.error_detail && (
                  <div class="text-xs text-red-400 mt-1 max-w-[150px] truncate" title={m.error_detail}>{m.error_detail}</div>
                )}
              </td>
              <td class="px-4 py-3 text-slate-500 text-xs">{formatDisplayDate(m.created_at)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  </>
  )}
</AdminLayout>
