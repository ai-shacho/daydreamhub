---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { PROPERTY_TYPES, PROPERTY_TYPE_LABELS } from '../../../../lib/propertyTypes';
import { supportedCurrencyCodes, ZERO_DECIMAL_CURRENCIES, formatLocalWithUsd } from '../../../../lib/currency';
import CountryCitySelect from '../../../../components/CountryCitySelect.astro';

const { id } = Astro.params;
const db = (Astro.locals as any).runtime?.env?.DB;

let hotel: any = null;
let plans: any[] = [];
let error = '';

if (!db) {
  error = 'Database not available';
} else {
  hotel = await db.prepare('SELECT * FROM hotels WHERE id = ?').bind(id).first();
  if (!hotel) error = 'Hotel not found';
  if (hotel) {
    const plansResult = await db.prepare('SELECT * FROM plans WHERE hotel_id = ? ORDER BY sort_order ASC, price_usd ASC').bind(id).all();
    plans = plansResult?.results || [];
  }
}

const hotelCurrency = String(hotel?.currency || 'USD').toUpperCase();
const isUsdHotel = hotelCurrency === 'USD';
const priceStep = ZERO_DECIMAL_CURRENCIES.has(hotelCurrency) ? '1' : '0.01';
const _allCurrencies = await supportedCurrencyCodes(db);
const currencyOptions = _allCurrencies.includes(hotelCurrency)
  ? _allCurrencies
  : [hotelCurrency, ..._allCurrencies];

const currentAmenities: string[] = hotel ? (() => { try { return JSON.parse(hotel.amenities || '[]'); } catch { return []; } })() : [];

const COMMON_AMENITIES = [
  'Air Conditioner (Cooling)','Air Conditioner (Heating)','Airport Transfer',
  'Balcony','Bar','Bar / Restaurant','Bath','Beach Access','Breakfast',
  'Coffee Machine','Concierge','Desk',
  'Electric pot',
  'Free Wi-Fi',
  'Garden','Gym',
  'Hair Dryer','Hot Tub',
  'Kitchen',
  'Laundry Service','Luggage Storage',
  'Meeting Room','Microwave',
  'Night wear',
  'Parking on Premises','Pool','Printer',
  'Refrigerator','Restaurant','Room Service',
  'Shampoo','Shower','Spa','Swimming Pool',
  'TEL','Toothbrush','Towels','TV',
];

const PLAN_TYPES = ['daycation','for_couple','for_work','luxury','personal_time','transit','overnight','early_check_in'];

// 30-minute interval time options
const TIME_OPTIONS: string[] = [];
for (let h = 0; h < 24; h++) {
  TIME_OPTIONS.push(`${h}:00`);
  TIME_OPTIONS.push(`${h}:30`);
}
---

<AdminLayout title={hotel ? `Edit: ${hotel.name}` : 'Edit Hotel'} activeNav="hotels">
  <div class="max-w-3xl mx-auto px-4 py-8">

    <!-- Sticky header: title + jump menu + save -->
    <div class="sticky top-0 z-30 -mx-4 px-4 py-3 mb-6 bg-slate-50/95 backdrop-blur border-b border-slate-200">
      <div class="flex items-center gap-3">
        <a href={`/admin/hotels/${id}`} class="text-gray-400 hover:text-gray-600 transition-colors flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
        </a>
        <div class="min-w-0 flex-1">
          <h1 class="text-lg font-bold text-slate-900 truncate">Edit Hotel Info</h1>
          {hotel && <p class="text-xs text-slate-500 truncate">{hotel.name}</p>}
        </div>
        {hotel && (
          <button type="button" class="save-btn flex-shrink-0 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors text-sm shadow-sm">
            Save Changes
          </button>
        )}
      </div>
      {hotel && (
        <nav class="mt-2 flex flex-wrap gap-1.5 text-xs">
          {[['sec-basic','Basic Information'],['sec-gallery','Gallery Images'],['sec-description','Description'],['sec-location','Location'],['sec-contact','Contact'],['sec-system','System Settings'],['sec-amenities','Amenities'],['sec-plans','Plans']].map(([id,label]) => (
            <a href={`#${id}`} class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-600 hover:border-teal-400 hover:text-teal-700 transition-colors">{label}</a>
          ))}
        </nav>
      )}
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6">{error}</div>
    )}

    {hotel && (
      <form id="edit-hotel-form" class="space-y-6">
        <input type="hidden" name="hotel_id" value={hotel.id} />

        <!-- Top action bar -->
        <div>
          <div id="form-success-top" class="hidden bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-3"></div>
          <div id="form-error-top" class="hidden bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3 mb-3"></div>
          <div class="flex gap-3">
            <button type="button" class="save-btn flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2.5 rounded-lg transition-colors text-sm">
              Save Changes
            </button>
            <a href={`/admin/hotels/${id}`} class="px-5 py-2.5 border border-gray-200 rounded-lg text-sm text-gray-600 hover:bg-gray-50 transition-colors">
              Cancel
            </a>
          </div>
        </div>

        <!-- Basic Info -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-basic" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Basic Information</h2>

          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Name (EN) <span class="text-red-500">*</span></label>
              <input name="name" type="text" required value={hotel.name || ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Name (JA)</label>
              <input name="name_ja" type="text" value={hotel.name_ja || ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Slug</label>
            <input name="slug" type="text" value={hotel.slug || ''}
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Property Type</label>
            <select name="property_type"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none bg-white">
              {PROPERTY_TYPES.map(t => (
                <option value={t} selected={hotel.property_type === t}>{PROPERTY_TYPE_LABELS[t]?.en ?? t}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
            <select name="status"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none bg-white">
              <option value="inactive" selected={hotel.status === 'inactive' || !hotel.status}>Inactive — not visible anywhere</option>
              <option value="demo" selected={hotel.status === 'demo'}>Demo — URL-only preview (hidden from listings)</option>
              <option value="active" selected={hotel.status === 'active'}>Active — publicly visible</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Thumbnail</label>
            <div class="flex gap-2 mb-2">
              <input name="thumbnail_url" id="thumbnail-url-input" type="text" value={hotel.thumbnail_url || ''}
                placeholder="https://..." class="flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
              <label for="thumbnail-upload" class="cursor-pointer flex items-center gap-1.5 px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm rounded-lg transition-colors whitespace-nowrap">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                Upload
              </label>
              <input id="thumbnail-upload" type="file" accept="image/*" class="hidden" />
            </div>
            <div id="thumbnail-preview" class={hotel.thumbnail_url ? '' : 'hidden'}>
              <img id="thumbnail-img" src={hotel.thumbnail_url || ''} alt="thumbnail" class="h-24 w-40 object-cover rounded-lg border" />
            </div>
            <span id="thumbnail-status" class="text-xs text-gray-500"></span>
          </div>
        </div>

        <!-- Gallery Images -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-gallery" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Gallery Images</h2>
          <p class="text-xs text-gray-500">Drag and drop to reorder. The first image will be shown as the main photo.</p>

          <!-- Upload button -->
          <div class="flex items-center gap-3">
            <label for="img-upload" class="cursor-pointer flex items-center gap-2 px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-lg transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
              Upload Images
            </label>
            <input id="img-upload" type="file" accept="image/*" multiple class="hidden" />
            <span id="upload-status" class="text-sm text-gray-500"></span>
          </div>

          <!-- Image grid (drag-sortable) -->
          <div id="gallery-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-3 min-h-[80px]">
            <!-- JS will populate this -->
          </div>
          <p id="gallery-empty" class="text-sm text-gray-400 text-center py-4 hidden">No images yet.</p>
        </div>

        <!-- Description -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-description" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Description</h2>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Description (EN)</label>
            <textarea name="description" rows={4}
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none resize-y"
            >{hotel.description || ''}</textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Description (JA)</label>
            <textarea name="description_ja" rows={4}
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none resize-y"
            >{hotel.description_ja || ''}</textarea>
          </div>
          <div id="cancellation">
            <label class="block text-sm font-medium text-slate-700 mb-1">Cancellation Policy</label>
            <textarea name="cancellation_policy" rows={3} placeholder="e.g. Free cancellation up to 24 hours before check-in (hotel local time). No refund after that."
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none resize-y"
            >{hotel.cancellation_policy || ''}</textarea>
          </div>
        </div>

        <!-- Location -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-location" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Location</h2>
          <div class="space-y-4">
            <CountryCitySelect
              country={hotel.country || ''}
              city={hotel.city || ''}
              labelClass="block text-sm font-medium text-slate-700 mb-1"
              inputClass="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none"
            />
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Pricing Currency</label>
              <select name="currency" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none">
                {currencyOptions.map((c) => (
                  <option value={c} selected={hotelCurrency === c}>{c}</option>
                ))}
              </select>
              <p class="text-xs text-slate-400 mt-1">Plan prices are entered in this currency; guests pay in USD. Changing it auto-converts existing plan prices.</p>
              <p class="text-xs text-amber-600 mt-1">⚠️ After changing the currency and saving, the page reloads automatically to apply the new currency display.</p>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Address</label>
            <input id="address" name="address" type="text" value={hotel.address || ''}
              placeholder="Street address or Plus Code (e.g. 8FW4V75V+8Q)"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            <button type="button" id="geocode-btn"
              class="mt-2 text-sm text-teal-600 hover:text-teal-800 underline">
              📍 Auto-fill coordinates from address or Plus Code
            </button>
          </div>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Latitude</label>
              <input id="latitude" name="latitude" type="number" step="any" value={hotel.latitude ?? ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Longitude</label>
              <input id="longitude" name="longitude" type="number" step="any" value={hotel.longitude ?? ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            </div>
          </div>
        </div>

        <!-- Contact -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-contact" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Contact</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Booking email (予約管理)</label>
              <input name="email" type="email" value={hotel.email || ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Contact email (担当者)</label>
              <input name="contact_email" type="email" value={hotel.contact_email || ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
              <p class="text-xs text-slate-400 mt-1">Booking &amp; cancellation emails are sent to both addresses.</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Phone</label>
              <input name="phone" type="tel" value={hotel.phone || ''}
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
            </div>
          </div>
        </div>

        <!-- System -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-system" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">System Settings</h2>
          <!-- ICAL_HIDDEN_START - iCal URL field hidden. Remove this comment block to restore.
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">iCal URL</label>
            <input name="ical_url" type="text" value={hotel.ical_url || ''}
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
          </div>
          ICAL_HIDDEN_END -->
          <div class="flex items-center gap-3">
            <input type="checkbox" name="auto_call_enabled" id="auto_call_enabled" value="1"
              checked={!!hotel.auto_call_enabled}
              class="w-4 h-4 text-teal-600 rounded border-gray-300 focus:ring-teal-500" />
            <label for="auto_call_enabled" class="text-sm font-medium text-slate-700">Auto-call enabled</label>
          </div>
        </div>

        <!-- Amenities -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
          <span id="sec-amenities" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Amenities</h2>
          <div class="space-y-2">
            {COMMON_AMENITIES.map(a => (
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                <input type="checkbox" name="amenities" value={a} checked={currentAmenities.includes(a)}
                  class="w-4 h-4 text-teal-600 rounded border-gray-300 focus:ring-teal-500" />
                {a}
              </label>
            ))}
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Custom amenities <span class="text-gray-400">(comma-separated)</span></label>
            <input id="custom-amenities" type="text"
              value={currentAmenities.filter(a => !COMMON_AMENITIES.includes(a)).join(', ')}
              placeholder="e.g. Sauna, Rooftop Terrace"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" />
          </div>
        </div>

        <!-- Bottom Actions -->
        <div>
          <div id="form-success-bottom" class="hidden bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-3"></div>
          <div id="form-error-bottom" class="hidden bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3 mb-3"></div>
          <div class="flex gap-3">
            <button type="button" class="save-btn flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2.5 rounded-lg transition-colors text-sm">
              Save Changes
            </button>
            <a href={`/admin/hotels/${id}`} class="px-5 py-2.5 border border-gray-200 rounded-lg text-sm text-gray-600 hover:bg-gray-50 transition-colors">
              Cancel
            </a>
          </div>
        </div>
      </form>

      <!-- Plans Section (separate from main form) -->
      <div class="mt-8 bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <span id="sec-plans" class="block -mt-24 pt-24"></span><h2 class="text-sm font-semibold text-teal-700 uppercase tracking-wide">Plans</h2>
          <button id="add-plan-btn" class="text-sm bg-teal-600 hover:bg-teal-700 text-white px-3 py-1.5 rounded-lg transition-colors">
            + Add Plan
          </button>
        </div>

        <!-- Add Plan Form (hidden by default) -->
        <div id="add-plan-form" class="hidden mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200 space-y-3">
          <h3 class="text-sm font-semibold text-slate-700">New Plan</h3>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Name (EN) *</label>
              <input id="new-name" type="text" placeholder="Plan name"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Name (JA)</label>
              <input id="new-name-ja" type="text" placeholder="プラン名"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Price ({hotelCurrency}) *{!isUsdHotel && <span class="text-slate-400 font-normal"> — USD auto-converted</span>}</label>
              <input id="new-price" type="number" step={priceStep} min="0" placeholder="0"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Plan Type</label>
              <select id="new-plan-type" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none bg-white">
                {PLAN_TYPES.map(t => <option value={t}>{t.replace('_',' ')}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Check-in</label>
              <input id="new-checkin" type="text" list="time-options" placeholder="10:00"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Check-out</label>
              <input id="new-checkout" type="text" list="time-options" placeholder="18:00"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Max Guests</label>
              <input id="new-guests" type="number" min="1" value="2"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Room Type</label>
              <input id="new-room-type" type="text" list="room-type-options" placeholder="e.g. Standard Twin"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Cancellation Policy (hours) *</label>
              <input id="new-cancellation-hours" type="number" min="0" step="1" value="24" required
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
              <p class="text-xs text-slate-400 mt-1">Hours before check-in that a guest can cancel for free, counted in the hotel's local time. 0 = non-refundable. Required — guests see this on the plan.</p>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Description</label>
            <textarea id="new-desc" rows={2} placeholder="Plan description..."
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none resize-y"></textarea>
          </div>
          <div id="add-plan-error" class="hidden text-red-600 text-xs"></div>
          <div class="flex gap-2">
            <button id="save-plan-btn" class="bg-teal-600 hover:bg-teal-700 text-white text-sm px-4 py-2 rounded-lg transition-colors">Save Plan</button>
            <button id="cancel-plan-btn" class="text-gray-600 text-sm px-4 py-2 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">Cancel</button>
          </div>
        </div>

        <!-- Plans List -->
        <div id="plans-list" class="space-y-2">
          {plans.length === 0 && (
            <p class="text-sm text-gray-400 text-center py-4">No plans yet.</p>
          )}
          {plans.map((plan: any) => (
            <div class="plan-row flex items-start gap-3 p-3 rounded-lg border border-gray-100 hover:border-gray-200 transition-colors" data-plan-id={plan.id} data-sort-order={plan.sort_order || 0}>
              <div class="flex flex-col gap-0.5 flex-shrink-0">
                <button class="move-plan-up text-xs text-slate-400 hover:text-indigo-600 px-1 py-0.5 rounded hover:bg-indigo-50 transition-colors" title="Move up">▲</button>
                <button class="move-plan-down text-xs text-slate-400 hover:text-indigo-600 px-1 py-0.5 rounded hover:bg-indigo-50 transition-colors" title="Move down">▼</button>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-medium text-sm text-slate-900 plan-name">{plan.name}</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full ${plan.is_active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>
                    {plan.is_active ? 'Active' : 'Inactive'}
                  </span>
                  <span class="text-xs bg-teal-50 text-teal-700 px-2 py-0.5 rounded-full">{plan.plan_type}</span>
                </div>
                <div class="text-xs text-gray-500 mt-0.5">
                  {formatLocalWithUsd(Number(plan.price_local ?? plan.price_usd), hotelCurrency, Number(plan.price_usd))} · {plan.check_in_time}–{plan.check_out_time} · max {plan.max_guests} guests
                  {plan.room_type ? ` · ${plan.room_type}` : ''}
                  {' · '}
                  {plan.cancellation_hours == null
                    ? <span class="text-red-600 font-medium">no cancellation policy</span>
                    : Number(plan.cancellation_hours) === 0
                      ? 'non-refundable'
                      : `free cancellation ${plan.cancellation_hours}h before`}
                </div>
              </div>
              <div class="flex gap-1 flex-shrink-0">
                <button class="edit-plan-btn text-xs px-2 py-1 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 transition-colors">Edit</button>
                <button class="addons-btn text-xs px-2 py-1 bg-teal-50 text-teal-700 rounded hover:bg-teal-100 transition-colors">Add-ons</button>
                <button class="toggle-plan-btn text-xs px-2 py-1 rounded transition-colors"
                  class:list={[plan.is_active ? 'bg-red-50 text-red-600 hover:bg-red-100' : 'bg-green-50 text-green-700 hover:bg-green-100']}>
                  {plan.is_active ? 'Deactivate' : 'Activate'}
                </button>
                <button class="delete-plan-btn text-xs px-2 py-1 bg-red-50 text-red-600 rounded hover:bg-red-100 transition-colors">Delete</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Add-ons panel. Same three pricing shapes and age-band rules the owner
           screen offers, so a listing can be set up from either side. -->
      <div id="addons-modal" data-currency={hotelCurrency} class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
          <div class="flex items-center justify-between px-5 py-3 border-b border-slate-200 sticky top-0 bg-white">
            <div>
              <h3 class="text-base font-semibold text-slate-900">Paid add-ons</h3>
              <p id="addons-plan-name" class="text-xs text-slate-500"></p>
            </div>
            <button id="addons-close" class="text-slate-400 hover:text-slate-600 text-xl leading-none">&times;</button>
          </div>
          <div class="p-5">
            <div id="addons-list" class="space-y-2 mb-4"></div>
            <form id="addon-form" class="border-t border-slate-200 pt-4 space-y-3">
              <input type="hidden" id="addon-id" />
              <div class="grid grid-cols-2 gap-3">
                <label class="block">
                  <span class="block text-xs font-medium text-slate-600 mb-1">Name (English) *</span>
                  <input id="addon-name" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" placeholder="Airport transfer" />
                </label>
                <label class="block">
                  <span class="block text-xs font-medium text-slate-600 mb-1">Name (Japanese)</span>
                  <input id="addon-name-ja" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" placeholder="空港送迎" />
                </label>
              </div>
              <label class="block">
                <span class="block text-xs font-medium text-slate-600 mb-1">How it is charged</span>
                <select id="addon-pricing" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
                  <option value="per_room">Per booking — one flat charge</option>
                  <option value="per_person">Per guest — same rate for everyone counted</option>
                  <option value="per_adult_child">Per guest — adults, children and infants priced separately</option>
                </select>
              </label>
              <div class="grid grid-cols-3 gap-3">
                <label class="block">
                  <span class="block text-xs font-medium text-slate-600 mb-1">Price <span id="addon-cur" class="text-slate-400"></span></span>
                  <input id="addon-price" type="number" step="0.01" min="0" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
                </label>
                <label class="block addon-band-price hidden">
                  <span class="block text-xs font-medium text-slate-600 mb-1">Child price</span>
                  <input id="addon-child-price" type="number" step="0.01" min="0" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
                </label>
                <label class="block addon-band-price hidden">
                  <span class="block text-xs font-medium text-slate-600 mb-1">Infant price</span>
                  <input id="addon-infant-price" type="number" step="0.01" min="0" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
                </label>
              </div>
              <div id="addon-counts">
                <span class="block text-xs font-medium text-slate-600 mb-1">Charged for</span>
                <p class="text-xs text-slate-400 mb-2">A day pass may count everyone who walks in; a tasting may count adults only.</p>
                <div class="flex gap-4 text-sm">
                  <label class="flex items-center gap-1.5"><input type="checkbox" id="addon-adults" checked class="accent-teal-600" /> Adults</label>
                  <label class="flex items-center gap-1.5"><input type="checkbox" id="addon-children" checked class="accent-teal-600" /> Children</label>
                  <label class="flex items-center gap-1.5"><input type="checkbox" id="addon-infants" class="accent-teal-600" /> Infants</label>
                </div>
              </div>
              <div class="flex gap-2 pt-1">
                <button type="submit" id="addon-save" class="px-4 py-2 bg-teal-600 text-white rounded-lg text-sm font-medium hover:bg-teal-700">Add</button>
                <button type="button" id="addon-cancel" class="hidden px-4 py-2 border border-slate-300 rounded-lg text-sm text-slate-600 hover:bg-slate-50">Cancel</button>
                <span id="addon-msg" class="text-xs self-center"></span>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Time datalist (shared) -->
      <datalist id="time-options">
        {TIME_OPTIONS.map(t => <option value={t} />)}
      </datalist>
      <datalist id="room-type-options">
        {[...new Set(plans.map((p: any) => p.room_type).filter(Boolean))].map(rt => <option value={rt} />)}
      </datalist>

      <!-- Edit Plan Modal -->
      <div id="edit-plan-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 space-y-4">
          <h3 class="text-base font-semibold text-slate-900">Edit Plan</h3>
          <input type="hidden" id="edit-plan-id" />
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Name (EN) *</label>
              <input id="edit-plan-name" type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Name (JA)</label>
              <input id="edit-plan-name-ja" type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Price ({hotelCurrency}){!isUsdHotel && <span class="text-slate-400 font-normal"> — USD auto-converted</span>}</label>
              <input id="edit-plan-price" type="number" step={priceStep} class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Plan Type</label>
              <select id="edit-plan-type" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none bg-white">
                {PLAN_TYPES.map(t => <option value={t}>{t.replace('_',' ')}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Check-in</label>
              <input id="edit-plan-checkin" type="text" list="time-options" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Check-out</label>
              <input id="edit-plan-checkout" type="text" list="time-options" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Room Type</label>
              <input id="edit-plan-room-type" type="text" list="room-type-options" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Cancellation Policy (hours) *</label>
              <input id="edit-plan-cancellation-hours" type="number" min="0" step="1" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
              <p class="text-xs text-slate-400 mt-1">Hours before check-in that a guest can cancel for free, counted in the hotel's local time. 0 = non-refundable. Required — guests see this on the plan.</p>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Max Guests</label>
              <input id="edit-plan-guests" type="number" min="1" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Description</label>
            <textarea id="edit-plan-desc" rows={2} class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-400 outline-none resize-y"></textarea>
          </div>
          <div id="edit-plan-error" class="hidden text-red-600 text-xs"></div>
          <div class="flex gap-2">
            <button id="update-plan-btn" class="bg-teal-600 hover:bg-teal-700 text-white text-sm px-4 py-2 rounded-lg transition-colors">Update</button>
            <button id="close-modal-btn" class="text-gray-600 text-sm px-4 py-2 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">Cancel</button>
          </div>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

<script is:inline define:vars={{ hotelId: id, originalCurrency: hotelCurrency }}>
// ── Hotel Info Save ──
async function saveHotel() {
  const btns = document.querySelectorAll('.save-btn');
  const errEls = [document.getElementById('form-error-top'), document.getElementById('form-error-bottom')];
  const successEls = [document.getElementById('form-success-top'), document.getElementById('form-success-bottom')];
  errEls.forEach(el => el && (el.className = 'hidden'));
  successEls.forEach(el => el && (el.className = 'hidden'));
  btns.forEach(b => { b.disabled = true; b.textContent = 'Saving...'; });

  const form = document.getElementById('edit-hotel-form');
  const body = { id: parseInt(form.hotel_id.value) };
  const fields = ['name','name_ja','slug','description','description_ja','cancellation_policy','city','country','currency',
    'address','thumbnail_url','property_type','status','email','contact_email','phone']; // ICAL_HIDDEN - 'ical_url' removed. Add back to restore.
  for (const f of fields) { if (form[f]) body[f] = form[f].value; }
  if (form.latitude?.value !== '') body.latitude = parseFloat(form.latitude.value);
  if (form.longitude?.value !== '') body.longitude = parseFloat(form.longitude.value);
  body.auto_call_enabled = form.auto_call_enabled?.checked ? 1 : 0;

  // Collect amenities
  const checked = [...document.querySelectorAll('input[name="amenities"]:checked')].map(el => el.value);
  const custom = document.getElementById('custom-amenities').value.split(',').map(s => s.trim()).filter(Boolean);
  body.amenities = JSON.stringify([...new Set([...checked, ...custom])]);

  try {
    const res = await fetch('/api/admin/hotels', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (res.ok && data.success) {
      const currencyChanged = String(body.currency || '').toUpperCase() !== String(originalCurrency || 'USD').toUpperCase();
      const msg = currencyChanged ? '✅ Saved. Reloading to apply the new currency display…' : '✅ Page Updated Successfully';
      successEls.forEach(el => {
        if (!el) return;
        el.className = 'block bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3';
        el.textContent = msg;
      });
      if (currencyChanged) setTimeout(function(){ window.location.reload(); }, 1200);
    } else {
      const msg = data.error || 'Failed to save changes.';
      errEls.forEach(el => {
        if (!el) return;
        el.className = 'block bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3';
        el.textContent = msg;
      });
    }
  } catch {
    const msg = 'Connection error. Please try again.';
    errEls.forEach(el => {
      if (!el) return;
      el.className = 'block bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3';
      el.textContent = msg;
    });
  } finally { btns.forEach(b => { b.disabled = false; b.textContent = 'Save Changes'; }); }
}

document.querySelectorAll('.save-btn').forEach(function(btn) {
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    saveHotel();
  });
});

const HOTEL_ID = parseInt(hotelId);

// ── Thumbnail Upload ──
document.getElementById('thumbnail-upload')?.addEventListener('change', async function() {
  const file = this.files?.[0];
  if (!file) return;
  const statusEl = document.getElementById('thumbnail-status');
  statusEl.textContent = 'Uploading...';
  const fd = new FormData();
  fd.append('hotel_id', HOTEL_ID);
  fd.append('file', file);
  try {
    const res = await fetch('/api/admin/hotel-images', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.success) {
      const input = document.getElementById('thumbnail-url-input');
      input.value = data.image_url;
      const preview = document.getElementById('thumbnail-preview');
      const img = document.getElementById('thumbnail-img');
      img.src = data.image_url;
      preview.classList.remove('hidden');
      statusEl.textContent = '✅ Uploaded';
    } else {
      statusEl.textContent = `Error: ${data.error}`;
    }
  } catch { statusEl.textContent = 'Connection error'; }
  this.value = '';
});

// Update thumbnail preview on URL input change
document.getElementById('thumbnail-url-input')?.addEventListener('input', function() {
  const img = document.getElementById('thumbnail-img');
  const preview = document.getElementById('thumbnail-preview');
  if (this.value) { img.src = this.value; preview.classList.remove('hidden'); }
  else { preview.classList.add('hidden'); }
});

// ── Gallery Images ──
(function() {
  const grid = document.getElementById('gallery-grid');
  const emptyMsg = document.getElementById('gallery-empty');
  const statusEl = document.getElementById('upload-status');
  let images = []; // {id, image_url, sort_order}
  let dragSrcId = null;

  async function loadImages() {
    try {
      const res = await fetch(`/api/admin/hotel-images?hotel_id=${HOTEL_ID}`);
      const data = await res.json();
      images = data.images || [];
      renderGrid();
    } catch (e) { console.error('Failed to load images:', e); }
  }

  function renderGrid() {
    grid.innerHTML = '';
    if (!images.length) { emptyMsg.classList.remove('hidden'); return; }
    emptyMsg.classList.add('hidden');
    images.forEach(img => {
      const div = document.createElement('div');
      div.className = 'relative group rounded-lg overflow-hidden border-2 border-transparent hover:border-teal-400 transition-all cursor-grab aspect-square bg-gray-100';
      div.draggable = true;
      div.dataset.id = img.id;
      div.innerHTML = `
        <img src="${img.image_url}" alt="" class="w-full h-full object-cover pointer-events-none" />
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all flex items-center justify-center opacity-0 group-hover:opacity-100">
          <button class="delete-img-btn bg-red-500 text-white rounded-full w-7 h-7 flex items-center justify-center text-sm hover:bg-red-600" data-id="${img.id}">✕</button>
        </div>
        <div class="absolute top-1 left-1 bg-black/50 text-white text-xs rounded px-1 order-badge"></div>
      `;
      // Drag events
      div.addEventListener('dragstart', e => { dragSrcId = img.id; div.classList.add('opacity-50'); e.dataTransfer.effectAllowed = 'move'; });
      div.addEventListener('dragend', () => { div.classList.remove('opacity-50'); });
      div.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; div.classList.add('border-teal-400'); });
      div.addEventListener('dragleave', () => div.classList.remove('border-teal-400'));
      div.addEventListener('drop', async e => {
        e.preventDefault(); div.classList.remove('border-teal-400');
        if (dragSrcId === img.id) return;
        // Swap positions
        const srcIdx = images.findIndex(i => i.id === dragSrcId);
        const dstIdx = images.findIndex(i => i.id === img.id);
        if (srcIdx < 0 || dstIdx < 0) return;
        const [moved] = images.splice(srcIdx, 1);
        images.splice(dstIdx, 0, moved);
        images.forEach((im, idx) => im.sort_order = idx);
        renderGrid();
        // Save order
        await fetch('/api/admin/hotel-images', { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ images: images.map(i => ({id:i.id, sort_order:i.sort_order})) }) });
      });
      // Delete
      div.querySelector('.delete-img-btn').addEventListener('click', async (e) => {
  e.preventDefault();
        if (!confirm('Delete this image?')) return;
        await fetch(`/api/admin/hotel-images?id=${img.id}`, { method: 'DELETE' });
        images = images.filter(i => i.id !== img.id);
        images.forEach((im, idx) => im.sort_order = idx);
        renderGrid();
      });
      grid.appendChild(div);
    });
    // Update order badges
    grid.querySelectorAll('.order-badge').forEach((badge, idx) => { badge.textContent = idx === 0 ? 'Main' : `${idx+1}`; });
  }

  // File upload
  document.getElementById('img-upload').addEventListener('change', async function() {
    const files = [...this.files];
    if (!files.length) return;
    statusEl.textContent = `Uploading... (0/${files.length})`;
    let done = 0;
    for (const file of files) {
      const fd = new FormData();
      fd.append('hotel_id', HOTEL_ID);
      fd.append('file', file);
      try {
        const res = await fetch('/api/admin/hotel-images', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
          images.push({ id: data.id, image_url: data.image_url, sort_order: data.sort_order });
          done++;
          statusEl.textContent = `Uploading... (${done}/${files.length})`;
        } else {
          statusEl.textContent = `Error: ${data.error}`;
        }
      } catch { statusEl.textContent = 'Connection error'; }
    }
    renderGrid();
    statusEl.textContent = done > 0 ? `✅ ${done} image(s) uploaded` : '';
    this.value = '';
  });

  loadImages();
})();

// ── Plans ──

// Add plan toggle
document.getElementById('add-plan-btn')?.addEventListener('click', () => {
  document.getElementById('add-plan-form').classList.toggle('hidden');
});
document.getElementById('cancel-plan-btn')?.addEventListener('click', () => {
  document.getElementById('add-plan-form').classList.add('hidden');
});

// Save new plan
document.getElementById('save-plan-btn')?.addEventListener('click', async () => {
  const errEl = document.getElementById('add-plan-error');
  errEl.className = 'hidden';
  const name = document.getElementById('new-name').value.trim();
  if (!name) { errEl.textContent = 'Name is required'; errEl.className = 'block text-red-600 text-xs'; return; }
  const body = {
    hotel_id: HOTEL_ID,
    name,
    name_ja: document.getElementById('new-name-ja').value || null,
    price: parseFloat(document.getElementById('new-price').value) || 0,
    plan_type: document.getElementById('new-plan-type').value,
    check_in_time: document.getElementById('new-checkin').value,
    check_out_time: document.getElementById('new-checkout').value,
    max_guests: parseInt(document.getElementById('new-guests').value) || 2,
    room_type: document.getElementById('new-room-type').value.trim() || null,
    // Sent raw: a blank has to be an error, not a silent 0 (non-refundable).
    cancellation_hours: document.getElementById('new-cancellation-hours').value.trim(),
    description: document.getElementById('new-desc').value,
  };
  const res = await fetch('/api/admin/plans', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const data = await res.json();
  if (data.success) { window.location.reload(); } else { errEl.textContent = data.error || 'Error'; errEl.className = 'block text-red-600 text-xs'; }
});

// Plan row actions (event delegation)
document.getElementById('plans-list')?.addEventListener('click', async function(e) {
  const btn = e.target.closest('button');
  if (!btn) return;
  const row = btn.closest('.plan-row');
  const planId = parseInt(row?.dataset.planId);

  if (btn.classList.contains('delete-plan-btn')) {
    if (!confirm('Delete this plan?')) return;
    const res = await fetch(`/api/admin/plans?id=${planId}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) row.remove(); else alert(data.error);
  }

  if (btn.classList.contains('toggle-plan-btn')) {
    const isActive = btn.textContent.trim() === 'Deactivate' ? 0 : 1;
    const res = await fetch('/api/admin/plans', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: planId, is_active: isActive }) });
    const data = await res.json();
    if (data.success) window.location.reload(); else alert(data.error);
  }

  if (btn.classList.contains('edit-plan-btn')) {
    // Populate modal from row data
    const nameEl = row.querySelector('.plan-name');
    document.getElementById('edit-plan-id').value = planId;
    document.getElementById('edit-plan-name').value = nameEl?.textContent || '';
    // Fetch full plan data
    const res = await fetch(`/api/admin/plans?hotel_id=${HOTEL_ID}`);
    const data = await res.json();
    const plan = (data.plans || []).find(p => p.id === planId);
    if (plan) {
      document.getElementById('edit-plan-name').value = plan.name || '';
      document.getElementById('edit-plan-name-ja').value = plan.name_ja || '';
      document.getElementById('edit-plan-price').value = plan.price_local != null ? plan.price_local : (plan.price_usd || '');
      document.getElementById('edit-plan-type').value = plan.plan_type || 'daycation';
      document.getElementById('edit-plan-checkin').value = plan.check_in_time || '';
      document.getElementById('edit-plan-checkout').value = plan.check_out_time || '';
      document.getElementById('edit-plan-guests').value = plan.max_guests || 2;
      document.getElementById('edit-plan-room-type').value = plan.room_type || '';
      document.getElementById('edit-plan-cancellation-hours').value = plan.cancellation_hours != null ? plan.cancellation_hours : 24;
      document.getElementById('edit-plan-desc').value = plan.description || '';

    }
    document.getElementById('edit-plan-modal').classList.remove('hidden');
  }
});

// Close modal
document.getElementById('close-modal-btn')?.addEventListener('click', () => {
  document.getElementById('edit-plan-modal').classList.add('hidden');
});
document.getElementById('edit-plan-modal')?.addEventListener('click', function(e) {
  if (e.target === this) this.classList.add('hidden');
});

// Update plan
document.getElementById('update-plan-btn')?.addEventListener('click', async () => {
  const errEl = document.getElementById('edit-plan-error');
  errEl.className = 'hidden';
  const body = {
    id: parseInt(document.getElementById('edit-plan-id').value),
    name: document.getElementById('edit-plan-name').value.trim(),
    name_ja: document.getElementById('edit-plan-name-ja').value || null,
    price: parseFloat(document.getElementById('edit-plan-price').value) || 0,
    plan_type: document.getElementById('edit-plan-type').value,
    check_in_time: document.getElementById('edit-plan-checkin').value,
    check_out_time: document.getElementById('edit-plan-checkout').value,
    max_guests: parseInt(document.getElementById('edit-plan-guests').value) || 2,
    room_type: document.getElementById('edit-plan-room-type').value.trim() || null,
    cancellation_hours: document.getElementById('edit-plan-cancellation-hours').value.trim(),
    description: document.getElementById('edit-plan-desc').value,
  };
  if (!body.name) { errEl.textContent = 'Name is required'; errEl.className = 'block text-red-600 text-xs'; return; }
  const res = await fetch('/api/admin/plans', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const data = await res.json();
  if (data.success) window.location.reload(); else { errEl.textContent = data.error || 'Error'; errEl.className = 'block text-red-600 text-xs'; }
});

// Geocode button
// ── Paid add-ons ──
// The same three pricing shapes and age-band rules the owner screen offers.
// Prices are entered in the hotel's own currency; the server derives the USD
// cache, so nothing here converts anything.
(function addons() {
  // Add-on prices are entered in the hotel's own currency, exactly as plan
  // prices are; the server derives the USD cache.
  const HOTEL_CURRENCY = document.getElementById('addons-modal')?.dataset.currency || 'USD';
  const modal = document.getElementById('addons-modal');
  if (!modal) return;
  const listEl = document.getElementById('addons-list');
  const form = document.getElementById('addon-form');
  const msg = document.getElementById('addon-msg');
  const pricing = document.getElementById('addon-pricing');
  let planId = null;

  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const bandsVisible = () => {
    const showBands = pricing.value === 'per_adult_child';
    document.querySelectorAll('.addon-band-price').forEach((el) => el.classList.toggle('hidden', !showBands));
    // A flat per-booking charge is not counted per guest, so who it covers
    // does not apply.
    document.getElementById('addon-counts').classList.toggle('hidden', pricing.value === 'per_room');
  };
  pricing.addEventListener('change', bandsVisible);

  function resetForm() {
    document.getElementById('addon-id').value = '';
    form.reset();
    document.getElementById('addon-adults').checked = true;
    document.getElementById('addon-children').checked = true;
    document.getElementById('addon-infants').checked = false;
    document.getElementById('addon-save').textContent = 'Add';
    document.getElementById('addon-cancel').classList.add('hidden');
    bandsVisible();
  }

  const COVERS = (o) => [o.counts_adults && 'adults', o.counts_children && 'children', o.counts_infants && 'infants']
    .filter(Boolean).join(' + ');

  async function load() {
    listEl.innerHTML = '<p class="text-sm text-slate-400">Loading…</p>';
    const res = await fetch('/api/admin/plan-options?plan_id=' + encodeURIComponent(planId));
    const data = await res.json();
    const opts = data.options || [];
    if (!opts.length) {
      listEl.innerHTML = '<p class="text-sm text-slate-400">No add-ons on this plan yet.</p>';
      return;
    }
    listEl.innerHTML = opts.map((o) => {
      const shape = o.pricing_type === 'per_room' ? 'per booking'
        : o.pricing_type === 'per_person' ? 'per guest'
        : 'per guest, by age';
      const covers = o.pricing_type === 'per_room' ? '' : ' · ' + (COVERS(o) || 'nobody');
      return '<div class="flex items-start justify-between gap-3 p-3 border border-slate-200 rounded-lg" data-opt=\'' + esc(JSON.stringify(o)) + '\'>' +
        '<div class="min-w-0"><div class="text-sm font-medium text-slate-800">' + esc(o.name) +
          (o.name_ja ? ' <span class="text-slate-400 font-normal">' + esc(o.name_ja) + '</span>' : '') + '</div>' +
        '<div class="text-xs text-slate-500 mt-0.5">' + esc(o.price_local) + ' ' + shape + covers +
          (o.pricing_type === 'per_adult_child' ? ' (child ' + esc(o.child_price_local ?? 0) + ', infant ' + esc(o.infant_price_local ?? 0) + ')' : '') +
          '</div></div>' +
        '<div class="flex gap-1 flex-shrink-0">' +
          '<button class="addon-edit text-xs px-2 py-1 bg-indigo-50 text-indigo-700 rounded">Edit</button>' +
          '<button class="addon-del text-xs px-2 py-1 bg-red-50 text-red-600 rounded">Delete</button>' +
        '</div></div>';
    }).join('');
  }

  document.getElementById('plans-list')?.addEventListener('click', (e) => {
    const btn = e.target.closest('.addons-btn');
    if (!btn) return;
    const row = btn.closest('.plan-row');
    planId = Number(row.getAttribute('data-plan-id'));
    document.getElementById('addons-plan-name').textContent =
      (row.querySelector('.font-medium')?.textContent || '').trim();
    document.getElementById('addon-cur').textContent = '(' + HOTEL_CURRENCY + ')';
    msg.textContent = '';
    resetForm();
    modal.classList.remove('hidden');
    load();
  });

  document.getElementById('addons-close').addEventListener('click', () => modal.classList.add('hidden'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
  document.getElementById('addon-cancel').addEventListener('click', resetForm);

  listEl.addEventListener('click', async (e) => {
    const wrap = e.target.closest('[data-opt]');
    if (!wrap) return;
    const o = JSON.parse(wrap.getAttribute('data-opt'));
    if (e.target.closest('.addon-edit')) {
      document.getElementById('addon-id').value = o.id;
      document.getElementById('addon-name').value = o.name || '';
      document.getElementById('addon-name-ja').value = o.name_ja || '';
      pricing.value = o.pricing_type;
      document.getElementById('addon-price').value = o.price_local ?? '';
      document.getElementById('addon-child-price').value = o.child_price_local ?? '';
      document.getElementById('addon-infant-price').value = o.infant_price_local ?? '';
      document.getElementById('addon-adults').checked = !!o.counts_adults;
      document.getElementById('addon-children').checked = !!o.counts_children;
      document.getElementById('addon-infants').checked = !!o.counts_infants;
      document.getElementById('addon-save').textContent = 'Save changes';
      document.getElementById('addon-cancel').classList.remove('hidden');
      bandsVisible();
      return;
    }
    if (e.target.closest('.addon-del')) {
      if (!confirm('Delete "' + o.name + '"? Past bookings keep their own copy and are not affected.')) return;
      await fetch('/api/admin/plan-options?id=' + o.id, { method: 'DELETE' });
      load();
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('addon-id').value;
    const body = {
      plan_id: planId,
      name: document.getElementById('addon-name').value.trim(),
      name_ja: document.getElementById('addon-name-ja').value.trim(),
      pricing_type: pricing.value,
      price: Number(document.getElementById('addon-price').value || 0),
      child_price: Number(document.getElementById('addon-child-price').value || 0),
      infant_price: Number(document.getElementById('addon-infant-price').value || 0),
      counts_adults: document.getElementById('addon-adults').checked,
      counts_children: document.getElementById('addon-children').checked,
      counts_infants: document.getElementById('addon-infants').checked,
    };
    if (id) body.id = Number(id);
    msg.textContent = 'Saving…';
    msg.className = 'text-xs self-center text-slate-500';
    try {
      const res = await fetch('/api/admin/plan-options', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      msg.textContent = id ? 'Saved.' : 'Added.';
      msg.className = 'text-xs self-center text-emerald-600';
      resetForm();
      load();
    } catch (err) {
      msg.textContent = err.message;
      msg.className = 'text-xs self-center text-red-600';
    }
  });
})();

document.getElementById('geocode-btn')?.addEventListener('click', async () => {
  const addressInput = document.getElementById('address');
  const address = addressInput?.value;
  if (!address) { alert('Please enter an address first'); return; }
  const btn = document.getElementById('geocode-btn');
  if (!btn) return;
  btn.textContent = '⏳ Looking up...';
  btn.disabled = true;
  try {
    const response = await fetch(`/api/geocode?address=${encodeURIComponent(address)}`);
    const result = await response.json();
    if (result.latitude && result.longitude) {
      document.getElementById('latitude').value = result.latitude.toFixed(6);
      document.getElementById('longitude').value = result.longitude.toFixed(6);
      btn.textContent = '✅ Coordinates updated';
    } else if (response.status === 404) {
      // Only a 404 means the address itself could not be found.
      btn.textContent = '❌ Not found — try a more specific address';
    } else {
      // Anything else is our fault, not the address's — a missing API key
      // returns 500. Saying "be more specific" sends someone off rewriting an
      // address that was already correct.
      btn.textContent = '⚠️ Lookup unavailable: ' + (result.error || ('server error ' + response.status));
    }
  } catch {
    btn.textContent = '❌ Error — please try again';
  } finally {
    setTimeout(() => { btn.textContent = '📍 Auto-fill coordinates from address'; btn.disabled = false; }, 3000);
  }
});

// ── Plan Reorder ──
async function savePlanOrder() {
  var rows = document.querySelectorAll('#plans-list .plan-row');
  var plans = [];
  rows.forEach(function(row, i) {
    plans.push({ id: Number(row.getAttribute('data-plan-id')), sort_order: i });
  });
  try {
    await fetch('/api/admin/plans', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ plans: plans })
    });
  } catch {}
}

document.getElementById('plans-list')?.addEventListener('click', function(e) {
  var btn = e.target.closest('.move-plan-up, .move-plan-down');
  if (!btn) return;
  var row = btn.closest('.plan-row');
  if (!row) return;
  var list = document.getElementById('plans-list');
  if (btn.classList.contains('move-plan-up')) {
    var prev = row.previousElementSibling;
    if (prev && prev.classList.contains('plan-row')) {
      list.insertBefore(row, prev);
      savePlanOrder();
    }
  } else {
    var next = row.nextElementSibling;
    if (next && next.classList.contains('plan-row')) {
      list.insertBefore(next, row);
      savePlanOrder();
    }
  }
});
</script>
