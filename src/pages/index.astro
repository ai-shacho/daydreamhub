  // ===== Call Status Polling =====
  window._startCallPolling = function(callId, sid, loc) {
    var maxAttempts = 36; // 最大3分（5秒×36回）
    var attempt = 0;
    var waitEl = document.createElement('div');
    waitEl.id = 'call-polling-' + callId;
    waitEl.className = 'flex gap-2';
    waitEl.innerHTML =
      '<div class="w-6 h-6 bg-white/20 rounded-full flex-shrink-0 flex items-center justify-center text-white text-[10px] font-bold mt-0.5">AI</div>' +
      '<div class="bg-white/20 text-white/80 rounded-xl rounded-tl-none px-3 py-2 text-sm border border-white/10">' +
        '<span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse mr-2"></span>' +
        '📞 Calling hotel...' +
      '</div>';
    messagesEl.appendChild(waitEl);
    messagesEl.scrollTop = messagesEl.scrollHeight;

    var timer = setInterval(async function() {
      attempt++;
      if (attempt > maxAttempts) {
        clearInterval(timer);
        waitEl.remove();
        addMsg('⏱️ Call timed out. Please check back later.', 'assistant');
        return;
      }
      try {
        var r = await fetch('/api/concierge/chat', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({session_id: sid, message: '__check_call_status:' + callId, locale: loc || 'en'})
        });
        var d = await r.json();
        var status = d.metadata?.call_status || d.metadata?.status;
        if (status === 'calling' || status === 'pending') return; // まだ通話中
        // 完了・失敗・その他
        clearInterval(timer);
        waitEl.remove();
        if (d.response) addMsg(d.response, 'assistant');

        // 全件失敗 → 返金通知
        if (status === 'failed' && d.metadata?.failed_count >= 1) {
          setTimeout(function(){
            addMsg(
              '💸 **Could not reach any hotels.**\n\n' +
              'Your $7 fee will be fully refunded automatically (PayPal processing takes 2–5 business days).\n\n' +
              'Please try a different date/time or another city.',
              'assistant'
            );
          }, 1000);
        }
      } catch(e) { /* retry */ }
    }, 5000); // 5秒ごとにポーリング
  };

  // ===== External Hotel Call Booking Flow ($7 for up to 3 hotels) =====
  // Ask for the guest's position once, the first time they say anything. Doing
  // it on page load would prompt everyone who is only browsing; doing it lazily
  // means the prompt arrives when the answer is about to be used. Nothing waits
  // on it — if it is refused or slow, the server falls back to Cloudflare's
  // city-level guess and the ordering is merely coarser.
  var _heroGeoAsked = false;
  function heroAskForPosition() {
    if (_heroGeoAsked || !navigator.geolocation) return;
    _heroGeoAsked = true;
    navigator.geolocation.getCurrentPosition(
      function(pos) { window._heroGeo = { lat: pos.coords.latitude, lng: pos.coords.longitude }; },
      function() { /* refused or unavailable — the edge guess stands in */ },
      { enableHighAccuracy: false, timeout: 8000, maximumAge: 300000 }
    );
  }

