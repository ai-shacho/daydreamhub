    {city:"Lisbon",country:"Portugal"},{city:"Stockholm",country:"Sweden"},{city:"Oslo",country:"Norway"},
    {city:"Copenhagen",country:"Denmark"},{city:"Helsinki",country:"Finland"},{city:"Zurich",country:"Switzerland"},
    {city:"Geneva",country:"Switzerland"},{city:"Brussels",country:"Belgium"},{city:"Dublin",country:"Ireland"},
    {city:"Milan",country:"Italy"},{city:"Munich",country:"Germany"},{city:"Frankfurt",country:"Germany"},
    {city:"Hamburg",country:"Germany"},{city:"Cologne",country:"Germany"},{city:"Düsseldorf",country:"Germany"},
    {city:"Marseille",country:"France"},{city:"Lyon",country:"France"},{city:"Nice",country:"France"},
    {city:"Istanbul",country:"Turkey"},{city:"Ankara",country:"Turkey"},{city:"Antalya",country:"Turkey"},
    {city:"Moscow",country:"Russia"},{city:"St. Petersburg",country:"Russia"},{city:"Kiev",country:"Ukraine"},
    {city:"Bucharest",country:"Romania"},{city:"Sofia",country:"Bulgaria"},{city:"Zagreb",country:"Croatia"},
    // Asia
    {city:"Beijing",country:"China"},{city:"Shanghai",country:"China"},{city:"Shenzhen",country:"China"},
    {city:"Guangzhou",country:"China"},{city:"Chengdu",country:"China"},{city:"Xi'an",country:"China"},
    {city:"Hangzhou",country:"China"},{city:"Wuhan",country:"China"},{city:"Chongqing",country:"China"},
    {city:"Taipei",country:"Taiwan"},{city:"Taichung",country:"Taiwan"},{city:"Kaohsiung",country:"Taiwan"},
    {city:"Seoul",country:"South Korea"},{city:"Busan",country:"South Korea"},{city:"Jeju",country:"South Korea"},
    {city:"Hong Kong",country:"Hong Kong"},{city:"Macau",country:"Macau"},
    {city:"Singapore",country:"Singapore"},
    {city:"Bangkok",country:"Thailand"},{city:"Chiang Mai",country:"Thailand"},{city:"Phuket",country:"Thailand"},
    {city:"Pattaya",country:"Thailand"},{city:"Hua Hin",country:"Thailand"},
    {city:"Kuala Lumpur",country:"Malaysia"},{city:"Penang",country:"Malaysia"},{city:"Johor Bahru",country:"Malaysia"},
    {city:"Bali",country:"Indonesia"},{city:"Jakarta",country:"Indonesia"},{city:"Surabaya",country:"Indonesia"},
    {city:"Yogyakarta",country:"Indonesia"},{city:"Lombok",country:"Indonesia"},
    {city:"Manila",country:"Philippines"},{city:"Cebu",country:"Philippines"},{city:"Boracay",country:"Philippines"},
    {city:"Ho Chi Minh City",country:"Vietnam"},{city:"Hanoi",country:"Vietnam"},{city:"Da Nang",country:"Vietnam"},
    {city:"Phnom Penh",country:"Cambodia"},{city:"Siem Reap",country:"Cambodia"},
    {city:"Vientiane",country:"Laos"},{city:"Luang Prabang",country:"Laos"},
    {city:"Yangon",country:"Myanmar"},{city:"Colombo",country:"Sri Lanka"},
    {city:"Mumbai",country:"India"},{city:"Delhi",country:"India"},{city:"Bangalore",country:"India"},
    {city:"Chennai",country:"India"},{city:"Kolkata",country:"India"},{city:"Hyderabad",country:"India"},
    {city:"Goa",country:"India"},{city:"Jaipur",country:"India"},{city:"Agra",country:"India"},
    {city:"Karachi",country:"Pakistan"},{city:"Lahore",country:"Pakistan"},{city:"Islamabad",country:"Pakistan"},
    {city:"Dhaka",country:"Bangladesh"},{city:"Kathmandu",country:"Nepal"},
    {city:"Islamabad",country:"Pakistan"},{city:"Colombo",country:"Sri Lanka"},
    // Middle East
    {city:"Dubai",country:"UAE"},{city:"Abu Dhabi",country:"UAE"},{city:"Sharjah",country:"UAE"},
    {city:"Doha",country:"Qatar"},{city:"Riyadh",country:"Saudi Arabia"},{city:"Jeddah",country:"Saudi Arabia"},
    {city:"Mecca",country:"Saudi Arabia"},{city:"Medina",country:"Saudi Arabia"},
    {city:"Kuwait City",country:"Kuwait"},{city:"Manama",country:"Bahrain"},
    {city:"Muscat",country:"Oman"},{city:"Beirut",country:"Lebanon"},{city:"Amman",country:"Jordan"},
    {city:"Tel Aviv",country:"Israel"},{city:"Jerusalem",country:"Israel"},
    {city:"Cairo",country:"Egypt"},{city:"Alexandria",country:"Egypt"},
    // Oceania
    {city:"Sydney",country:"Australia"},{city:"Melbourne",country:"Australia"},{city:"Brisbane",country:"Australia"},
    {city:"Perth",country:"Australia"},{city:"Adelaide",country:"Australia"},{city:"Gold Coast",country:"Australia"},
    {city:"Auckland",country:"New Zealand"},{city:"Wellington",country:"New Zealand"},{city:"Queenstown",country:"New Zealand"},
    {city:"Nadi",country:"Fiji"},
    // Africa
    {city:"Cape Town",country:"South Africa"},{city:"Johannesburg",country:"South Africa"},{city:"Durban",country:"South Africa"},
    {city:"Nairobi",country:"Kenya"},{city:"Lagos",country:"Nigeria"},{city:"Accra",country:"Ghana"},
    {city:"Casablanca",country:"Morocco"},{city:"Marrakech",country:"Morocco"},{city:"Tunis",country:"Tunisia"},
    {city:"Addis Ababa",country:"Ethiopia"},{city:"Dar es Salaam",country:"Tanzania"},
    // South America
    {city:"São Paulo",country:"Brazil"},{city:"Rio de Janeiro",country:"Brazil"},{city:"Brasília",country:"Brazil"},
    {city:"Buenos Aires",country:"Argentina"},{city:"Santiago",country:"Chile"},
    {city:"Lima",country:"Peru"},{city:"Bogotá",country:"Colombia"},{city:"Medellín",country:"Colombia"},
    {city:"Caracas",country:"Venezuela"},{city:"Montevideo",country:"Uruguay"},
    {city:"Quito",country:"Ecuador"},{city:"La Paz",country:"Bolivia"},
  ];

  // DBの自社登録都市（優先表示）— city+country キーで重複除去
  var dbCities = [];
  var dbCitySet = {};
  (allCities || []).forEach(function(c) {
    var key = (c.city || '').toLowerCase().trim() + '__' + (c.country || '').toLowerCase().trim();
    if (!dbCitySet[key]) {
      dbCitySet[key] = true;
      dbCities.push({ city: (c.city || '').trim(), country: (c.country || '').trim(), inDB: true });
    }
  });
  var dbCityKeys = new Set(dbCities.map(function(c){ return c.city.toLowerCase(); }));

  // マージ: DB都市優先 + 世界都市（重複除外）
  var worldExtras = WORLD_CITIES.filter(function(c) {
    return !dbCityKeys.has(c.city.toLowerCase());
  }).map(function(c) { return { city: c.city, country: c.country, inDB: false }; });

  var cities = dbCities.concat(worldExtras);

  // Properties the guest can search by name. Shape matches the city entries so
  // the same renderer handles both; `isHotel` only changes the badge.
  var hotelEntries = (hotelNames || []).map(function (h) {
    var where = [ (h.city || '').trim(), (h.country || '').trim() ].filter(Boolean).join(', ');
    return { city: (h.name || '').trim(), nameJa: (h.name_ja || '').trim(), country: where, inDB: true, isHotel: true };
  }).filter(function (h) { return h.city; });

  var input = document.getElementById('location-input');
  var list  = document.getElementById('location-suggestions');
  if (!input || !list) return;

  var activeIdx = -1;

  function normalize(s) {
    return (s || '').toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function highlight(text, q) {
    var safe = escHtml(text);
    if (!q) return safe;
    var re = new RegExp('(' + escHtml(q).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return safe.replace(re, '<strong class="text-teal-600">$1</strong>');
  }

  function render(items, q) {
    activeIdx = -1;
    if (!items.length) {
      list.classList.add('hidden');
      list.innerHTML = '';
      return;
    }
    list.innerHTML = items.map(function(c, i) {
      var badge = c.isHotel
        ? '<span class="text-[10px] bg-indigo-100 text-indigo-700 px-1.5 py-0.5 rounded font-semibold ml-1.5 flex-shrink-0">Hotel</span>'
        : (c.inDB
            ? '<span class="text-[10px] bg-teal-100 text-teal-700 px-1.5 py-0.5 rounded font-semibold ml-1.5 flex-shrink-0">DDH</span>'
            : '');
      return '<li class="px-4 py-2.5 cursor-pointer hover:bg-teal-50 text-gray-800 flex justify-between items-center suggestion-item" data-city="' + escHtml(c.city) + '" data-idx="' + i + '">' +
             '<span class="font-medium flex items-center">' + highlight(c.city, q) + badge + '</span>' +
             '<span class="text-gray-400 text-xs ml-2 flex-shrink-0">' + escHtml(c.country) + '</span>' +
             '</li>';
    }).join('');
    list.classList.remove('hidden');
  }

  function setActive(idx, items) {
    var lis = list.querySelectorAll('.suggestion-item');
    lis.forEach(function(li, i) {
      li.classList.toggle('bg-teal-50', i === idx);
    });
    if (lis[idx]) {
      input.value = lis[idx].dataset.city;
    }
  }

  function getMatches(q) {
    if (!q) {
      // 未入力時はDB登録都市を優先表示
      var dbTop = cities.filter(function(c){ return c.inDB; }).slice(0, 8);
      return dbTop.length >= 8 ? dbTop : dbTop.concat(cities.filter(function(c){ return !c.inDB; }).slice(0, 8 - dbTop.length));
    }
    var nq = normalize(q);
    var prefixDB = [], prefixWorld = [], containsDB = [], containsWorld = [];
    // 国名のみマッチの場合、同一国は1件のみ表示（重複防止）
    var seenCountryPrefix = {}, seenCountryContains = {};
    cities.forEach(function(c) {
      var nc = normalize(c.city), nco = normalize(c.country);
      var cityPrefix = nc.startsWith(nq);
      var countryPrefix = nco.startsWith(nq);
      var cityContains = nc.includes(nq);
      var countryContains = nco.includes(nq);
      if (cityPrefix || cityContains) {
        // 都市名マッチは全件表示
        if (cityPrefix) { c.inDB ? prefixDB.push(c) : prefixWorld.push(c); }
        else { c.inDB ? containsDB.push(c) : containsWorld.push(c); }
      } else if (countryPrefix) {
        // 国名プレフィックスマッチは国ごとに1件のみ
        if (!seenCountryPrefix[nco]) {
          seenCountryPrefix[nco] = true;
          c.inDB ? prefixDB.push(c) : prefixWorld.push(c);
        }
      } else if (countryContains) {
        // 国名部分マッチは国ごとに1件のみ
        if (!seenCountryContains[nco]) {
          seenCountryContains[nco] = true;
          c.inDB ? containsDB.push(c) : containsWorld.push(c);
        }
      }
    });
    // DB優先: prefix(DB) → prefix(world) → contains(DB) → contains(world)
    // A typed property name should surface the property itself first.
    var hotelHits = [];
    for (var hi = 0; hi < hotelEntries.length && hotelHits.length < 5; hi++) {
      var he = hotelEntries[hi];
      var hn = normalize(he.city), hj = normalize(he.nameJa);
      if (hn.startsWith(nq) || hn.includes(nq) || (hj && hj.includes(nq))) hotelHits.push(he);
    }
    return hotelHits.concat(prefixDB, prefixWorld, containsDB, containsWorld).slice(0, 10);
  }

  input.addEventListener('input', function() {
    var q = this.value.trim();
    var matches = getMatches(q);
    render(matches, normalize(q));
  });

  input.addEventListener('focus', function() {
    var q = this.value.trim();
    render(getMatches(q), normalize(q));
  });

  input.addEventListener('keydown', function(e) {
    var lis = list.querySelectorAll('.suggestion-item');
    if (!lis.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, lis.length - 1);
      setActive(activeIdx, lis);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      setActive(activeIdx, lis);
    } else if (e.key === 'Enter' && activeIdx >= 0) {
      e.preventDefault();
      input.value = lis[activeIdx].dataset.city;
      list.classList.add('hidden');
      activeIdx = -1;
    } else if (e.key === 'Escape') {
      list.classList.add('hidden');
    }
  });

  list.addEventListener('mousedown', function(e) {
    var li = e.target.closest('.suggestion-item');
    if (!li) return;
    e.preventDefault();
    input.value = li.dataset.city;
    list.classList.add('hidden');
  });

  document.addEventListener('click', function(e) {
    if (!document.getElementById('location-wrapper').contains(e.target)) {
      list.classList.add('hidden');
    }
  });
})();
</script>

<script is:inline>
  (function() {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/flatpickr';
    s.onload = function() {
      if (window.flatpickr) {
        window.flatpickr('#checkin-fp', {
          locale: (document.documentElement.lang || 'en').indexOf('ja') === 0 ? 'ja' : 'en',
          dateFormat: 'Y-m-d',
          disableMobile: true,
          allowInput: true,
        });
      }
    };
    document.head.appendChild(s);
  })();
</script>

