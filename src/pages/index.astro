<!-- Hero AI Chatbot -->
<script is:inline>
function escHtml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
(function() {
  var sessionId = 'hero_' + Math.random().toString(36).slice(2, 11);
  var pendingImageKey = null;
  var isSending = false;

  var messagesEl = document.getElementById('hero-chat-messages');
  var inputEl    = document.getElementById('hero-chat-input');
  var sendBtn    = document.getElementById('hero-chat-send');
  var uploadEl   = document.getElementById('hero-flight-upload');
  var uploadStatus = document.getElementById('hero-upload-status');
  var uploadName   = document.getElementById('hero-upload-name');

  if (!messagesEl || !inputEl || !sendBtn) return;

  // --- helpers ---
  function getFormContext() {
    var checkin  = document.getElementById('checkin-fp')?.value || '';
    var ciTime   = document.querySelector('select[name="checkin_time"]')?.value || '';
    var coTime   = document.querySelector('select[name="checkout_time"]')?.value || '';
    var guests   = document.querySelector('select[name="guests"]')?.value || '1';
    var budget   = document.querySelector('select[name="budget"]')?.value || '';
    var parts = [];
    if (checkin)  parts.push('Date: ' + checkin);
    if (ciTime)   parts.push('Check-in: ' + ciTime);
    if (coTime)   parts.push('Check-out: ' + coTime);
    if (guests)   parts.push('Guests: ' + guests);
    if (budget)   parts.push('Budget: ' + budget);
    return parts.length ? '[' + parts.join(', ') + '] ' : '';
  }

  function showMessages() {
    messagesEl.classList.remove('hidden');
  }

  // Parse hotel slugs from text (e.g. /hotel/some-slug)
  function extractHotelSlugs(text) {
    var slugs = [];
    var re = /\/hotel\/([\w-]+)/g;
    var m;
    while ((m = re.exec(text)) !== null) {
      if (!slugs.includes(m[1])) slugs.push(m[1]);
    }
    return slugs;
  }

  // Parse internal hotel cards from plain response text when metadata is missing.
  // Expected examples:
  // - Hotel Name ... From $89 ... /hotel/hotel-slug
  // - [Hotel Name](/hotel/hotel-slug)
  function extractInternalHotelsFromText(text) {
    if (!text) return [];
    var lines = String(text).split('\n');
    var hotels = [];

    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      var slugMatch = line.match(/\/hotel\/([\w-]+)/);
      if (!slugMatch) continue;

      var slug = slugMatch[1];
      if (!slug || hotels.some(function(h){ return h.slug === slug; })) continue;

      var name = '';
      var markdownName = line.match(/\[([^\]\n]{2,120})\]\(\/?hotel\/[\w-]+\)/);
      if (markdownName) {
        name = markdownName[1].trim();
      } else {
        var beforePath = line.split('/hotel/' + slug)[0] || '';
        name = beforePath
          .replace(/^\s*[-•\d\.\)\s]+/, '')
          .replace(/\*\*/g, '')
          .replace(/\|.*$/, '')
          .replace(/(?:from|From)\s*\$[\d.,]+.*$/, '')
          .replace(/[—–-]\s*$/, '')
          .trim();
      }
      if (!name) {
        name = slug.replace(/-/g, ' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); });
      }

      var price = null;
      var priceMatch = line.match(/(?:from|From)\s*\$\s*([\d.,]+)/);
      if (!priceMatch) priceMatch = line.match(/\$\s*([\d.,]+)\s*[〜~]?/);
      if (priceMatch) price = priceMatch[1];

      hotels.push({ slug: slug, name: name, min_price: price });
    }

    return hotels;
  }

  // Render text with hotel links converted to clickable cards
  function renderMsgContent(text) {
    if (!text) return '';

    // 1. BEFORE escHtml: extract Markdown links [label](url) → safe tokens
    //    Tolerant regex handles LLM variations (query params, symbols in URLs)
    var linkStore = [];
    var processed = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(_, label, url) {
      var idx = linkStore.length;
      var token = '__LINK_' + idx + '__';
      var cleanUrl = url.trim();
      var finalHref = (cleanUrl.startsWith('/') || cleanUrl.startsWith('http')) ? cleanUrl : '/' + cleanUrl;
      linkStore.push({ label: label.trim(), href: finalHref });
      return token;
    });

    // 2. Escape entire text (links protected as tokens)
    var html = escHtml(processed);

    // 3. Restore tokens to raw <a> tags from original link info
    html = html.replace(/__LINK_(\d+)__/g, function(_, idxStr) {
      var link = linkStore[parseInt(idxStr, 10)];
      if (!link) return '';
      var safeLabel = escHtml(link.label);
      var safeHref = escHtml(link.href);
      return '<a href="' + safeHref + '" target="_blank" class="underline text-amber-300 hover:text-amber-200">' + safeLabel + '</a>';
    });

    // Markdown: ### 見出し
    html = html.replace(/^### (.+)$/gm, '<strong class="block text-amber-300 text-sm mt-2">$1</strong>');
    html = html.replace(/^## (.+)$/gm, '<strong class="block text-amber-200 text-sm mt-2 mb-1">$1</strong>');
    html = html.replace(/^# (.+)$/gm, '<strong class="block text-white text-base mt-2 mb-1">$1</strong>');

    // Markdown: **太字**
    html = html.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
    // Markdown: *斜体*
    html = html.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');

    // Markdown: --- 区切り線
    html = html.replace(/^---+$/gm, '<hr class="border-white/20 my-2"/>');

    // Markdown: - リスト項目
    html = html.replace(/^[-•]\s+(.+)$/gm, '<span class="flex gap-1.5"><span class="text-amber-400 flex-shrink-0">•</span><span>$1</span></span>');

    // Bare /hotel/slug (fallback)
    html = html.replace(/(?<!href=")(\/hotel\/([\w-]+))(?!")/g,
      function(_, path, slug) {
        return '<a href="/hotel/' + slug + '" target="_blank" class="underline text-amber-300 hover:text-amber-200">' + path + '</a>';
      });

    return html;
  }

  // 外部ホテル情報をテキストから抽出（複数行対応：電話番号行から前方向にホテル名を探す）
  function extractExternalHotels(text) {
    var hotels = [];
    if (!text) return hotels;
    var lines = text.split('\n');
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      // /hotel/slug がある行（自社ホテル）は除外
      if (line.indexOf('/hotel/') !== -1) continue;
      // 電話番号を検出
      var phoneMatch = line.match(/📞\s*([\+\d][\d\s\-\(\)\.]{6,20})/) ||
                       line.match(/(\+\d[\d\s\-\(\)\.]{6,20})/);
      if (!phoneMatch) continue;
      // 電話番号の前後1行以内に /hotel/ リンクがあれば自社ホテル扱いで除外
      var nearPartner = false;
      for (var k = Math.max(0, i - 1); k <= Math.min(lines.length - 1, i + 1); k++) {
        if (lines[k].indexOf('/hotel/') !== -1) { nearPartner = true; break; }
      }
      if (nearPartner) continue;
      var phone = phoneMatch[1].trim();
      // 現在行 + 前方8行以内でホテル名を探す
      var name = '';
      for (var j = i; j >= Math.max(0, i - 8); j--) {
        var checkLine = lines[j];
        if (checkLine.indexOf('/hotel/') !== -1) break; // 自社ホテル行に当たったら中断
        // 住所行・電話行・記号のみの行はスキップ
        if (checkLine.indexOf('📍') !== -1) continue;
        if (checkLine.indexOf('📞') !== -1 && j !== i) continue;
        var stripped = checkLine.replace(/^\s*[-•]\s*/, '').trim();
        if (!stripped) continue;
        // 1. 太字パターン **Name**
        var m = checkLine.match(/\*\*([^*]{2,80})\*\*/);
        if (m) {
          var c1 = m[1].trim();
          if (c1.length >= 2 && !/^\d+\s*[,\s]/.test(c1)) {
            name = c1; break;
          }
        }
        // 2. 番号付きリスト "4. NOBO - Hotel in old Tbilisi"（値段・評価が続いても可）
        m = checkLine.match(/^\s*\d+\.\s+(.+?)(?:\s*[|｜]|\s*[⭐★]|\s*📍|\s*📞|\s*\+|$)/);
        if (m) {
          var c2 = m[1].replace(/\s*-+\s*From\s+\$[\d.,]+.*$/i, '').replace(/\s*[|｜].*$/, '').replace(/\s*[⭐★].*$/, '').trim();
          if (c2.length >= 2 && !/^\d+\s*[,\s]/.test(c2)) {
            name = c2; break;
          }
        }
        // 3. bullet "- Name" / "• Name"
        m = checkLine.match(/^\s*[-•]\s+([^📍📞|｜⭐★]{2,80}?)\s*(?:[|｜⭐★]|$)/);
        if (m) {
          var c3 = m[1].trim();
          if (c3.length >= 2 && !/^\d+\s*[,\s]/.test(c3)) {
            name = c3; break;
          }
        }
        // 4. 装飾なしの平文行 "Here We Go Bangkok | ⭐4.7"
        m = checkLine.match(/^\s*([A-Za-z][^|｜⭐★📍📞\n]{1,80}?)\s*(?:[|｜⭐★]|$)/);
        if (m) {
          var c4 = m[1].trim();
          if (c4.length >= 2 && !/^\d+\s*[,\s]/.test(c4)) {
            name = c4; break;
          }
        }
      }
      if (!name || name.length < 2) continue;
      // 重複チェック（電話番号で重複判定。同一番号は1件のみ）
      if (!hotels.some(function(h){ return h.phone === phone; })) {
        hotels.push({ name: name, phone: phone });
      }
    }
    return hotels;
  }

  function addMsg(text, role, metadata) {
    showMessages();
    var wrap = document.createElement('div');
    wrap.className = 'flex gap-2' + (role === 'user' ? ' flex-row-reverse' : '');
    if (role === 'assistant') {
      var _metaHotels = (metadata && Array.isArray(metadata.hotels) && metadata.hotels.length > 0) ? metadata.hotels : null;
      var _internalMeta = _metaHotels ? _metaHotels.filter(function(h){ return h.source === 'internal'; }) : null;
      var _externalMeta = _metaHotels ? _metaHotels.filter(function(h){ return h.source === 'external'; }) : null;

      var internalHotels = (_internalMeta && _internalMeta.length > 0)
        ? _internalMeta.map(function(h){ return { slug: h.slug, name: h.name, min_price: h.min_price }; }).filter(function(h){ return h.slug; })
        : extractInternalHotelsFromText(text);

      var externalHotels = (_externalMeta && _externalMeta.length > 0)
        ? _externalMeta.map(function(h){ return { name: h.name || '', phone: h.phone || '', distance_km: h.distance_km }; })
        : extractExternalHotels(text);

      var pageLocale = (document.documentElement.lang || 'en').indexOf('ja') === 0 ? 'ja' : 'en';
      var internalCards = internalHotels.map(function(h) {
        var label = escHtml(h.name || '');
        var detailPath = '/hotel/' + h.slug;
        var price = (h.min_price != null && h.min_price !== '') ? ('USD ' + h.min_price + '〜') : (pageLocale === 'ja' ? '未設定' : 'N/A');
        return '<a href="' + detailPath + '" target="_blank" rel="noopener" class="block bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg px-3 py-2 transition-colors">' +
          '<p class="text-sky-300 text-xs font-bold break-words leading-relaxed">' + label + '</p>' +
          '<p class="text-white/85 text-xs mt-1">' + (pageLocale === 'ja' ? '料金' : 'Min price') + ': <span class="font-semibold text-white">' + escHtml(price) + '</span></p>' +
          '<p class="text-teal-300 text-[11px] mt-1">' + (pageLocale === 'ja' ? '詳細を見る（新しいタブ） →' : 'View details (new tab) →') + '</p>' +
        '</a>';
      }).join('');

      var callBtns = '';
      var validExternal = externalHotels.filter(function(h){ return h.name && h.name.length >= 2; });
      if (validExternal.length > 0) {
        var top3 = validExternal.slice(0, 3);
        window._heroExternalHotels = top3;
        var items = top3.map(function(h, i) {
          var safeName = (h.name || '').replace(/"/g, '&quot;').slice(0, 60);
          var safePhone = (h.phone || '').replace(/"/g, '');
          var dist = (h.distance_km != null)
            ? '<span class="text-teal-300 text-[11px] ml-1.5">' + (pageLocale === 'ja' ? '約' : '') + h.distance_km + 'km' + (pageLocale === 'ja' ? '' : ' away') + '</span>'
            : '';
          return '<label class="flex items-start gap-2 p-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 cursor-pointer transition-colors">' +
            '<input type="checkbox" class="hero-ext-hotel-cb mt-0.5 accent-amber-400" data-name="' + safeName + '" data-phone="' + safePhone + '" checked />' +
            '<span class="flex-1 text-xs text-white/90">' +
              '<span class="font-semibold block">' + safeName + '</span>' +
              '<span class="text-white/50 text-[11px]">' + safePhone + '</span>' + dist +
            '</span>' +
          '</label>';
        }).join('');
        callBtns =
          '<div class="mt-2 space-y-1.5">' +
            '<p class="text-[11px] text-white/60 mb-1">📞 The AI calls the hotel to check availability and price — free. A $7 booking fee applies only when you accept the quote.</p>' +
            items +
            '<button onclick="window._heroCallBook(this)" class="mt-1 w-full flex items-center justify-center gap-1.5 bg-blue-500 hover:bg-blue-400 text-white text-xs font-bold px-3 py-2 rounded-lg transition-colors">' +
              '📞 Get a price by phone (free)' +
            '</button>' +
          '</div>';
      }

      var hasCardHotels = internalHotels.length > 0;
      var assistantBody = hasCardHotels
        ? ''
        : '<div class="whitespace-pre-wrap leading-relaxed">' + renderMsgContent(text) + '</div>';
      var usdNote = internalCards
        ? '<p class="text-[11px] text-white/60 mt-2">' + (pageLocale === 'ja' ? '💳 表示はUSD価格・お支払いもUSDで処理されます。' : '💳 Prices are in USD and payments are processed in USD.') + '</p>'
        : '';
      var hotelCards = internalCards ? usdNote + '<div class="grid gap-2 mt-1">' + internalCards + '</div>' : '';

      wrap.innerHTML =
        '<div class="w-6 h-6 bg-white/20 rounded-full flex-shrink-0 flex items-center justify-center text-white text-[10px] font-bold mt-0.5">AI</div>' +
