// Region mapping (country → region)


// City-level overrides for edge cases (empty country, etc.)

// City name aliases: merge these cities into a canonical name
const cityAliases: Record<string, string> = {
  'Auckland Central': 'Auckland',
  'Abuja (F.c.t.)': 'Abuja',
  'Bang Rak': 'Bangkok',
  'Candidasa': 'Bali',
  'Kubutambahan': 'Bali',
  'Cebu City': 'Cebu',
  'Cebu city': 'Cebu',
};

// Apply aliases and merge hotel counts
const cityMap: Record<string, any> = {};
for (const city of allCities) {
  const canonicalName = cityAliases[city.city] || city.city;
  // 国名を正規化（大文字小文字を統一）してキーを作成
  const normalizedCountry = (city.country || '').toLowerCase();
  const key = `${canonicalName}__${normalizedCountry}`;
  if (cityMap[key]) {
    cityMap[key].hotel_count = (cityMap[key].hotel_count || 0) + (city.hotel_count || 0);
  } else {
    cityMap[key] = { ...city, city: canonicalName };
  }
}
const mergedCities = Object.values(cityMap);

// Normalize country lookup (case-insensitive)

// Group cities by region (fallback: check if country name appears in city name)
const citiesByRegion: Record<string, any[]> = {};
for (const city of mergedCities) {
  let region = cityRegionOverride[city.city] || getRegionForCountry(city.country);
  // Fallback: scan all country keys to see if city string contains a known country
  if (!region) {
    for (const [country, r] of Object.entries(countryRegion)) {
      if (city.city?.includes(country) || city.country?.includes(country)) {
        region = r;
        break;
      }
    }
  }
  region = region || 'Other';
  if (!citiesByRegion[region]) citiesByRegion[region] = [];
  citiesByRegion[region].push(city);
}
// Sort each region's cities: group by country (alphabetical), then by hotel_count desc within country
for (const region of Object.keys(citiesByRegion)) {
  citiesByRegion[region].sort((a: any, b: any) => {
    const cmp = (a.country || '').localeCompare(b.country || '');
    if (cmp !== 0) return cmp;
    return b.hotel_count - a.hotel_count;
  });
}
const availableRegions = regionOrder.filter(r => citiesByRegion[r]?.length > 0);
// 'Other' は表示しない

// Region hero images for the drill-down cards

// Region → Country → City drill-down data (cities within a country are already sorted by hotel_count desc)
const geoDrillData = availableRegions.map((region) => {
  const cities = citiesByRegion[region] as any[];
  const byCountry: Record<string, any[]> = {};
  for (const c of cities) {
    const key = c.country || 'Other';
    if (!byCountry[key]) byCountry[key] = [];
    byCountry[key].push(c);
  }
  const countries = Object.entries(byCountry).map(([country, cs]) => ({
    country,
    countryLabel: geoL(country),
    image: getCityImage(cs[0].city),
    hotelCount: cs.reduce((s, c) => s + (c.hotel_count || 0), 0),
    cityCount: cs.length,
    cities: cs.map((c) => ({
      cityLabel: geoL(c.city),
      countText: isJa ? `${c.hotel_count}軒` : `${c.hotel_count} ${c.hotel_count === 1 ? 'hotel' : 'hotels'}`,
      image: getCityImage(c.city),
      href: `/city/${c.city.toLowerCase().replace(/\s+/g, '-')}`,
    })),
  })).sort((a, b) => b.hotelCount - a.hotelCount);
  return {
    region,
    regionLabel: isJa ? (REGION_JA[region] || region) : region,
    image: REGION_IMAGES[region] || 'https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=600&q=80&fm=webp',
    hotelCount: countries.reduce((s, c) => s + c.hotelCount, 0),
    countryCount: countries.length,
    countries,
  };
});

// Unique city count
const uniqueCityCount = new Set(mergedCities.map((c: any) => c.city)).size || 85;
