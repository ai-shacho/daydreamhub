    <div id="hero-slide-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" data-bg="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=1600&q=80&fm=webp"></div>
    <div class="absolute inset-0 bg-teal-900/80"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 py-16 w-full">
      <div class="text-center text-white mb-8">
        <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4">{isJa ? <>時間単位で泊まれるホテル。世界{uniqueCityCount}+都市。</> : <>Hotels by the Hour. {uniqueCityCount}+ Cities Worldwide.</>}</h1>
        <p class="text-lg md:text-xl text-teal-100 max-w-3xl mx-auto mb-6">The day-use hotel booking platform<br class="hidden md:block"/> — find short-stay plans for work, rest, or transit.</p>
        <div class="flex flex-wrap justify-center gap-3 mb-8">
          <span class="bg-white/15 backdrop-blur-sm border border-white/20 text-white text-sm font-medium px-4 py-1.5 rounded-full">{isJa ? '1時間から利用OK' : 'From 1 hour'}</span>
          <span class="bg-white/15 backdrop-blur-sm border border-white/20 text-white text-sm font-medium px-4 py-1.5 rounded-full">{isJa ? '宿泊の約半額' : 'Half the overnight price'}</span>
          <span class="bg-white/15 backdrop-blur-sm border border-white/20 text-white text-sm font-medium px-4 py-1.5 rounded-full">{isJa ? 'AIで即検索' : 'AI instant search'}</span>
        </div>
      </div>

      <!-- Search Bar (Agoda-style) -->
      <div class="max-w-4xl mx-auto">
        <!-- Mode tabs: AI Concierge (flagship, default) / Filter search -->
        <div class="flex justify-center mb-4">
          <div class="inline-flex bg-white/15 backdrop-blur-sm border border-white/20 rounded-full p-1 gap-1">
            <button type="button" id="tab-ai"
              class="hero-tab px-5 py-2 rounded-full text-sm font-bold transition-colors flex items-center gap-2 bg-amber-500 text-white shadow">
              <span class="inline-block w-2 h-2 rounded-full bg-green-300 animate-pulse"></span>
              ✨ {isJa ? 'AIコンシェルジュ' : 'AI Concierge'}
            </button>
            <button type="button" id="tab-search"
              class="hero-tab px-5 py-2 rounded-full text-sm font-bold transition-colors flex items-center gap-2 text-white/90 hover:bg-white/10">
              🔍 {isJa ? '条件で検索' : 'Search by filters'}
            </button>
          </div>
        </div>

        <div id="search-panel" class="hidden">
        <form action="/search" method="get" onsubmit="event.preventDefault(); window._heroNormalSearch();"
          class="bg-white rounded-2xl md:rounded-full shadow-xl p-2 flex flex-col md:flex-row md:items-center gap-2 md:gap-0">
          <!-- Location -->
          <div class="relative flex-1 min-w-0 px-4 py-1.5 md:border-r md:border-gray-200" id="location-wrapper">
            <label class="block text-[11px] text-gray-500 font-semibold">{isJa ? '場所' : 'Where'}</label>
            <input type="text" name="location" id="location-input" placeholder={isJa ? '都市名・国名・ホテル名' : 'City, country, or hotel name'} autocomplete="off"
              class="w-full bg-transparent text-sm font-medium text-gray-800 placeholder-gray-400 focus:outline-none" />
            <ul id="location-suggestions"
              class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-gray-200 rounded-lg shadow-lg z-50 max-h-60 overflow-y-auto text-sm">
            </ul>
          </div>
          <!-- Date -->
          <div class="px-4 py-1.5 md:w-40 md:border-r md:border-gray-200">
            <label class="block text-[11px] text-gray-500 font-semibold">{isJa ? '日付' : 'Date'}</label>
            <input type="text" name="checkin" id="checkin-fp" placeholder="YYYY-MM-DD" autocomplete="off"
              class="w-full bg-transparent text-sm font-medium text-gray-800 placeholder-gray-400 focus:outline-none" />
          </div>
          <!-- Time range -->
          <div class="px-4 py-1.5 md:w-48 md:border-r md:border-gray-200">
            <label class="block text-[11px] text-gray-500 font-semibold">{isJa ? '利用時間' : 'Time'}</label>
            <div class="flex items-center gap-1">
              <select name="checkin_time" class="bg-transparent text-sm font-medium text-gray-800 focus:outline-none cursor-pointer">
                {HOURS.map(t => (
                  <option value={t} selected={t === '10:00'}>{t}</option>
                ))}
              </select>
              <span class="text-gray-400 text-sm">〜</span>
              <select name="checkout_time" class="bg-transparent text-sm font-medium text-gray-800 focus:outline-none cursor-pointer">
                {HOURS.map(t => (
                  <option value={t} selected={t === '18:00'}>{t}</option>
                ))}
              </select>
            </div>
          </div>
          <!-- Guests -->
          <div class="px-4 py-1.5 md:w-28">
            <label class="block text-[11px] text-gray-500 font-semibold">{isJa ? '人数' : 'Guests'}</label>
            <select name="guests" class="w-full bg-transparent text-sm font-medium text-gray-800 focus:outline-none cursor-pointer">
              {[1, 2, 3, 4, 5].map(n => (
                <option value={n}>{isJa ? `${n === 5 ? '5+' : n}名` : `${n === 5 ? '5+' : n} ${n === 1 ? 'guest' : 'guests'}`}</option>
              ))}
            </select>
          </div>
          <!-- Search button -->
          <div class="p-1 md:pl-2 flex-shrink-0">
            <button type="submit"
              class="w-full md:w-auto bg-amber-500 hover:bg-amber-400 text-white font-bold text-base px-8 py-3 rounded-xl md:rounded-full transition-colors flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              {isJa ? '検索' : 'Search'}
            </button>
          </div>
        </form>

        <!-- Sub actions: advanced filters -->
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button type="button" id="toggle-advanced"
            class="text-xs text-white/80 hover:text-white border border-white/30 hover:border-white/60 rounded-full px-3 py-1.5 transition-colors bg-white/10 hover:bg-white/20">
            {isJa ? '＋ 詳細条件（目的・予算）' : '+ More filters (purpose / budget)'}
          </button>
        </div>

        <!-- Advanced filters (hidden by default) -->
        <div id="advanced-panel" class="hidden mt-3 bg-white/95 backdrop-blur-sm rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl">
          <div>
            <label class="block text-xs text-gray-600 mb-1 font-semibold">{isJa ? '目的' : 'Speciality'}</label>
            <select name="speciality" class="w-full rounded-lg px-3 py-2.5 text-sm bg-white border border-gray-200 text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400">
              <option value="">{isJa ? 'すべて' : 'All Types'}</option>
              {specialities.filter(s => s.value).map(s => (
                <option value={s.value}>{s.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-600 mb-1 font-semibold">{isJa ? '予算' : 'Budget'}</label>
            <select name="budget" class="w-full rounded-lg px-3 py-2.5 text-sm bg-white border border-gray-200 text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400">
              <option value="">{isJa ? '指定なし' : 'Any Budget'}</option>
              <option value="budget">{isJa ? '節約（$30未満）' : 'Budget (under $30)'}</option>
              <option value="mid">{isJa ? 'ミドル（$30–$100）' : 'Mid-range ($30–$100)'}</option>
              <option value="premium">{isJa ? 'プレミアム（$100+）' : 'Premium ($100+)'}</option>
            </select>
          </div>
        </div>

        </div><!-- /search-panel -->

        <!-- AI Concierge (flagship, default visible) -->
        <div id="ai-chat-wrapper">
          <p class="text-center text-white/90 text-sm mb-3">{isJa ? '行き先を送るだけで、AIがあなたにぴったりのデイユースプランを提案します' : 'Just tell the AI where you are going — it finds the perfect day-use plan for you'}</p>
          <!-- AI Messages (hidden until chat starts) -->
          <div id="hero-chat-messages" class="hidden bg-gray-900/75 backdrop-blur-sm border border-white/20 rounded-xl p-4 mb-3 space-y-3 max-h-[480px] overflow-y-auto">
            <!-- messages injected here -->
          </div>

          <!-- AI Input Row -->
          <div class="bg-white border-2 border-amber-400 shadow-xl shadow-amber-500/30 rounded-2xl p-3 md:p-4 flex items-center gap-2 focus-within:ring-4 focus-within:ring-amber-400/40 transition-all">
            <!-- Upload flight photo -->
            <label for="hero-flight-upload" class="flex-shrink-0 cursor-pointer text-gray-400 hover:text-amber-500 transition-colors p-1.5 rounded-lg hover:bg-amber-50" title={isJa ? '航空券の写真をアップロード' : 'Upload flight photo'}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <input type="file" id="hero-flight-upload" accept="image/*" class="hidden" />
            </label>

            <!-- Upload status -->
            <span id="hero-upload-status" class="hidden text-xs text-amber-500 flex-shrink-0">{isJa ? 'アップロード中…' : 'Uploading...'}</span>
            <span id="hero-upload-name" class="hidden text-xs text-teal-600 flex-shrink-0 max-w-[80px] truncate"></span>

            <!-- Text input -->
            <input
              type="text"
              id="hero-chat-input"
              placeholder={isJa ? '例: バンコク、ドバイ、クアラルンプール' : 'e.g. Bangkok, Dubai, Kuala Lumpur, Nairobi'}
              class="flex-1 bg-transparent text-gray-800 placeholder-gray-400 text-sm md:text-base focus:outline-none font-medium"
              maxlength="300"
            />

            <!-- Send button -->
            <button
              id="hero-chat-send"
              class="flex-shrink-0 bg-amber-500 hover:bg-amber-400 disabled:opacity-40 text-white font-bold text-sm md:text-base px-5 py-2.5 rounded-xl transition-colors flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
              </svg>
              Send
            </button>
          </div>

          <!-- Airport Shortcuts -->
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="text-white font-semibold text-xs">{isJa ? '✈️ いまここ:' : "✈️ I'm at:"}</span>
            {[
              { label: isJa ? 'ドバイ(DXB)' : 'Dubai(DXB)', city: 'Dubai', airport: 'I need a hotel near Dubai International Airport Dubai' },
              { label: isJa ? 'バンコク(BKK)' : 'Bangkok(BKK)', city: 'Bangkok', airport: 'I need a hotel near Suvarnabhumi Airport Bangkok' },
              { label: isJa ? 'クアラルンプール(KUL)' : 'Kuala Lumpur(KUL)', city: 'Kuala Lumpur', airport: 'I need a hotel near Kuala Lumpur International Airport Kuala Lumpur' },
              { label: isJa ? 'ナイロビ(NBO)' : 'Nairobi(NBO)', city: 'Nairobi', airport: 'I need a hotel near Jomo Kenyatta Airport Nairobi' },
              { label: isJa ? 'ドーハ(DOH)' : 'Doha(DOH)', city: 'Doha', airport: 'I need a hotel near Hamad International Airport Doha' },
              { label: isJa ? 'バーミンガム(BHX)' : 'Birmingham(BHX)', city: 'Birmingham', airport: 'I need a hotel near Birmingham Airport Birmingham' },
            ].map(airport => (
              <button
                type="button"
                data-airport={airport.airport}
                class="text-xs text-white/80 hover:text-white border border-white/30 hover:border-white/60 rounded-full px-3 py-1 transition-colors bg-white/10 hover:bg-white/20">
                {airport.label}
              </button>
            ))}
          </div>
        </div>

        <script is:inline>
          (function() {
            // Advanced filters toggle (inside filter-search panel)
            var advBtn = document.getElementById('toggle-advanced');
            var advPanel = document.getElementById('advanced-panel');
            if (advBtn && advPanel) {
              advBtn.addEventListener('click', function() {
                advPanel.classList.toggle('hidden');
              });
            }

            // Hero mode tabs: AI concierge <-> filter search
            var tabAi = document.getElementById('tab-ai');
            var tabSearch = document.getElementById('tab-search');
            var aiPanel = document.getElementById('ai-chat-wrapper');
            var searchPanel = document.getElementById('search-panel');
            if (!tabAi || !tabSearch || !aiPanel || !searchPanel) return;

            var ACTIVE = ['bg-amber-500', 'text-white', 'shadow'];
            var INACTIVE = ['text-white/90', 'hover:bg-white/10'];

            function setTab(mode) {
              var showAi = mode === 'ai';
              aiPanel.classList.toggle('hidden', !showAi);
              searchPanel.classList.toggle('hidden', showAi);
              [[tabAi, showAi], [tabSearch, !showAi]].forEach(function(pair) {
                var btn = pair[0], on = pair[1];
                ACTIVE.forEach(function(c) { btn.classList.toggle(c, on); });
                INACTIVE.forEach(function(c) { btn.classList.toggle(c, !on); });
              });
              var inp = showAi ? document.getElementById('hero-chat-input') : document.getElementById('location-input');
              if (inp) inp.focus();
            }

            tabAi.addEventListener('click', function() { setTab('ai'); });
            tabSearch.addEventListener('click', function() { setTab('search'); });
          })();
        </script>

        <!-- Stats inline -->
        <div class="flex items-center justify-center gap-8 mt-5 text-white/80 text-base md:text-lg">
          <span><strong class="text-white font-extrabold text-2xl md:text-3xl">{totalHotels || '350'}+</strong> Day-Use Hotels</span>
          <span class="text-white/40 text-xl">|</span>
          <span><strong class="text-white font-extrabold text-2xl md:text-3xl">{uniqueCityCount}+</strong> Cities</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Search by City (Region → Country → City drill-down) -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-800 mb-2">{isJa ? '都市から探す' : 'Search by City'}</h2>
      <p class="text-sm text-gray-500 mb-6">{isJa ? '地域 → 国 → 都市の順に絞り込めます' : 'Pick a region, then a country, then a city'}</p>

      <!-- Breadcrumb (hidden on top level) -->
      <div id="geo-breadcrumb" class="hidden items-center flex-wrap gap-1.5 mb-5 text-sm"></div>

      <!-- Level 1: regions (SSR) -->
      <div id="geo-regions" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4">
        {geoDrillData.map((r, i) => (
          <button type="button" data-region-idx={i}
            class="geo-region-card group relative rounded-xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-lg transition-shadow text-left cursor-pointer">
            <img src={r.image} alt={r.regionLabel} class="ddh-card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/5"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3">
              <h3 class="text-white font-semibold text-base">{r.regionLabel}</h3>
              <p class="text-white/70 text-xs">{isJa ? `${r.countryCount}カ国・${r.hotelCount}軒` : `${r.countryCount} ${r.countryCount === 1 ? 'country' : 'countries'} · ${r.hotelCount} hotels`}</p>
            </div>
          </button>
        ))}
      </div>

      <!-- Levels 2 & 3: countries / cities, rendered by JS -->
      <div id="geo-dynamic" class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4"></div>

      <script define:vars={{ geoDrillData, geoText: {
        all: isJa ? 'すべての地域' : 'All regions',
        back: isJa ? '← 戻る' : '← Back',
        countrySub: isJa ? '{c}都市・{h}軒' : '{c} {cw} · {h} hotels',
      } }}>
        window.__GEO_DATA__ = geoDrillData;
        window.__GEO_TEXT__ = geoText;
      </script>
    </div>
  </section>

  <!-- Browse by Speciality -->
  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">{isJa ? '目的から探す' : 'Browse by Speciality'}</h2>
      <p class="text-sm text-gray-500 mb-6">{isJa ? '理想の過ごし方から選べます' : 'Choose your ideal stay experience'}</p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {specialityCards.map(s => (
          <a href={`/search?speciality=${s.value}`}
            class="group relative rounded-2xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-lg transition-shadow">
            <img src={s.img} alt={s.label}
              class="ddh-card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/5"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="font-bold text-white text-sm leading-tight">{s.label}</p>
              <p class="text-xs text-white/80 mt-0.5">{s.desc}</p>
            </div>
          </a>
        ))}
        <a href="/search"
          class="group relative rounded-2xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-lg transition-shadow bg-gradient-to-br from-teal-600 to-cyan-700 flex flex-col items-center justify-center text-white">
          <svg class="w-7 h-7 mb-2 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <p class="font-bold text-sm">{isJa ? 'すべて見る' : 'See all'}</p>
          <p class="text-xs text-white/80 mt-0.5">{isJa ? '条件を指定して検索' : 'Search with filters'}</p>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var data = window.__GEO_DATA__ || [];
      var T = window.__GEO_TEXT__ || {};
      var regionsEl = document.getElementById('geo-regions');
      var dynEl = document.getElementById('geo-dynamic');
      var bcEl = document.getElementById('geo-breadcrumb');
      if (!regionsEl || !dynEl || !bcEl) return;

      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
      }

      function cardInner(img, alt, title, sub) {
        return '<img src="' + esc(img) + '" alt="' + esc(alt) + '" class="ddh-card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />' +
          '<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/5"></div>' +
          '<div class="absolute bottom-0 left-0 right-0 p-3">' +
            '<h3 class="text-white font-semibold text-sm">' + esc(title) + '</h3>' +
            '<p class="text-white/70 text-xs">' + esc(sub) + '</p>' +
          '</div>';
      }

      function setBreadcrumb(parts) {
        bcEl.innerHTML = '';
        if (!parts.length) {
          bcEl.classList.add('hidden');
          bcEl.classList.remove('flex');
          return;
        }
        bcEl.classList.remove('hidden');
        bcEl.classList.add('flex');
        parts.forEach(function(p, i) {
          if (i > 0) {
            var sep = document.createElement('span');
            sep.className = 'text-gray-400';
            sep.textContent = '›';
            bcEl.appendChild(sep);
          }
          if (p.onClick) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'text-teal-600 hover:text-teal-700 hover:underline font-medium cursor-pointer';
            b.textContent = p.label;
            b.addEventListener('click', p.onClick);
            bcEl.appendChild(b);
          } else {
            var s = document.createElement('span');
            s.className = 'text-gray-700 font-semibold';
            s.textContent = p.label;
            bcEl.appendChild(s);
          }
        });
      }

      function showRegions() {
        dynEl.classList.add('hidden');
        dynEl.innerHTML = '';
        regionsEl.classList.remove('hidden');
        setBreadcrumb([]);
      }

      function countrySubText(c) {
        return (T.countrySub || '{c} {cw} · {h} hotels')
          .replace('{c}', c.cityCount)
          .replace('{cw}', c.cityCount === 1 ? 'city' : 'cities')
          .replace('{h}', c.hotelCount);
      }

      function showCountries(ri) {
        var r = data[ri];
        if (!r) return;
        regionsEl.classList.add('hidden');
        dynEl.classList.remove('hidden');
        dynEl.innerHTML = '';
        r.countries.forEach(function(c, ci) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'group relative rounded-xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-lg transition-shadow text-left cursor-pointer';
          b.innerHTML = cardInner(c.image, c.countryLabel, c.countryLabel, countrySubText(c));
          b.addEventListener('click', function() { showCities(ri, ci); });
          dynEl.appendChild(b);
        });
        setBreadcrumb([
          { label: T.all || 'All regions', onClick: showRegions },
          { label: r.regionLabel, onClick: null },
        ]);
      }

      function showCities(ri, ci) {
        var r = data[ri];
        var c = r && r.countries[ci];
        if (!c) return;
        regionsEl.classList.add('hidden');
        dynEl.classList.remove('hidden');
        dynEl.innerHTML = '';
        c.cities.forEach(function(city) {
          var a = document.createElement('a');
          a.href = city.href;
          a.className = 'group relative rounded-xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-lg transition-shadow';
          a.innerHTML = cardInner(city.image, city.cityLabel, city.cityLabel, city.countText);
          dynEl.appendChild(a);
        });
        setBreadcrumb([
          { label: T.all || 'All regions', onClick: showRegions },
          { label: r.regionLabel, onClick: function() { showCountries(ri); } },
          { label: c.countryLabel, onClick: null },
        ]);
      }

      document.querySelectorAll('.geo-region-card').forEach(function(btn) {
        btn.addEventListener('click', function() {
          showCountries(parseInt(btn.getAttribute('data-region-idx'), 10));
        });
      });
    })();
  </script>

  <!-- Search by Room Type -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-800 mb-2">{isJa ? '施設タイプから探す' : 'Search by Room Type'}</h2>
      <p class="text-sm text-gray-500 mb-6">{isJa ? 'ぴったりの施設スタイルを見つけましょう' : 'Find the perfect accommodation style'}</p>

