  /* Stock photography arrives in wildly different grades; a light, uniform
     correction stops the card rows from looking like a clip-art collage. */
  .ddh-card-img { filter: saturate(0.92) contrast(1.06) brightness(0.97); }
  /* Captions sit on photos we do not control — the scrim does most of the
     work, this covers the brightest edge cases. */
  .group .absolute h3, .group .absolute p { text-shadow: 0 1px 3px rgba(0,0,0,.45); }
</style>
