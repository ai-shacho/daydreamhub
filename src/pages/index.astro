<script is:inline define:vars={{ allCities, hotelNames }}>
(function() {
  // 世界のメジャー都市（DB未登録でも検索可能にする）
  var WORLD_CITIES = [
    // North America
    {city:"New York",country:"USA"},{city:"Los Angeles",country:"USA"},{city:"Chicago",country:"USA"},
    {city:"Houston",country:"USA"},{city:"Phoenix",country:"USA"},{city:"Philadelphia",country:"USA"},
