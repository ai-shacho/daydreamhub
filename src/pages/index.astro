  // --- send message ---
  // --- guided conversation state: concierge asks one time-question before searching ---
  var pendingLocationMsg = null;
  var askedTimeQuestion = false;
  var conversationStarted = false;

  function mentionsTimeOrPurpose(t) {
    return /(\d{1,2}\s*[:時]|時間|時から|午前|午後|朝|昼|夜|深夜|おまかせ|お任せ|仕事|休憩|デート|乗継|トランジット|hour|hrs?\b|am\b|pm\b|morning|afternoon|evening|night|anytime|whenever|work|rest|transit|layover)/i.test(t);
  }

  async function sendMessage() {
    var text = inputEl.value.trim();
    if (!text || isSending) return;

    var isJaChat = (document.documentElement.lang || 'en').indexOf('ja') === 0;

    // Step 1: first message looks like just a destination → concierge asks for the time (no API call)
    if (!conversationStarted && !askedTimeQuestion && pendingLocationMsg === null && !mentionsTimeOrPurpose(text) && text.length <= 60) {
      inputEl.value = '';
      addMsg(text, 'user');
      pendingLocationMsg = text;
      askedTimeQuestion = true;
      setTimeout(function() {
        addMsg(
          isJaChat
            ? 'ありがとうございます！😊\n**何時ごろから、何時間くらい**のご利用ですか？\n（例:「14時から3時間」／「おまかせ」でもOKです）'
            : 'Great! 😊\nAround **what time and for how many hours** will you use it?\n(e.g. "from 2pm for 3 hours" — or just say "anytime")',
          'assistant'
        );
        inputEl.placeholder = isJaChat ? '例: 14時から3時間／おまかせ' : 'e.g. from 2pm for 3 hours / anytime';
        inputEl.focus();
      }, 350);
      return;
    }

    isSending = true;
    sendBtn.disabled = true;
    inputEl.value = '';

    heroAskForPosition();

    var ctx = getFormContext();
    // Step 2: combine the stored destination with the time answer into one search request
    var userQuery = text;
    if (pendingLocationMsg !== null) {
      userQuery = isJaChat
        ? pendingLocationMsg + ' で、利用時間は「' + text + '」でホテルを探して'
        : 'Find day-use hotels in ' + pendingLocationMsg + ', usage time: ' + text;
      pendingLocationMsg = null;
    }
    var fullMsg = ctx + userQuery;
    conversationStarted = true;
    addMsg(text, 'user');
    addTyping();

    try {
      var pageLoc = (document.documentElement.lang || 'en').indexOf('ja') === 0 ? 'ja' : 'en';
      var body = { session_id: sessionId, message: fullMsg, locale: pageLoc };
      // Order the hotels we offer to ring by how close they are. Cloudflare
      // already gives the server a city-level guess, so this only sharpens it;
      // a refusal or a slow fix costs nothing.
      if (window._heroGeo) { body.lat = window._heroGeo.lat; body.lng = window._heroGeo.lng; }
      if (pendingImageKey) { body.image_key = pendingImageKey; pendingImageKey = null; }

      var res = await fetch('/api/concierge/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      var rawText = await res.text();
      var data;
      try { data = JSON.parse(rawText); } catch (parseErr) {
        removeTyping();
        addMsg('⚠️ Server error (HTTP ' + res.status + '). Please try again in a moment. [' + String(rawText || '').replace(/<[^>]+>/g, ' ').trim().slice(0, 160) + ']', 'assistant');
        return;
      }
      removeTyping();
      addMsg(data.response || data.reply || data.message || (data.error ? '⚠️ ' + data.error : 'Sorry, something went wrong. Please try again.'), 'assistant', data.metadata);

      // 電話発信中なら自動ポーリング開始
      if (data.message_type === 'call_status' && data.metadata?.call_status === 'calling') {
        var callId = data.metadata.call_id;
        window._startCallPolling(callId, sessionId, 'en');
      }

      // Clear upload badge
      uploadName.classList.add('hidden');
      uploadStatus.classList.add('hidden');
    } catch (e) {
      removeTyping();
      addMsg('⚠️ Network error: ' + (e && e.message ? e.message : 'connection failed') + ' — please try again.', 'assistant');
    } finally {
      isSending = false;
      sendBtn.disabled = false;
      inputEl.focus();
    }
  }

  sendBtn.addEventListener('click', sendMessage);
  inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); sendMessage(); }
  });

