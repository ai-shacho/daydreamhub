---
// Mobile PWA: "find a day-use hotel right now".
// Light travel-app visual language (white surfaces, teal brand accent, photo
// area tiles). Two screens: a launcher home and a full-screen map results view
// with a draggable bottom sheet (Google Maps / Airbnb pattern).
import { resolvePayPalConfig } from '../lib/paypal';

const acceptLang = Astro.request.headers.get('accept-language') || '';
const urlLang = Astro.url.searchParams.get('lang');
const isJa = urlLang ? urlLang === 'ja' : /(^|,)\s*ja/i.test(acceptLang);
// Same GA4 property as the main site (Layout.astro) so app usage shows up
// alongside site traffic, distinguished by the app_* event names.
const ga4Id = ((Astro.locals as any).runtime?.env?.GA4_MEASUREMENT_ID as string) || 'G-5C6B1R3H1Q';
// In-app checkout: same server-resolved PayPal client id the booking page uses.
const paypalClientId = (resolvePayPalConfig((Astro.locals as any).runtime?.env).clientId || '').trim();
// ?test_pay=1 — staging/E2E only: replaces PayPal with the test-capture simulator.
const testPay = Astro.url.searchParams.get('test_pay') === '1';

const t = isJa
  ? {
      title: 'DayDreamHub — 今すぐデイユース',
      tagline: 'いま休める場所を、すぐに。',
      sub: '空港や街なかで空いた時間に。時間貸しのホテルをすぐ探せます。',
