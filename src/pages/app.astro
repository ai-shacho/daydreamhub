---
// Mobile PWA: "find a day-use hotel right now" — geolocation + voice search.
// Standalone shell (no site header/footer) so it feels like an app when
// installed to the home screen.
const acceptLang = Astro.request.headers.get('accept-language') || '';
const urlLang = Astro.url.searchParams.get('lang');
const isJa = urlLang ? urlLang === 'ja' : /(^|,)\s*ja/i.test(acceptLang);
// Same GA4 property as the main site (Layout.astro) so app usage shows up
// alongside site traffic, distinguished by the app_* event names.
const ga4Id = ((Astro.locals as any).runtime?.env?.GA4_MEASUREMENT_ID as string) || 'G-5C6B1R3H1Q';

const t = isJa
  ? {
      title: 'DayDreamHub — 今すぐデイユース',
      tagline: 'いま休める場所を、すぐに。',
      sub: '空港や街なかで空いた時間に。時間貸しのホテルをすぐ探せます。',
      here: '現在地から探す',
      voice: '音声で探す',
      placeholder: '例：バンコク / チャンギ空港',
      micHint: 'タップして話す',
      searching: '検索中…',
      noGeo: '位置情報が取得できませんでした。場所名で検索してください。',
      listening: '聞き取り中…どうぞ',
      noResults: '該当する施設が見つかりませんでした。',
      farNote: 'お近くに施設がないため、最寄りの対応エリアを表示しています。',
      nearLabel: 'の近くのデイユース施設',
      openNow: '営業時間内',
      openShort: '営業中',
      closed: '時間外',
      from: '〜',
      viewSite: 'Webサイト版はこちら',
      install: 'ホーム画面に追加すると、アプリとして使えます。',
      sortDist: '距離順',
      sortPrice: '料金順',
      openOnly: '営業時間内',
      budgetAny: '予算上限なし',
      mapView: '🗺 マップ',
      listView: '📋 リスト',
      budgetUnder: '〜',
      installBanner: 'このアプリをホーム画面に追加できます',
      installBtn: '追加する',
      iosHint: 'iPhoneの方：共有ボタン（□↑）→「ホーム画面に追加」でアプリになります',
      dismiss: '閉じる',
    }
  : {
      title: 'DayDreamHub — Day-use now',
      tagline: 'A place to rest, right now.',
      sub: 'Got spare time at the airport or in town? Find hourly day-use hotels instantly.',
      here: 'Search near me',
      voice: 'Search by voice',
      placeholder: 'e.g. Changi Airport / Bangkok',
      micHint: 'Tap to speak',
      searching: 'Searching…',
      noGeo: 'Could not get your location. Try searching by place name.',
      listening: 'Listening…',
      noResults: 'No facilities found.',
      farNote: 'No facilities near you — showing the closest covered area instead.',
      nearLabel: ' — nearby day-use hotels',
      openNow: 'Open now',
      openShort: 'Open',
      closed: 'Closed now',
      from: 'From ',
      viewSite: 'Open full website',
      install: 'Add to Home Screen to use this as an app.',
      sortDist: 'By distance',
      sortPrice: 'By price',
      openOnly: 'Open now',
      budgetAny: 'Any budget',
      mapView: '🗺 Map',
      listView: '📋 List',
      budgetUnder: 'Under ',
      installBanner: 'Add this app to your home screen',
      installBtn: 'Install',
      iosHint: 'On iPhone: Share button (□↑) → "Add to Home Screen"',
      dismiss: 'Dismiss',
    };

// Japan is intentionally absent — DDH does not plan to list Japanese hotels.
const quickChips: Array<{ label: string; q: string }> = isJa
  ? [
      { label: 'バンコク', q: 'BKK' },
      { label: 'チャンギ', q: 'SIN' },
      { label: 'クアラルンプール', q: 'KUL' },
      { label: 'セブ', q: 'CEB' },
      { label: '香港', q: 'HKG' },
      { label: 'バリ', q: 'DPS' },
      { label: 'ドバイ', q: 'DXB' },
    ]
  : [
      { label: 'Suvarnabhumi (BKK)', q: 'BKK' },
      { label: 'Changi (SIN)', q: 'SIN' },
      { label: 'KLIA (KUL)', q: 'KUL' },
      { label: 'Cebu (CEB)', q: 'CEB' },
      { label: 'Hong Kong (HKG)', q: 'HKG' },
      { label: 'Bali (DPS)', q: 'DPS' },
      { label: 'Dubai (DXB)', q: 'DXB' },
    ];
---
<html lang={isJa ? 'ja' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.title}</title>
    <meta name="description" content={t.sub} />
    <link rel="manifest" href="/app-manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DayDreamHub" />
    <link rel="apple-touch-icon" href="/app-icon-180.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id);
    </script>
    <style is:global>
      :root {
        --bg: #0f172a;
        --card: #1e293b;
        --accent: #38bdf8;
        --accent2: #818cf8;
        --text: #f1f5f9;
        --muted: #94a3b8;
        --ok: #34d399;
        --warn: #fbbf24;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
        min-height: 100vh;
        padding-bottom: env(safe-area-inset-bottom);
      }
      header.bar {
        display: flex; align-items: center; gap: 10px;
        padding: calc(12px + env(safe-area-inset-top)) 16px 12px;
        position: sticky; top: 0; background: rgba(15,23,42,.92);
        backdrop-filter: blur(8px); z-index: 10;
      }
      header.bar img { width: 28px; height: 28px; border-radius: 6px; }
      header.bar strong { font-size: 16px; letter-spacing: .02em; }
      main { padding: 8px 16px 40px; max-width: 560px; margin: 0 auto; }
      h1 { font-size: 20px; line-height: 1.3; margin: 8px 0 14px; }
      .geo-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 15px; border: 0; border-radius: 14px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        color: #0b1120; font-size: 16px; font-weight: 700; cursor: pointer;
        margin-bottom: 12px;
      }
      .geo-btn:active { transform: scale(.98); }
      .voice-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 14px; border-radius: 14px; cursor: pointer;
        background: var(--card); border: 1px solid var(--accent);
        color: var(--accent); font-size: 16px; font-weight: 700;
        margin-bottom: 12px;
      }
      .voice-btn:active { transform: scale(.98); }
      .voice-btn.listening { background: #b91c1c; border-color: #ef4444; color: #fff; animation: pulse 1s infinite; }
      .search-row { display: flex; gap: 8px; }
      .search-row input {
        flex: 1; padding: 14px; border-radius: 12px; border: 1px solid #334155;
        background: var(--card); color: var(--text); font-size: 16px; min-width: 0;
      }
      .icon-btn {
        width: 52px; flex: none; border-radius: 12px; border: 1px solid #334155;
        background: var(--card); color: var(--text); font-size: 20px; cursor: pointer;
      }
      .icon-btn.listening { background: #b91c1c; border-color: #ef4444; animation: pulse 1s infinite; }
      @keyframes pulse { 50% { opacity: .6; } }
      .chips { display: flex; gap: 8px; overflow-x: auto; margin: 12px 0 4px; padding-bottom: 4px; }
      .chips button {
        flex: none; padding: 8px 14px; border-radius: 999px; border: 1px solid #334155;
        background: transparent; color: var(--muted); font-size: 13px; cursor: pointer;
      }
      .filters { display: none; gap: 8px; overflow-x: auto; margin: 4px 0; padding-bottom: 4px; }
      .filters.show { display: flex; }
      .filters button, .filters select {
        flex: none; padding: 7px 12px; border-radius: 999px; border: 1px solid #334155;
        background: transparent; color: var(--muted); font-size: 13px; cursor: pointer;
        appearance: none; -webkit-appearance: none;
      }
      .filters .on { background: #0c4a6e; border-color: var(--accent); color: var(--accent); }
      #installBanner {
        position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom));
        background: var(--card); border: 1px solid #334155; border-radius: 14px;
        padding: 12px 14px; display: none; align-items: center; gap: 10px; z-index: 20;
        box-shadow: 0 8px 24px rgba(0,0,0,.5); font-size: 13px;
      }
      #installBanner.show { display: flex; }
      #installBanner .grow { flex: 1; min-width: 0; }
      #installBanner button.primary {
        border: 0; border-radius: 10px; padding: 8px 14px; font-weight: 700; cursor: pointer;
        background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #0b1120;
      }
      #installBanner button.x { background: none; border: 0; color: var(--muted); font-size: 16px; cursor: pointer; }
      #status { margin: 12px 0 10px; color: var(--muted); font-size: 12px; min-height: 16px; }
      #map { display: none; height: 62vh; border-radius: 14px; z-index: 0; }
      #map.show { display: block; }
      .price-pin {
        display: inline-block; background: var(--accent); color: #0b1120;
        font-weight: 700; font-size: 12px; padding: 3px 8px; border-radius: 999px;
        border: 2px solid #0b1120; white-space: nowrap; box-shadow: 0 2px 6px rgba(0,0,0,.5);
      }
      .leaflet-popup-content-wrapper { background: var(--card); color: var(--text); border-radius: 12px; }
      .leaflet-popup-tip { background: var(--card); }
      .leaflet-popup-content a { color: var(--accent); font-weight: 700; }
      #results { display: flex; flex-direction: column; gap: 10px; }
      #results.hide { display: none; }
      a.card {
        display: flex; align-items: center; gap: 12px; background: var(--card);
        border-radius: 14px; padding: 10px; text-decoration: none; color: var(--text);
      }
      a.card:active { opacity: .8; }
      .thumb { width: 64px; height: 64px; flex: none; object-fit: cover; background: #334155; border-radius: 10px; }
      .info { min-width: 0; flex: 1; }
      .info .name { font-size: 14px; font-weight: 600; line-height: 1.35; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .info .meta { color: var(--muted); font-size: 12px; margin-top: 5px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 3px; vertical-align: 1px; }
      .dot.open { background: var(--ok); }
      .dot.closed { background: var(--warn); }
      .pcol { flex: none; text-align: right; }
      .pcol .usd { font-size: 14px; color: var(--accent); font-weight: 700; }
      .pcol .yen { color: var(--muted); font-size: 11px; margin-top: 2px; }
      footer { margin-top: 28px; text-align: center; font-size: 12px; color: var(--muted); }
      footer a { color: var(--accent); }
      .install-hint { margin-top: 10px; font-size: 11px; }
    </style>
  </head>
  <body>
    <header class="bar">
      <img src="/logo.png" alt="DDH" />
      <strong>DayDreamHub</strong>
    </header>
    <main>
      <h1>{t.tagline}</h1>

      <button class="geo-btn" id="geoChip">📍 {t.here}</button>
      <button class="voice-btn" id="micBtn" title={t.micHint}>🎤 {t.voice}</button>

      <div class="search-row">
        <input id="q" type="search" placeholder={t.placeholder} enterkeyhint="search" />
        <button class="icon-btn" id="goBtn" aria-label="search">🔍</button>
      </div>

      <div class="chips" id="chips">
        {quickChips.map((c) => <button data-q={c.q}>{c.label}</button>)}
      </div>

      <div class="filters" id="filters">
        <button id="mapBtn">{t.mapView}</button>
        <button id="sortBtn">{t.sortDist} ⇅</button>
        <button id="openBtn">✓ {t.openOnly}</button>
        <select id="budgetSel">
          <option value="">{t.budgetAny}</option>
          <option value="25">{t.budgetUnder}$25</option>
          <option value="50">{t.budgetUnder}$50</option>
          <option value="100">{t.budgetUnder}$100</option>
        </select>
      </div>

      <div id="status"></div>
      <div id="map"></div>
      <div id="results"></div>

      <div id="installBanner">
        <div class="grow" id="installText"></div>
        <button class="primary" id="installGo"></button>
        <button class="x" id="installX" aria-label="close">✕</button>
      </div>

      <footer>
        <a href={isJa ? '/ja' : '/'}>{t.viewSite}</a>
        <div class="install-hint">{t.install}</div>
      </footer>
    </main>

    <script define:vars={{ t, isJa }}>
      const $ = (id) => document.getElementById(id);
      const status = $('status');
      const results = $('results');

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      const track = (name, params) => { try { window.gtag && window.gtag('event', name, params || {}); } catch (e) {} };

      // View state: last API result + client-side sort/filter settings.
      let lastData = null;
      let sortBy = 'km';
      let openOnly = false;
      let budget = '';
      let rateJPY = null;

      fetch('/api/exchange-rates')
        .then((r) => r.json())
        .then((d) => { rateJPY = (d.rates && d.rates.JPY) || null; if (lastData) renderView(); })
        .catch(() => {});

      function priceHtml(h) {
        if (h.minPrice == null) return '<div class="pcol"></div>';
        let yen = '';
        if (isJa && rateJPY) {
          const v = h.minPrice * rateJPY;
          const rounded = v >= 1000 ? Math.round(v / 100) * 100 : Math.round(v / 10) * 10;
          yen = `<div class="yen">約¥${rounded.toLocaleString()}</div>`;
        }
        return `<div class="pcol"><div class="usd">${isJa ? '$' + h.minPrice + t.from : t.from + '$' + h.minPrice}</div>${yen}</div>`;
      }

      function render(data) {
        lastData = data;
        renderView();
      }

      function renderView() {
        const data = lastData;
        const all = (data && data.hotels) || [];
        if (!all.length) {
          status.textContent = t.noResults;
          results.innerHTML = '';
          return;
        }
        $('filters').classList.add('show');

        let hotels = all.slice();
        // "Open now" keeps unknown-hours listings; it only drops known-closed.
        if (openOnly) hotels = hotels.filter((h) => h.openNow !== false);
        if (budget) hotels = hotels.filter((h) => h.minPrice != null && h.minPrice <= Number(budget));
        const nullLast = (v) => (v == null ? Infinity : v);
        hotels.sort((a, b) => sortBy === 'price'
          ? nullLast(a.minPrice) - nullLast(b.minPrice)
          : nullLast(a.km) - nullLast(b.km));
        currentView = hotels;
        if (mapMode && map) updateMap(hotels);

        const label = data.center && data.center.label
          ? `${data.center.label}${t.nearLabel}`
          : '';
        // Coverage is far from many places (no Japan listings planned) — say so
        // instead of silently showing hotels thousands of km away.
        const far = all[0].km != null && all[0].km > 150;
        status.textContent = far ? `${t.farNote}${label ? ' ' + label : ''}` : label;
        if (!hotels.length) {
          status.textContent = t.noResults;
          results.innerHTML = '';
          return;
        }
        results.innerHTML = hotels
          .map((h) => {
            const name = isJa && h.nameJa ? h.nameJa : h.name;
            const href = (isJa ? '/ja/hotel/' : '/hotel/') + encodeURIComponent(h.slug);
            const km = h.km != null ? (h.km < 1 ? Math.round(h.km * 1000) + 'm' : h.km + 'km') : '';
            const state = h.openNow === true ? `<span class="dot open"></span>${t.openShort}`
                        : h.openNow === false ? `<span class="dot closed"></span>${t.closed}` : '';
            const img = h.thumbnail ? `<img class="thumb" src="${esc(h.thumbnail)}" alt="" loading="lazy" />` : `<div class="thumb"></div>`;
            const meta = [state, km, esc(h.city || '')].filter(Boolean).join('<span style="opacity:.5"> ・ </span>');
            return `<a class="card" href="${href}" data-slug="${esc(h.slug)}">
              ${img}
              <div class="info">
                <div class="name">${esc(name)}</div>
                <div class="meta">${meta}</div>
              </div>
              ${priceHtml(h)}
            </a>`;
          })
          .join('');
      }

      // Voice queries like "予算50ドルで今すぐ" come back with a server-parsed
      // intent — flip the visible filter controls so the user sees what was
      // understood and can undo it.
      function applyIntent(intent) {
        if (!intent) return;
        if (intent.budgetUsd) {
          const sel = $('budgetSel');
          let opt = sel.querySelector('option[data-ai]');
          if (!opt) {
            opt = document.createElement('option');
            opt.setAttribute('data-ai', '');
            sel.appendChild(opt);
          }
          opt.value = String(intent.budgetUsd);
          opt.textContent = t.budgetUnder + '$' + intent.budgetUsd;
          sel.value = opt.value;
          sel.classList.add('on');
          budget = opt.value;
        }
        if (intent.openNow) {
          openOnly = true;
          $('openBtn').classList.add('on');
        }
        track('app_ai_intent', { budget: intent.budgetUsd || '', open: !!intent.openNow });
      }

      // Map view — Leaflet is loaded only when the user first opens the map.
      let mapMode = false;
      let map = null;
      let markerLayer = null;
      let currentView = [];
      let leafletPromise = null;

      function loadLeaflet() {
        if (leafletPromise) return leafletPromise;
        leafletPromise = new Promise((resolve, reject) => {
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(css);
          const s = document.createElement('script');
          s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
        return leafletPromise;
      }

      function updateMap(hotels) {
        if (!map) return;
        markerLayer.clearLayers();
        const pts = [];
        hotels.forEach((h) => {
          if (h.lat == null || h.lng == null) return;
          pts.push([h.lat, h.lng]);
          const name = isJa && h.nameJa ? h.nameJa : h.name;
          const href = (isJa ? '/ja/hotel/' : '/hotel/') + encodeURIComponent(h.slug);
          const pin = L.divIcon({
            className: '',
            html: `<span class="price-pin">${h.minPrice != null ? '$' + h.minPrice : '●'}</span>`,
            iconAnchor: [18, 12],
          });
          L.marker([h.lat, h.lng], { icon: pin })
            .bindPopup(
              `<div style="min-width:140px"><b>${esc(name)}</b><br>` +
              `${h.km != null ? h.km + 'km ・ ' : ''}${h.minPrice != null ? '$' + h.minPrice + t.from : ''}<br>` +
              `<a href="${href}">${isJa ? '詳細を見る' : 'View details'}</a></div>`
            )
            .addTo(markerLayer);
        });
        const c = lastData && lastData.center;
        if (c) {
          L.circleMarker([c.lat, c.lng], { radius: 7, color: '#38bdf8', fillColor: '#38bdf8', fillOpacity: 0.9 })
            .addTo(markerLayer);
          pts.push([c.lat, c.lng]);
        }
        if (pts.length) map.fitBounds(pts, { padding: [36, 36], maxZoom: 14 });
      }

      $('mapBtn').addEventListener('click', async () => {
        mapMode = !mapMode;
        $('mapBtn').textContent = mapMode ? t.listView : t.mapView;
        $('mapBtn').classList.toggle('on', mapMode);
        track('app_map_toggle', { on: mapMode });
        if (!mapMode) {
          $('map').classList.remove('show');
          results.classList.remove('hide');
          return;
        }
        try {
          await loadLeaflet();
        } catch (e) {
          mapMode = false;
          $('mapBtn').textContent = t.mapView;
          $('mapBtn').classList.remove('on');
          status.textContent = '⚠️ map load failed';
          return;
        }
        $('map').classList.add('show');
        results.classList.add('hide');
        if (!map) {
          map = L.map('map');
          L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO',
            maxZoom: 19,
          }).addTo(map);
          markerLayer = L.layerGroup().addTo(map);
        }
        setTimeout(() => { map.invalidateSize(); updateMap(currentView); }, 60);
      });

      // Filter bar
      $('sortBtn').addEventListener('click', () => {
        sortBy = sortBy === 'km' ? 'price' : 'km';
        $('sortBtn').textContent = (sortBy === 'km' ? t.sortDist : t.sortPrice) + ' ⇅';
        track('app_sort', { by: sortBy });
        renderView();
      });
      $('openBtn').addEventListener('click', () => {
        openOnly = !openOnly;
        $('openBtn').classList.toggle('on', openOnly);
        track('app_filter_open', { on: openOnly });
        renderView();
      });
      $('budgetSel').addEventListener('change', () => {
        budget = $('budgetSel').value;
        $('budgetSel').classList.toggle('on', !!budget);
        track('app_filter_budget', { max: budget || 'any' });
        renderView();
      });

      results.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a.card');
        if (a) track('app_card_tap', { slug: a.dataset.slug });
      });

      async function search(params) {
        status.textContent = t.searching;
        results.innerHTML = '';
        try {
          const res = await fetch('/api/app/nearby?' + new URLSearchParams({ ...params, limit: 24 }));
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          track('app_search', { mode: data.mode, q: params.q || '' });
          applyIntent(data.intent);
          render(data);
        } catch (e) {
          status.textContent = '⚠️ ' + e.message;
        }
      }

      $('geoChip').addEventListener('click', () => {
        status.textContent = t.searching;
        navigator.geolocation.getCurrentPosition(
          (pos) => search({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
          () => { status.textContent = t.noGeo; $('q').focus(); },
          { enableHighAccuracy: false, timeout: 8000, maximumAge: 60000 }
        );
      });

      const doTextSearch = () => {
        const q = $('q').value.trim();
        if (q) search({ q });
      };
      $('goBtn').addEventListener('click', doTextSearch);
      $('q').addEventListener('keydown', (e) => { if (e.key === 'Enter') doTextSearch(); });

      document.querySelectorAll('#chips button').forEach((b) =>
        b.addEventListener('click', () => { $('q').value = b.dataset.q; search({ q: b.dataset.q }); })
      );

      // Voice input (Web Speech API — Safari/Chrome on mobile)
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      const micBtn = $('micBtn');
      if (!SR) {
        micBtn.style.display = 'none';
      } else {
        let rec = null;
        micBtn.addEventListener('click', () => {
          if (rec) { rec.stop(); return; }
          rec = new SR();
          rec.lang = isJa ? 'ja-JP' : 'en-US';
          rec.interimResults = false;
          rec.maxAlternatives = 1;
          micBtn.classList.add('listening');
          status.textContent = t.listening;
          rec.onresult = (e) => {
            const text = e.results[0][0].transcript;
            $('q').value = text;
            track('app_voice_search');
            search({ q: text });
          };
          rec.onerror = () => { status.textContent = t.noGeo; };
          rec.onend = () => { micBtn.classList.remove('listening'); rec = null; };
          rec.start();
        });
      }

      // PWA service worker (scoped to /app so the main site is untouched)
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/app-sw.js', { scope: '/app' }).catch(() => {});
      }

      // Install promotion. Android/Chrome fires beforeinstallprompt; iOS never
      // does, so show a one-time "Add to Home Screen" walkthrough instead.
      const banner = $('installBanner');
      const standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
      const dismissed = localStorage.getItem('ddhAppInstallDismissed');
      $('installText').textContent = t.installBanner;
      $('installGo').textContent = t.installBtn;
      let deferredPrompt = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (!standalone && !dismissed) {
          banner.classList.add('show');
          track('app_install_prompt_shown');
        }
      });
      $('installGo').addEventListener('click', async () => {
        banner.classList.remove('show');
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        track('app_install_' + choice.outcome);
        deferredPrompt = null;
      });
      $('installX').addEventListener('click', () => {
        banner.classList.remove('show');
        localStorage.setItem('ddhAppInstallDismissed', '1');
        track('app_install_dismissed');
      });
      if (/iPhone|iPad|iPod/.test(navigator.userAgent) && !standalone && !dismissed) {
        $('installText').textContent = t.iosHint;
        $('installGo').style.display = 'none';
        banner.classList.add('show');
        track('app_install_ios_hint_shown');
      }
    </script>
  </body>
</html>
