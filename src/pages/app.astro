---
<html lang={isJa ? 'ja' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.title}</title>
    <meta name="description" content={t.sub} />
    <link rel="manifest" href="/app-manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="DayDreamHub" />
    <link rel="apple-touch-icon" href="/app-icon-180.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id);
    </script>
    <style is:global>
      :root {
        --bg: #f8fafc;
        --surface: #ffffff;
        --line: #e2e8f0;
        --text: #0f172a;
        --muted: #64748b;
        --teal: #0d9488;
        --teal-dark: #0f766e;
        --teal-soft: #f0fdfa;
        --ok: #059669;
        --warn: #d97706;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
      html, body { height: 100%; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
        overscroll-behavior: none;
      }

      /* ---------- Home (launcher) ---------- */
      #home { min-height: 100%; padding-bottom: env(safe-area-inset-bottom); }
      header.bar {
        display: flex; align-items: center; gap: 10px;
        padding: calc(12px + env(safe-area-inset-top)) 18px 10px;
        background: var(--surface);
      }
      header.bar img { width: 28px; height: 28px; border-radius: 6px; }
      header.bar strong { font-size: 16px; letter-spacing: .02em; }
      #home main { padding: 14px 18px 40px; max-width: 560px; margin: 0 auto; }
      h1 { font-size: 25px; line-height: 1.3; margin: 4px 0 4px; font-weight: 800; }
      p.sub { color: var(--muted); font-size: 13px; margin-bottom: 18px; }
      .geo-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 16px; border: 0; border-radius: 14px;
        background: linear-gradient(135deg, #0d9488, #0891b2);
        color: #fff; font-size: 16px; font-weight: 700; cursor: pointer;
        box-shadow: 0 4px 14px rgba(13,148,136,.3);
        margin-bottom: 10px;
      }
      .geo-btn:active { transform: scale(.98); }
      .voice-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 15px; border-radius: 14px; cursor: pointer;
        background: var(--surface); border: 1.5px solid var(--teal);
        color: var(--teal-dark); font-size: 16px; font-weight: 700;
        margin-bottom: 10px;
      }
      .voice-btn:active { transform: scale(.98); }
      .voice-btn.listening, .mic-fab.listening { background: #dc2626 !important; border-color: #dc2626 !important; color: #fff !important; animation: pulse 1s infinite; }
      @keyframes pulse { 50% { opacity: .6; } }
      .search-row { display: flex; gap: 8px; }
      .search-row input {
        flex: 1; padding: 14px; border-radius: 12px; border: 1.5px solid var(--line);
        background: var(--surface); color: var(--text); font-size: 16px; min-width: 0;
      }
      .search-row input::placeholder { color: #94a3b8; }
      .icon-btn {
        width: 52px; flex: none; border-radius: 12px; border: 1.5px solid var(--line);
        background: var(--surface); color: var(--text); font-size: 20px; cursor: pointer;
      }
      #homeStatus { margin: 10px 0 0; color: var(--muted); font-size: 13px; min-height: 18px; }
      .popular-title { margin: 18px 0 10px; font-size: 14px; font-weight: 700; color: var(--text); }
      .areas { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .area {
        position: relative; border: 0; padding: 0; border-radius: 14px; overflow: hidden;
        aspect-ratio: 16 / 10; cursor: pointer; background: var(--line);
      }
      .area img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .area::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.55) 100%);
      }
      .area span {
        position: absolute; left: 10px; bottom: 8px; z-index: 1;
        color: #fff; font-size: 14px; font-weight: 700; text-shadow: 0 1px 4px rgba(0,0,0,.6);
      }
      .area:active { transform: scale(.98); }
      #home footer { margin-top: 26px; text-align: center; font-size: 12px; color: var(--muted); }
      #home footer a { color: var(--teal-dark); font-weight: 600; }
      .install-hint { margin-top: 10px; font-size: 11px; }

      /* ---------- Results: full-screen map + bottom sheet ---------- */
      #resultsScreen { position: fixed; inset: 0; display: none; background: var(--bg); z-index: 10; }
      #resultsScreen.active { display: block; }
      #map { position: absolute; inset: 0; z-index: 0; background: #e5e7eb; }
      .topbar {
        position: absolute; left: 10px; right: 10px;
        top: calc(10px + env(safe-area-inset-top));
        display: flex; gap: 8px; z-index: 1002;
      }
      .topbar .round {
        width: 44px; height: 44px; flex: none; border-radius: 12px; border: 0;
        background: var(--surface); color: var(--text); font-size: 18px; cursor: pointer;
        box-shadow: 0 2px 10px rgba(15,23,42,.18);
      }
      .topbar .pill {
        flex: 1; min-width: 0; height: 44px; border-radius: 12px; border: 0;
        background: var(--surface); color: var(--text); font-size: 14px; cursor: pointer;
        padding: 0 14px; text-align: left; overflow: hidden; white-space: nowrap;
        text-overflow: ellipsis; box-shadow: 0 2px 10px rgba(15,23,42,.18);
      }
      .topbar .pill .q { font-weight: 700; }
      #farToast {
        position: absolute; left: 10px; right: 10px;
        top: calc(62px + env(safe-area-inset-top));
        z-index: 1002; background: #fffbeb; border: 1px solid #fcd34d; color: #92400e;
        font-size: 12px; padding: 8px 12px; border-radius: 10px; display: none;
      }
      #farToast.show { display: block; }

      #sheet {
        position: absolute; left: 0; right: 0; top: 0; height: 100%;
        transform: translateY(52%);
        background: var(--bg); border-radius: 20px 20px 0 0;
        box-shadow: 0 -8px 30px rgba(15,23,42,.18);
        z-index: 1003; transition: transform .28s cubic-bezier(.25,.8,.35,1);
        display: flex; flex-direction: column;
      }
      #sheet.dragging { transition: none; }
      .grabber { padding: 10px 0 6px; cursor: grab; touch-action: none; flex: none; }
      .grabber::before {
        content: ''; display: block; width: 42px; height: 5px; border-radius: 999px;
        background: #cbd5e1; margin: 0 auto;
      }
      .sheet-head { flex: none; padding: 0 14px 8px; }
      #sheetStatus { color: var(--muted); font-size: 13px; margin-bottom: 8px; min-height: 16px; font-weight: 500; }
      .filters { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; }
      .filters button, .filters select {
        flex: none; padding: 8px 13px; border-radius: 999px; border: 1.5px solid var(--line);
        background: var(--surface); color: #475569; font-size: 13px; font-weight: 600; cursor: pointer;
        appearance: none; -webkit-appearance: none;
      }
      .filters .on { background: var(--teal-soft); border-color: var(--teal); color: var(--teal-dark); }
      .sheet-list { flex: 1; overflow-y: auto; padding: 4px 14px 20px; display: flex; flex-direction: column; gap: 10px; }
      a.card {
        display: flex; align-items: center; gap: 12px; background: var(--surface);
        border: 1px solid var(--line); border-radius: 16px; padding: 10px;
        text-decoration: none; color: var(--text);
        flex: none; scroll-margin: 8px; box-shadow: 0 1px 3px rgba(15,23,42,.05);
      }
      a.card:active { opacity: .75; }
      a.card.sel { border-color: var(--teal); box-shadow: 0 0 0 2px rgba(13,148,136,.35); }
      .thumb { width: 86px; height: 86px; flex: none; object-fit: cover; background: var(--line); border-radius: 12px; }
      .info { min-width: 0; flex: 1; }
      .info .name { font-size: 15px; font-weight: 700; line-height: 1.35; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .info .meta { color: var(--muted); font-size: 13px; margin-top: 6px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 3px; vertical-align: 1px; }
      .dot.open { background: var(--ok); }
      .dot.closed { background: var(--warn); }
      .pcol { flex: none; text-align: right; }
      .pcol .usd { font-size: 15px; color: var(--teal-dark); font-weight: 800; }
      .pcol .yen { color: var(--muted); font-size: 11px; margin-top: 3px; }

      .price-pin {
        display: inline-block; background: var(--teal-dark); color: #fff;
        font-weight: 700; font-size: 12px; padding: 3px 9px; border-radius: 999px;
        border: 2px solid #fff; white-space: nowrap; box-shadow: 0 2px 6px rgba(15,23,42,.35);
        cursor: pointer;
      }
      .price-pin.sel { background: #0f172a; transform: scale(1.15); }
      .price-pin.ext { background: #c2410c; }
      /* Leaflet's own CSS loads later (lazy) — force our popup theme. */
      .leaflet-popup-content-wrapper {
        background: #ffffff !important; color: var(--text) !important; border-radius: 14px !important;
        box-shadow: 0 6px 20px rgba(15,23,42,.3) !important; padding: 0 !important; border: 1px solid var(--line);
      }
      .leaflet-popup-content { margin: 0 !important; min-width: 210px; line-height: 1.4 !important; }
      .leaflet-popup-tip { background: #ffffff !important; }
      .map-pop { display: flex; align-items: center; gap: 10px; padding: 10px 12px; cursor: pointer; }
      .map-pop .mp-thumb { width: 46px; height: 46px; border-radius: 9px; object-fit: cover; background: var(--line); flex: none; }
      .map-pop .mp-thumb.tel { display: flex; align-items: center; justify-content: center; font-size: 20px; }
      .map-pop .mp-body { min-width: 0; flex: 1; }
      .map-pop .mp-name { font-size: 13px; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 150px; }
      .map-pop .mp-meta { color: var(--muted); font-size: 11.5px; margin-top: 3px; }
      .map-pop .mp-go { flex: none; color: var(--teal); font-size: 17px; font-weight: 700; }
      .ofc {
        display: inline-block; font-size: 10px; font-weight: 700; padding: 1px 7px;
        border-radius: 999px; background: var(--teal-soft); color: var(--teal-dark);
        border: 1px solid var(--teal); margin-right: 4px; vertical-align: 1px;
      }
      .meta .ext-badge { margin-right: 4px; vertical-align: 1px; }
      .thumb.tel { display: flex; align-items: center; justify-content: center; font-size: 24px; }

      /* ---------- Conversational (chat) screen ---------- */
      #chatScreen {
        position: fixed; inset: 0; z-index: 15; background: var(--bg);
        display: none; flex-direction: column;
      }
      #chatScreen.open { display: flex; }
      .chat-head {
        display: flex; align-items: center; gap: 10px;
        padding: calc(10px + env(safe-area-inset-top)) 12px 10px;
        background: var(--surface); border-bottom: 1px solid var(--line); flex: none;
      }
      .chat-head .back {
        width: 40px; height: 40px; border-radius: 12px; border: 0; cursor: pointer;
        background: var(--bg); color: var(--text); font-size: 17px;
      }
      .chat-head .ttl { flex: 1; font-size: 15px; font-weight: 800; }
      #chatLog { flex: 1; overflow-y: auto; padding: 14px 14px 10px; }
      .msg { max-width: 86%; margin-bottom: 10px; clear: both; }
      .msg .bubble {
        padding: 11px 14px; border-radius: 16px; font-size: 14px; line-height: 1.55;
        word-break: break-word;
      }
      .msg.user { float: right; }
      .msg.user .bubble { background: linear-gradient(135deg, #0d9488, #0891b2); color: #fff; border-bottom-right-radius: 6px; }
      .msg.ai { float: left; }
      .msg.ai .bubble { background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 6px; }
      .msg .cards { margin-top: 8px; display: flex; flex-direction: column; gap: 8px; }
      .msg .cards a.card { padding: 8px; border-radius: 13px; }
      .msg .cards .thumb { width: 56px; height: 56px; border-radius: 9px; }
      .chat-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
      .chat-chips button {
        padding: 8px 13px; border-radius: 999px; border: 1.5px solid var(--line);
        background: var(--surface); color: #475569; font-size: 13px; font-weight: 600; cursor: pointer;
      }
      .chat-chips button.primary { border-color: var(--teal); color: var(--teal-dark); background: var(--teal-soft); }
      .chat-bar {
        display: flex; gap: 8px; padding: 10px 12px calc(12px + env(safe-area-inset-bottom));
        background: var(--surface); border-top: 1px solid var(--line); flex: none;
      }
      .chat-bar input {
        flex: 1; min-width: 0; padding: 12px 14px; border-radius: 999px;
        border: 1.5px solid var(--line); background: var(--bg); color: var(--text); font-size: 16px;
      }
      .chat-bar button {
        width: 46px; height: 46px; flex: none; border-radius: 50%; border: 0; cursor: pointer;
        font-size: 18px; background: var(--bg); color: var(--text); border: 1.5px solid var(--line);
      }
      .chat-bar button.send { background: linear-gradient(135deg, #0d9488, #0891b2); color: #fff; border: 0; }
      .chat-bar button.listening { background: #dc2626 !important; color: #fff !important; border: 0; animation: pulse 1s infinite; }
      .typing { color: var(--muted); font-size: 13px; }

      /* ---------- Concierge (unlisted hotels + AI call) ---------- */
      .ext-card {
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px;
        padding: 12px 13px; margin-top: 8px;
      }
      .ext-card .top { display: flex; align-items: center; gap: 8px; }
      .ext-card .ename { font-size: 14px; font-weight: 700; flex: 1; min-width: 0; }
      .ext-badge {
        flex: none; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 999px;
        background: #fff7ed; color: #c2410c; border: 1px solid #fdba74;
      }
      .ext-card .emeta { color: var(--muted); font-size: 12px; margin-top: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .ext-card .call-cta {
        display: block; width: 100%; margin-top: 9px; padding: 11px; border: 0; border-radius: 11px;
        background: linear-gradient(135deg, #0d9488, #0891b2); color: #fff;
        font-size: 13px; font-weight: 700; cursor: pointer;
      }
      .cg-note { color: var(--muted); font-size: 12px; line-height: 1.7; margin: 10px 0 14px; }
      .expand-btn {
        width: 100%; padding: 13px; margin-top: 2px; cursor: pointer;
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px;
        color: var(--teal-dark); font-size: 14px; font-weight: 700;
      }
      .cg-inline {
        width: 100%; padding: 13px; margin-top: 2px; cursor: pointer;
        background: var(--surface); border: 1.5px dashed var(--teal); border-radius: 14px;
        color: var(--teal-dark); font-size: 14px; font-weight: 700;
      }
      .time-row { display: flex; gap: 8px; }
      .time-row .field { flex: 1; }

      /* ---------- In-app booking panels ---------- */
      .panel {
        position: fixed; inset: 0; z-index: 30; background: var(--bg);
        transform: translateY(100%); transition: transform .3s cubic-bezier(.25,.8,.35,1);
        overflow-y: auto; overscroll-behavior: contain;
      }
      .panel.open { transform: translateY(0); }
      #bookPanel { z-index: 40; }
      #donePanel { z-index: 50; }
      .panel-hero { position: relative; height: 230px; background: var(--line); }
      .hero-scroll {
        display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
      }
      .hero-scroll img {
        flex: none; width: 100%; height: 100%; object-fit: cover; scroll-snap-align: start;
      }
      .hero-count {
        position: absolute; right: 10px; bottom: 10px; background: rgba(15,23,42,.7);
        color: #fff; font-size: 11px; padding: 3px 9px; border-radius: 999px;
      }
      .desc { color: #334155; font-size: 13px; line-height: 1.75; margin-bottom: 6px; }
      .desc.clamp { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
      .desc-more { color: var(--teal-dark); font-size: 13px; font-weight: 600; background: none; border: 0; cursor: pointer; padding: 0; margin-bottom: 8px; }
      .mybk-btn {
        display: none; width: 100%; padding: 13px; margin: 12px 0 0; cursor: pointer;
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px;
        color: var(--text); font-size: 14px; font-weight: 700; text-align: center;
      }
      .mybk-btn.show { display: block; }
      .bk-badge {
        display: none; margin-left: 8px; padding: 2px 8px; border-radius: 999px;
        background: #dc2626; color: #fff; font-size: 11px; font-weight: 700;
      }
      .bk-badge.show { display: inline-block; }
      .marker-cluster-small, .marker-cluster-medium, .marker-cluster-large {
        background: rgba(13,148,136,.28) !important;
      }
      .marker-cluster-small div, .marker-cluster-medium div, .marker-cluster-large div {
        background: var(--teal-dark) !important; color: #fff !important;
        font-weight: 700; font-family: inherit;
      }
      .bk-item {
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px;
        padding: 13px 14px; margin-bottom: 10px; font-size: 14px;
      }
      .bk-item .top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
      .bk-item .hname { font-weight: 700; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .bk-item .meta2 { color: var(--muted); font-size: 12px; margin-top: 5px; }
      .st { flex: none; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
      .st.pending { background: #fffbeb; color: #92400e; border: 1px solid #fcd34d; }
      .st.confirmed { background: var(--teal-soft); color: var(--teal-dark); border: 1px solid var(--teal); }
      .st.cancelled { background: #f1f5f9; color: var(--muted); border: 1px solid var(--line); }
      .panel-close {
        position: absolute; top: calc(10px + env(safe-area-inset-top)); left: 10px;
        width: 40px; height: 40px; border-radius: 12px; border: 0; cursor: pointer;
        background: rgba(255,255,255,.95); color: var(--text); font-size: 17px;
        box-shadow: 0 2px 8px rgba(15,23,42,.25); z-index: 2;
      }
      .panel-body { padding: 16px 18px calc(28px + env(safe-area-inset-bottom)); max-width: 560px; margin: 0 auto; }
      .panel-body h2 { font-size: 19px; font-weight: 800; line-height: 1.35; }
      .panel-meta { color: var(--muted); font-size: 13px; margin: 6px 0 14px; }
      .sec-title { font-size: 14px; font-weight: 700; margin: 14px 0 8px; }
      .plan {
        display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px;
        padding: 13px 14px; margin-bottom: 10px; cursor: pointer; color: var(--text);
      }
      .plan:active { border-color: var(--teal); }
      .plan .pinfo { flex: 1; min-width: 0; }
      .plan .pname { font-size: 14px; font-weight: 700; }
      .plan .pmeta { color: var(--muted); font-size: 12px; margin-top: 4px; }
      .plan .pprice { flex: none; text-align: right; }
      .plan .pprice .usd { color: var(--teal-dark); font-size: 15px; font-weight: 800; }
      .plan .pprice .yen { color: var(--muted); font-size: 11px; margin-top: 2px; }
      .plan .go { flex: none; color: var(--teal); font-size: 18px; }
      .web-link { display: block; text-align: center; color: var(--teal-dark); font-size: 13px; font-weight: 600; margin-top: 14px; text-decoration: none; }
      .sum-box {
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px;
        padding: 13px 14px; margin-bottom: 14px; font-size: 14px;
      }
      .sum-box .row { display: flex; justify-content: space-between; gap: 10px; margin: 3px 0; }
      .sum-box .row .k { color: var(--muted); font-size: 13px; flex: none; }
      .sum-box .row.total { border-top: 1px solid var(--line); margin-top: 8px; padding-top: 8px; font-weight: 800; }
      .sum-box .row.total .v { color: var(--teal-dark); }
      .field { margin-bottom: 12px; }
      .field label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 5px; }
      .field input, .field select {
        width: 100%; padding: 13px; border-radius: 12px; border: 1.5px solid var(--line);
        background: var(--surface); color: var(--text); font-size: 16px;
      }
      .field input:focus, .field select:focus { outline: none; border-color: var(--teal); }
      #payArea { margin-top: 16px; }
      #payHint { color: var(--warn); font-size: 13px; margin-bottom: 8px; min-height: 17px; }
      #paypalBox.locked { opacity: .45; pointer-events: none; }
      .test-pay-btn {
        width: 100%; padding: 15px; border: 0; border-radius: 14px; cursor: pointer;
        background: linear-gradient(135deg, #0d9488, #0891b2); color: #fff; font-size: 15px; font-weight: 700;
      }
      .done-wrap { text-align: center; padding-top: calc(80px + env(safe-area-inset-top)); }
      .done-mark {
        width: 74px; height: 74px; border-radius: 50%; margin: 0 auto 18px;
        background: var(--teal-soft); border: 2px solid var(--teal);
        display: flex; align-items: center; justify-content: center; font-size: 34px; color: var(--teal-dark);
      }
      .done-wrap h2 { font-size: 21px; font-weight: 800; margin-bottom: 10px; }
      .done-wrap p { color: var(--muted); font-size: 14px; line-height: 1.7; margin: 0 24px 16px; }
      .done-box { margin: 0 18px 22px; text-align: left; }
      .done-close {
        margin: 0 18px; width: calc(100% - 36px); padding: 15px; border: 0; border-radius: 14px;
        background: linear-gradient(135deg, #0d9488, #0891b2); color: #fff; font-size: 15px; font-weight: 700; cursor: pointer;
      }

      #installBanner {
        position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom));
        background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
        padding: 12px 14px; display: none; align-items: center; gap: 10px; z-index: 20;
        box-shadow: 0 8px 24px rgba(15,23,42,.18); font-size: 13px;
      }
      #installBanner.show { display: flex; }
      #installBanner .grow { flex: 1; min-width: 0; }
      #installBanner button.primary {
        border: 0; border-radius: 10px; padding: 8px 14px; font-weight: 700; cursor: pointer;
        background: linear-gradient(135deg, #0d9488, #0891b2); color: #fff;
      }
      #installBanner button.x { background: none; border: 0; color: var(--muted); font-size: 16px; cursor: pointer; }
    </style>
  </head>
  <body>
    <!-- Home: choose how to search -->
    <div id="home">
      <header class="bar">
        <img src="/logo.png" alt="DDH" />
        <strong>DayDreamHub</strong>
      </header>
      <main>
        <h1>{t.tagline}</h1>
        <p class="sub">{t.sub}</p>

        <button class="geo-btn" id="geoBtn">📍 {t.here}</button>
        <button class="voice-btn" id="micBtn" title={t.micHint}>🎤 {t.voice}</button>

        <div class="search-row">
          <input id="q" type="search" placeholder={t.placeholder} enterkeyhint="search" />
          <button class="icon-btn" id="goBtn" aria-label="search">🔍</button>
        </div>

        <div id="homeStatus"></div>

        <button class="mybk-btn" id="myBookingsBtn">{t.myBookings}<span class="bk-badge" id="bkBadge"></span></button>

        <div class="popular-title">{t.popular}</div>
        <div class="areas" id="areas">
          {areas.map((a) => (
            <button class="area" data-q={a.q}>
              <img src={a.img} alt="" loading="lazy" />
              <span>{a.label}</span>
            </button>
          ))}
        </div>

        <footer>
          <a href={isJa ? '/ja' : '/'}>{t.viewSite}</a>
          <div class="install-hint">{t.install}</div>
        </footer>
      </main>
    </div>

    <!-- Results: map canvas + floating bar + bottom sheet -->
    <div id="resultsScreen">
      <div id="map"></div>
      <div class="topbar">
        <button class="round" id="backBtn" aria-label="back">←</button>
        <button class="pill" id="queryPill"><span class="q"></span></button>
        <button class="round mic-fab" id="micFab" title={t.micHint}>🎤</button>
      </div>
      <div id="farToast">{t.farNote}</div>
      <div id="sheet">
        <div class="grabber" id="grabber"></div>
        <div class="sheet-head">
          <div id="sheetStatus"></div>
          <div class="filters">
            <button id="sortBtn">{t.sortDist} ⇅</button>
            <button id="openBtn">✓ {t.openOnly}</button>
            <select id="budgetSel">
              <option value="">{t.budgetAny}</option>
              <option value="25">{t.budgetUnder}$25</option>
              <option value="50">{t.budgetUnder}$50</option>
              <option value="100">{t.budgetUnder}$100</option>
            </select>
          </div>
        </div>
        <div class="sheet-list" id="list"></div>
      </div>
    </div>

    <!-- Conversational concierge -->
    <div id="chatScreen">
      <div class="chat-head">
        <button class="back" id="chatBack">←</button>
        <div class="ttl">💬 {t.chatTitle}</div>
      </div>
      <div id="chatLog"></div>
      <div class="chat-bar">
        <input id="chatInput" type="text" placeholder={t.chatPlaceholder} enterkeyhint="send" />
        <button id="chatMic" aria-label="mic">🎤</button>
        <button class="send" id="chatSend" aria-label="send">↑</button>
      </div>
    </div>

    <!-- In-app hotel detail -->
    <div class="panel" id="detailPanel">
      <div class="panel-hero">
        <button class="panel-close" id="detailClose">←</button>
        <div class="hero-scroll" id="heroScroll"><img id="detailImg" src="" alt="" /></div>
        <div class="hero-count" id="heroCount" style="display:none"></div>
      </div>
      <div class="panel-body">
        <h2 id="detailName"></h2>
        <div class="panel-meta" id="detailMeta"></div>
        <div id="descWrap" style="display:none">
          <div class="sec-title">{t.aboutHotel}</div>
          <div class="desc clamp" id="detailDesc"></div>
          <button class="desc-more" id="descMore">{t.more}</button>
        </div>
        <div class="sec-title" id="planTitle">{t.selectPlan}</div>
        <div id="planList"></div>
        <div id="extCta" style="display:none">
          <div class="cg-note" id="extNote"></div>
          <button class="test-pay-btn" id="extCallBtn">{t.cgCallBtn}</button>
        </div>
        <a class="web-link" id="detailWebLink" href="#">{t.webDetail}</a>
      </div>
    </div>

    <!-- In-app booking form + payment -->
    <div class="panel" id="bookPanel">
      <div class="panel-body" style="padding-top: calc(14px + env(safe-area-inset-top));">
        <button class="panel-close" id="bookClose" style="position:static;margin-bottom:12px;">←</button>
        <h2>{t.bookTitle}</h2>
        <div class="panel-meta" id="bookHotelLine"></div>
        <div class="sum-box" id="bookSummary"></div>
        <div class="cg-note">{t.bookNote}</div>
        <div class="field">
          <label for="bkDate">{t.dateLabel}</label>
          <input id="bkDate" type="date" />
        </div>
        <div class="field">
          <label for="bkGuests">{t.guestsLabel}</label>
          <select id="bkGuests"></select>
        </div>
        <div class="field">
          <label for="bkName">{t.nameLabel}</label>
          <input id="bkName" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="bkEmail">{t.emailLabel}</label>
          <input id="bkEmail" type="email" autocomplete="email" inputmode="email" />
        </div>
        <div class="field">
          <label for="bkPhone">{t.phoneLabel}</label>
          <input id="bkPhone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div id="payArea">
          <div id="payHint"></div>
          <div id="paypalBox" class="locked"></div>
        </div>
      </div>
    </div>

    <!-- AI phone confirmation request (unlisted hotels) -->
    <div class="panel" id="callPanel" style="z-index:45">
      <div class="panel-body" style="padding-top: calc(14px + env(safe-area-inset-top));">
        <button class="panel-close" id="callClose" style="position:static;margin-bottom:12px;">←</button>
        <h2>{t.cgTitle}</h2>
        <div class="panel-meta" id="callHotelLine"></div>
        <div class="cg-note">{t.cgNote}</div>
        <div class="field">
          <label for="cgDate">{t.dateLabel}</label>
          <input id="cgDate" type="date" />
        </div>
        <div class="time-row">
          <div class="field">
            <label for="cgFrom">{t.cgTimeFrom}</label>
            <select id="cgFrom"></select>
          </div>
          <div class="field">
            <label for="cgTo">{t.cgTimeTo}</label>
            <select id="cgTo"></select>
          </div>
        </div>
        <div class="field">
          <label for="cgGuests">{t.guestsLabel}</label>
          <select id="cgGuests"></select>
        </div>
        <div id="cgHint" style="color:var(--warn);font-size:13px;min-height:17px;margin-bottom:8px;"></div>
        <button class="test-pay-btn" id="cgSubmit">{t.cgSubmit}</button>
      </div>
    </div>

    <!-- My bookings -->
    <div class="panel" id="bkListPanel">
      <div class="panel-body" style="padding-top: calc(14px + env(safe-area-inset-top));">
        <button class="panel-close" id="bkListClose" style="position:static;margin-bottom:12px;">←</button>
        <h2>{t.bookingsTitle}</h2>
        <div style="height:12px"></div>
        <div id="bkList"></div>
      </div>
    </div>

    <!-- Booking complete -->
    <div class="panel" id="donePanel">
      <div class="done-wrap">
        <div class="done-mark">✓</div>
        <h2>{t.doneTitle}</h2>
        <p>{t.doneNote}</p>
        <div class="sum-box done-box" id="doneBox"></div>
        <button class="done-close" id="doneClose">{t.close}</button>
      </div>
    </div>

    <!-- Contact capture right before accepting a quote -->
    <div class="panel" id="acceptPanel" style="z-index:55">
      <div class="panel-body" style="padding-top: calc(14px + env(safe-area-inset-top));">
        <button class="panel-close" id="acceptClose" style="position:static;margin-bottom:12px;">←</button>
        <h2>{t.acceptTitle}</h2>
        <div class="panel-meta" id="acceptHotelLine"></div>
        <div class="cg-note">{t.acceptNote}</div>
        <div class="field">
          <label for="acName">{t.nameLabel}</label>
          <input id="acName" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="acEmail">{t.emailLabel}</label>
          <input id="acEmail" type="email" autocomplete="email" inputmode="email" />
        </div>
        <div class="field">
          <label for="acPhone">{t.phoneLabel}</label>
          <input id="acPhone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div id="acHint" style="color:var(--warn);font-size:13px;min-height:17px;margin-bottom:8px;"></div>
        <button class="test-pay-btn" id="acGo">{t.acceptGo}</button>
      </div>
    </div>

    <div id="installBanner">
      <div class="grow" id="installText"></div>
      <button class="primary" id="installGo"></button>
      <button class="x" id="installX" aria-label="close">✕</button>
    </div>

    <script define:vars={{ t, isJa, paypalClientId, testPay }}>
      const $ = (id) => document.getElementById(id);
      const list = $('list');
      const sheet = $('sheet');

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }
      const track = (name, params) => { try { window.gtag && window.gtag('event', name, params || {}); } catch (e) {} };
      // City names come back in English from the DB; show Japanese for ja UI.
      const CITY_JA = {
        'Bangkok': 'バンコク', 'Lat Krabang': 'ラートクラバン', 'Phuket': 'プーケット', 'Pattaya': 'パタヤ',
        'Koh Samui': 'サムイ島', 'Chiang Mai': 'チェンマイ', 'Singapore': 'シンガポール',
        'Kuala Lumpur': 'クアラルンプール', 'Petaling Jaya': 'ペタリンジャヤ', 'Jakarta': 'ジャカルタ',
        'Bali': 'バリ', 'Denpasar': 'デンパサール', 'Ubud': 'ウブド', 'Manila': 'マニラ', 'Makati': 'マカティ',
        'Cebu': 'セブ', 'Cebu City': 'セブ', 'Ho Chi Minh City': 'ホーチミン', 'Ho Chi Minh': 'ホーチミン',
        'Hanoi': 'ハノイ', 'Da Nang': 'ダナン', 'Hong Kong': '香港', 'Taipei': '台北', 'Seoul': 'ソウル',
        'Shanghai': '上海', 'Beijing': '北京', 'Dubai': 'ドバイ', 'Abu Dhabi': 'アブダビ', 'Doha': 'ドーハ',
        'Cairo': 'カイロ', 'Giza': 'ギザ', 'Nairobi': 'ナイロビ', 'London': 'ロンドン', 'Paris': 'パリ',
        'Amsterdam': 'アムステルダム', 'Prague': 'プラハ', 'Venice': 'ヴェネツィア', 'Porto': 'ポルト',
        'New York': 'ニューヨーク', 'Los Angeles': 'ロサンゼルス', 'Sydney': 'シドニー',
        'Melbourne': 'メルボルン', 'Auckland': 'オークランド', 'Tbilisi': 'トビリシ', 'Almaty': 'アルマティ',
      };
      const cityJa = (c) => (isJa && c && CITY_JA[c]) || c || '';

      // ---------- state ----------
      let lastData = null;
      let currentView = [];
      let sortBy = 'km';
      let openOnly = false;
      const RADII = [20, 100, null]; // start with the neighbourhood, widen on demand
      let radiusIdx = 0;
      let currentExtView = [];
      let budget = '';
      let rateJPY = null;
      let map = null;
      let markerLayer = null;
      let centerDot = null;
      let markersBySlug = {};
      let leafletPromise = null;

      fetch('/api/exchange-rates')
        .then((r) => r.json())
        .then((d) => { rateJPY = (d.rates && d.rates.JPY) || null; if (lastData) renderView(); })
        .catch(() => {});

      // ---------- bottom sheet ----------
      const SNAPS = [0.08, 0.52, 0.84]; // fraction of viewport height from top
      let snapIndex = 1;
      function setSheet(i) {
        snapIndex = Math.max(0, Math.min(SNAPS.length - 1, i));
        sheet.classList.remove('dragging');
        sheet.style.transform = `translateY(${SNAPS[snapIndex] * 100}%)`;
        // keep the list's visible height in sync so the last card can scroll into view
        list.style.paddingBottom = `${Math.round(SNAPS[snapIndex] * window.innerHeight) + 20}px`;
      }
      function snapNearest(frac, dy) {
        let best = 0;
        SNAPS.forEach((s, i) => { if (Math.abs(s - frac) < Math.abs(SNAPS[best] - frac)) best = i; });
        // a decisive fling moves at least one snap in the drag direction
        if (dy < -60 && best >= snapIndex) best = Math.max(0, snapIndex - 1);
        if (dy > 60 && best <= snapIndex) best = Math.min(SNAPS.length - 1, snapIndex + 1);
        setSheet(best);
      }
      (() => {
        // Desktop: drag via the grabber.
        const grabber = $('grabber');
        let startY = 0, startFrac = 0, dragging = false;
        grabber.addEventListener('pointerdown', (e) => {
          dragging = true; startY = e.clientY; startFrac = SNAPS[snapIndex];
          sheet.classList.add('dragging');
          grabber.setPointerCapture(e.pointerId);
        });
        grabber.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const frac = Math.max(0.04, Math.min(0.88, startFrac + (e.clientY - startY) / window.innerHeight));
          sheet.style.transform = `translateY(${frac * 100}%)`;
        });
        grabber.addEventListener('pointerup', (e) => {
          if (!dragging) return;
          dragging = false;
          const dy = e.clientY - startY;
          // a light tap (no real drag) toggles between half and full
          if (Math.abs(dy) < 6) { setSheet(snapIndex === 1 ? 0 : 1); return; }
          snapNearest(startFrac + dy / window.innerHeight, dy);
        });

        // Touch: drag anywhere on the sheet (Google Maps behaviour). Below
        // full, any mostly-vertical swipe moves the sheet; at full, the list
        // scrolls natively and pulling down from its top collapses the sheet.
        let tX = 0, tY = 0, tFrac = 0, tTaken = false, tDecided = false;
        sheet.addEventListener('touchstart', (e) => {
          tX = e.touches[0].clientX; tY = e.touches[0].clientY;
          tFrac = SNAPS[snapIndex]; tTaken = false; tDecided = false;
        }, { passive: true });
        sheet.addEventListener('touchmove', (e) => {
          const x = e.touches[0].clientX, y = e.touches[0].clientY;
          const dx = x - tX, dy = y - tY;
          if (!tDecided) {
            if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
            tDecided = true;
            const vertical = Math.abs(dy) > Math.abs(dx);
            const fromFull = snapIndex === 0 && list.scrollTop <= 0 && dy > 0;
            tTaken = vertical && (snapIndex > 0 || fromFull);
            if (tTaken) sheet.classList.add('dragging');
          }
          if (!tTaken) return;
          e.preventDefault();
          const frac = Math.max(0.04, Math.min(0.88, tFrac + (y - tY) / window.innerHeight));
          sheet.style.transform = `translateY(${frac * 100}%)`;
        }, { passive: false });
        sheet.addEventListener('touchend', (e) => {
          if (!tTaken) return;
          tTaken = false;
          const dy = e.changedTouches[0].clientY - tY;
          snapNearest(tFrac + dy / window.innerHeight, dy);
        });
      })();

      // ---------- map ----------
      function loadLeaflet() {
        if (leafletPromise) return leafletPromise;
        leafletPromise = new Promise((resolve, reject) => {
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(css);
          const s = document.createElement('script');
          s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          s.onload = () => {
            // Clustering keeps dense city centres readable; failure to load it
            // is non-fatal (we fall back to plain markers).
            ['MarkerCluster.css', 'MarkerCluster.Default.css'].forEach((f) => {
              const c = document.createElement('link');
              c.rel = 'stylesheet';
              c.href = 'https://unpkg.com/leaflet.markercluster@1.5.3/dist/' + f;
              document.head.appendChild(c);
            });
            const mc = document.createElement('script');
            mc.src = 'https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js';
            mc.onload = resolve;
            mc.onerror = () => resolve();
            document.head.appendChild(mc);
          };
          s.onerror = () => { leafletPromise = null; reject(new Error('leaflet')); };
          document.head.appendChild(s);
        });
        return leafletPromise;
      }
      async function ensureMap() {
        await loadLeaflet();
        if (!map) {
          map = L.map('map', { zoomControl: false });
          L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO',
            maxZoom: 19,
          }).addTo(map);
          markerLayer = (L.markerClusterGroup
            ? L.markerClusterGroup({ maxClusterRadius: 45, showCoverageOnHover: false, spiderfyDistanceMultiplier: 1.4 })
            : L.layerGroup()).addTo(map);
          $('map').addEventListener('click', (e) => {
            const el = e.target.closest && e.target.closest('.map-pop');
            if (!el) return;
            if (el.dataset.slug) { map.closePopup(); openDetail(el.dataset.slug); }
            else if (el.dataset.ext != null) {
              const h = extHotels[Number(el.dataset.ext)];
              if (h) { map.closePopup(); openExtDetail(h); }
            }
          });
        }
        setTimeout(() => map.invalidateSize(), 60);
      }
      // Pin tap opens a mini-card ON the map; tapping it goes to the detail
      // (official) or the AI-call form (unlisted).
      function popupHtml(h) {
        const name = isJa && h.nameJa ? h.nameJa : h.name;
        const km = h.km != null ? (h.km < 1 ? Math.round(h.km * 1000) + 'm' : h.km + 'km') : '';
        const bits = [h.minPrice != null ? '$' + h.minPrice + t.from : '', km].filter(Boolean).join(' ・ ');
        const img = h.thumbnail ? `<img class="mp-thumb" src="${esc(h.thumbnail)}" alt="" />` : `<div class="mp-thumb"></div>`;
        return `<div class="map-pop" data-slug="${esc(h.slug)}">${img}
          <div class="mp-body"><div class="mp-name">${esc(name)}</div><div class="mp-meta">${bits}</div></div>
          <div class="mp-go">›</div></div>`;
      }
      function extPopupHtml(h, i) {
        const bits = [t.cgBadge, h.rating ? '⭐' + h.rating : '', h.km != null ? h.km + 'km' : ''].filter(Boolean).join(' ・ ');
        const th = h.photoUrls && h.photoUrls.length
          ? `<img class="mp-thumb" src="${esc(h.photoUrls[0])}" alt="" />`
          : `<div class="mp-thumb tel">📞</div>`;
        return `<div class="map-pop" data-ext="${i}">${th}
          <div class="mp-body"><div class="mp-name">${esc(h.name)}</div><div class="mp-meta">${bits}</div></div>
          <div class="mp-go">›</div></div>`;
      }
      function updateMap(hotels) {
        if (!map) return;
        markerLayer.clearLayers();
        markersBySlug = {};
        const pts = [];
        hotels.forEach((h) => {
          if (h.lat == null || h.lng == null) return;
          pts.push([h.lat, h.lng]);
          const pin = L.divIcon({
            className: '',
            html: `<span class="price-pin">${h.minPrice != null ? '$' + h.minPrice : '●'}</span>`,
            iconAnchor: [18, 12],
          });
          const m = L.marker([h.lat, h.lng], { icon: pin }).addTo(markerLayer);
          m.bindPopup(popupHtml(h), { closeButton: false, offset: [0, -6] });
          m.on('click', () => track('app_pin_tap', { slug: h.slug }));
          markersBySlug[h.slug] = m;
        });
        currentExtView.forEach((h) => {
          const i = extHotels.indexOf(h);
          if (h.lat == null || h.lng == null) return;
          const pin = L.divIcon({
            className: '',
            html: `<span class="price-pin ext">☎</span>`,
            iconAnchor: [14, 12],
          });
          const m = L.marker([h.lat, h.lng], { icon: pin }).addTo(markerLayer);
          m.bindPopup(extPopupHtml(h, i), { closeButton: false, offset: [0, -6] });
          m.on('click', () => track('app_pin_tap', { ext: i }));
          markersBySlug['ext-' + i] = m;
        });
        const c = lastData && lastData.center;
        if (c) {
          if (centerDot) map.removeLayer(centerDot);
          centerDot = L.circleMarker([c.lat, c.lng], {
            radius: 7, color: '#0d9488', fillColor: '#0d9488', fillOpacity: 0.9,
          }).addTo(map);
          pts.push([c.lat, c.lng]);
        }
        if (pts.length) {
          map.fitBounds(pts, {
            paddingTopLeft: [30, 70],
            // keep pins clear of the half-open sheet
            paddingBottomRight: [30, Math.round(window.innerHeight * (1 - SNAPS[1]) * 0.9)],
            maxZoom: 14,
          });
        }
      }

      // ---------- rendering ----------
      function priceHtml(h) {
        if (h.minPrice == null) return '<div class="pcol"></div>';
        let yen = '';
        if (isJa && rateJPY) {
          const v = h.minPrice * rateJPY;
          const rounded = v >= 1000 ? Math.round(v / 100) * 100 : Math.round(v / 10) * 10;
          yen = `<div class="yen">約¥${rounded.toLocaleString()}</div>`;
        }
        return `<div class="pcol"><div class="usd">${isJa ? '$' + h.minPrice + t.from : t.from + '$' + h.minPrice}</div>${yen}</div>`;
      }

      function cardHtml(h) {
        const name = isJa && h.nameJa ? h.nameJa : h.name;
        const href = (isJa ? '/ja/hotel/' : '/hotel/') + encodeURIComponent(h.slug);
        const km = h.km != null ? (h.km < 1 ? Math.round(h.km * 1000) + 'm' : h.km + 'km') : '';
        // Always show the plan's usable window — "outside hours" alone hides
        // the option of coming back later.
        const win = h.checkIn && h.checkOut ? ` ${esc(h.checkIn)}–${esc(h.checkOut)}` : '';
        const state = h.openNow === true ? `<span class="dot open"></span>${t.openShort}${win}`
                    : h.openNow === false ? `<span class="dot closed"></span>${t.closed}${win}`
                    : win.trim();
        const img = h.thumbnail ? `<img class="thumb" src="${esc(h.thumbnail)}" alt="" loading="lazy" />` : `<div class="thumb"></div>`;
        const meta = `<span class="ofc">${t.ofcBadge}</span>` + [state, km, esc(cityJa(h.city))].filter(Boolean).join('<span style="opacity:.5"> ・ </span>');
        return `<a class="card" href="${href}" data-slug="${esc(h.slug)}">
          ${img}
          <div class="info">
            <div class="name">${esc(name)}</div>
            <div class="meta">${meta}</div>
          </div>
          ${priceHtml(h)}
        </a>`;
      }

      // Unlisted (external) hotels merge into the same results — the user just
      // wants somewhere nearby; the badge and CTA make the difference clear.
      function extCardHtml(h, i) {
        const bits = [];
        if (h.rating) bits.push('⭐' + h.rating);
        if (h.km != null) bits.push(h.km < 1 ? Math.round(h.km * 1000) + 'm' : h.km + 'km');
        if (h.address) bits.push(esc(String(h.address).split(',')[0]));
        const thumb = h.photoUrls && h.photoUrls.length
          ? `<img class="thumb" src="${esc(h.photoUrls[0])}" alt="" loading="lazy" />`
          : `<div class="thumb tel">📞</div>`;
        return `<a class="card" href="#" data-ext="${i}" data-slug="ext-${i}">
          ${thumb}
          <div class="info">
            <div class="name">${esc(h.name)}</div>
            <div class="meta"><span class="ext-badge">${t.cgBadge}</span>${bits.join('<span style="opacity:.5"> ・ </span>')}</div>
          </div>
          <div class="pcol"><div class="yen">${t.cgShort}</div></div>
        </a>`;
      }

      function render(data) {
        lastData = data;
        radiusIdx = 0;
        renderView();
      }

      function renderView() {
        const data = lastData;
        const all = (data && data.hotels) || [];
        let hotels = all.slice();
        // "Open now" keeps unknown-hours listings; it only drops known-closed.
        if (openOnly) hotels = hotels.filter((h) => h.openNow !== false);
        if (budget) hotels = hotels.filter((h) => h.minPrice != null && h.minPrice <= Number(budget));
        const nullLast = (v) => (v == null ? Infinity : v);
        hotels.sort((a, b) => sortBy === 'price'
          ? nullLast(a.minPrice) - nullLast(b.minPrice)
          : nullLast(a.km) - nullLast(b.km));

        // Neighbourhood-first: clip to the current radius, auto-widening past
        // empty tiers so the user always sees something.
        const withinR = (arr, r) => (r == null ? arr : arr.filter((x) => x.km == null || x.km <= r));
        while (
          radiusIdx < RADII.length - 1 &&
          withinR(hotels, RADII[radiusIdx]).length + withinR(extHotels, RADII[radiusIdx]).length === 0
        ) radiusIdx++;
        hotels = withinR(hotels, RADII[radiusIdx]);
        currentExtView = withinR(extHotels, RADII[radiusIdx]);
        currentView = hotels;

        const label = data && data.center && data.center.label ? `${data.center.label}${t.nearLabel}` : '';
        const far = all.length && all[0].km != null && all[0].km > 150;
        $('farToast').classList.toggle('show', !!far);
        const radiusLabel = RADII[radiusIdx] == null ? t.allRange : fmt(t.withinKm, { r: RADII[radiusIdx] });
        const totalShown = hotels.length + currentExtView.length;
        $('sheetStatus').textContent = totalShown
          ? `${label ? label + ' ・ ' : ''}${radiusLabel} ・ ${totalShown}${t.results}`
          : t.noResults;
        $('queryPill').querySelector('.q').textContent = label || ($('q').value || '');

        // Official and unlisted interleave by distance — the user wants the
        // nearest place to rest; the badges carry the recommendation. On price
        // sort, unlisted (no price data) go last.
        const merged = [
          ...hotels.map((h) => ({ ext: false, h })),
          ...currentExtView.map((h) => ({ ext: true, h, i: extHotels.indexOf(h) })),
        ];
        if (sortBy === 'km') merged.sort((a, b) => nullLast(a.h.km) - nullLast(b.h.km));
        list.innerHTML = merged.map((m) => (m.ext ? extCardHtml(m.h, m.i) : cardHtml(m.h))).join('') +
          (RADII[radiusIdx] != null ? `<button class="expand-btn">${t.expandBtn}</button>` : '');
        updateMap(hotels);
      }

      // Cards open the in-app detail/booking flow; the href stays for
      // open-in-new-tab semantics only.
      list.addEventListener('click', (e) => {
        const ex = e.target.closest && e.target.closest('button.expand-btn');
        if (ex) {
          radiusIdx = Math.min(RADII.length - 1, radiusIdx + 1);
          renderView();
          track('app_radius_expand', { r: RADII[radiusIdx] || 'all' });
          return;
        }
        const a = e.target.closest && e.target.closest('a.card');
        if (!a) return;
        e.preventDefault();
        if (a.dataset.ext != null) {
          const h = extHotels[Number(a.dataset.ext)];
          if (h) openExtDetail(h);
          return;
        }
        openDetail(a.dataset.slug);
      });

      // ---------- search flow ----------
      async function enterResults() {
        $('resultsScreen').classList.add('active');
        document.body.style.overflow = 'hidden';
        try { await ensureMap(); } catch (e) { $('sheetStatus').textContent = '⚠️ ' + t.mapFail; setSheet(0); }
      }
      function goHome() {
        $('resultsScreen').classList.remove('active');
        document.body.style.overflow = '';
      }
      $('backBtn').addEventListener('click', () => {
        goHome();
        if (cameFromChat) { cameFromChat = false; openChat(false); }
      });
      $('queryPill').addEventListener('click', () => { cameFromChat = false; goHome(); $('q').focus(); });

      async function search(params) {
        $('homeStatus').textContent = t.searching;
        try {
          const res = await fetch('/api/app/nearby?' + new URLSearchParams({ ...params, limit: 24 }));
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          track('app_search', { mode: data.mode, q: params.q || '' });
          $('homeStatus').textContent = '';
          applyIntent(data.intent);
          // Give the concierge a place name even when the search was by
          // coordinates: fall back to the nearest result's city.
          lastPlaceLabel = (data.center && data.center.label) || (data.hotels[0] && data.hotels[0].city) || '';
          await enterResults();
          setSheet(1);
          render(data);
          loadExternal();
        } catch (e) {
          $('homeStatus').textContent = '⚠️ ' + e.message;
          goHome();
        }
      }

      // Voice queries like "予算50ドルで今すぐ" come back with a server-parsed
      // intent — flip the visible filter controls so the user sees what was
      // understood and can undo it.
      function applyIntent(intent) {
        if (!intent) return;
        if (intent.budgetUsd) {
          const sel = $('budgetSel');
          let opt = sel.querySelector('option[data-ai]');
          if (!opt) {
            opt = document.createElement('option');
            opt.setAttribute('data-ai', '');
            sel.appendChild(opt);
          }
          opt.value = String(intent.budgetUsd);
          opt.textContent = t.budgetUnder + '$' + intent.budgetUsd;
          sel.value = opt.value;
          sel.classList.add('on');
          budget = opt.value;
        }
        if (intent.openNow) {
          openOnly = true;
          $('openBtn').classList.add('on');
        }
        track('app_ai_intent', { budget: intent.budgetUsd || '', open: !!intent.openNow });
      }

      // Filter bar
      $('sortBtn').addEventListener('click', () => {
        sortBy = sortBy === 'km' ? 'price' : 'km';
        $('sortBtn').textContent = (sortBy === 'km' ? t.sortDist : t.sortPrice) + ' ⇅';
        track('app_sort', { by: sortBy });
        renderView();
      });
      $('openBtn').addEventListener('click', () => {
        openOnly = !openOnly;
        $('openBtn').classList.toggle('on', openOnly);
        track('app_filter_open', { on: openOnly });
        renderView();
      });
      $('budgetSel').addEventListener('change', () => {
        budget = $('budgetSel').value;
        $('budgetSel').classList.toggle('on', !!budget);
        track('app_filter_budget', { max: budget || 'any' });
        renderView();
      });

      // ---------- conversational concierge ----------
      const chatLog = $('chatLog');
      let greeted = false;
      let cameFromChat = false;
      const fmt = (s, vars) => s.replace(/\{(\w+)\}/g, (_, k) => (vars[k] != null ? vars[k] : ''));

      // Deliberately no text-to-speech: replies are silent. Voice is an input
      // method only — unexpected audio in public spaces is hostile UX.

      function openChat() {
        $('chatScreen').classList.add('open');
        if (!greeted) {
          greeted = true;
          aiSay(t.chatGreeting, {});
        }
      }
      function closeChat() {
        $('chatScreen').classList.remove('open');
      }
      $('chatBack').addEventListener('click', closeChat);

      function scrollChat() { chatLog.scrollTop = chatLog.scrollHeight; }
      function addUserMsg(text) {
        chatLog.insertAdjacentHTML('beforeend', `<div class="msg user"><div class="bubble">${esc(text)}</div></div>`);
        scrollChat();
      }
      let typingEl = null;
      function showTyping() {
        chatLog.insertAdjacentHTML('beforeend', `<div class="msg ai" id="typingMsg"><div class="bubble typing">…</div></div>`);
        typingEl = document.getElementById('typingMsg');
        scrollChat();
      }
      function hideTyping() { if (typingEl) { typingEl.remove(); typingEl = null; } }

      function aiSay(text, opts) {
        const o = opts || {};
        hideTyping();
        let inner = `<div class="bubble">${esc(text)}</div>`;
        if (o.cards && currentView.length) {
          inner += `<div class="cards">${currentView.slice(0, 3).map(cardHtml).join('')}</div>`;
        }
        const chips = [];
        if (o.chips) {
          chips.push(`<button class="primary" data-act="map">${t.chatShowMap}</button>`);
          if (sortBy !== 'price') chips.push(`<button data-act="cheaper">${t.chipCheaper}</button>`);
          if (!openOnly) chips.push(`<button data-act="open">${t.chipOpen}</button>`);
        }
        if (o.cgChip) chips.push(`<button class="primary" data-act="concierge">${t.chipConcierge}</button>`);
        if (chips.length) inner += `<div class="chat-chips">${chips.join('')}</div>`;
        chatLog.insertAdjacentHTML('beforeend', `<div class="msg ai">${inner}</div>`);
        scrollChat();
      }

      // ---------- concierge: unlisted hotels + AI phone confirmation ----------
      const cgSessionId = (crypto.randomUUID && crypto.randomUUID()) || 'app-' + Date.now() + '-' + String(Math.random()).slice(2, 8);
      let lastPlaceLabel = '';
      let extHotels = [];
      let extSeq = 0;
      let cgHotels = [];
      let cgTarget = null;
      const GUEST_KEY = 'ddhGuest';
      const getGuest = () => { try { return JSON.parse(localStorage.getItem(GUEST_KEY) || '{}'); } catch (e) { return {}; } };
      const saveGuest = (g) => { try { localStorage.setItem(GUEST_KEY, JSON.stringify(g)); } catch (e) {} };

      // Background fetch of unlisted hotels for the merged results. Official
      // results render instantly; these append when Google Places answers.
      async function loadExternal() {
        extHotels = [];
        const seq = ++extSeq;
        const q = (lastData && lastData.hotels && lastData.hotels[0] && lastData.hotels[0].city) || lastPlaceLabel;
        if (!q) return;
        const c = lastData && lastData.center;
        try {
          const params = { q };
          if (c) { params.lat = c.lat; params.lng = c.lng; }
          const r = await fetch('/api/app/external?' + new URLSearchParams(params));
          const d = await r.json();
          if (seq !== extSeq) return;
          extHotels = (d.hotels || []).slice(0, 5);
          if (extHotels.length) {
            renderView();
            track('app_ext_results', { n: extHotels.length });
          }
        } catch (e) {}
      }

      async function conciergeSearch() {
        track('app_cg_search', { q: lastPlaceLabel });
        aiSay(t.cgSearching, {});
        showTyping();
        try {
          const q = lastPlaceLabel || $('q').value || '';
          const msg = (isJa ? 'デイユースで使えるホテルを探して: ' : 'find day use hotels near ') + q;
          const r = await fetch('/api/concierge/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ session_id: cgSessionId, message: msg, locale: isJa ? 'ja' : 'en' }),
          });
          const d = await r.json();
          hideTyping();
          const ext = ((d.metadata && d.metadata.hotels) || []).filter((h) => h.source === 'external' && h.phone && h.name);
          if (!ext.length) { aiSay(t.cgNone, {}); return; }
          cgHotels = ext.slice(0, 3);
          let inner = `<div class="bubble">${esc(t.cgIntro)}</div>`;
          inner += cgHotels
            .map((h, i) => `<div class="ext-card">
              <div class="top"><div class="ename">${esc(h.name)}</div><span class="ext-badge">${t.cgBadge}</span></div>
              ${h.address ? `<div class="emeta">📍 ${esc(h.address)}</div>` : ''}
              ${h.rating ? `<div class="emeta">⭐ ${esc(String(h.rating))}</div>` : ''}
              <button class="call-cta" data-cg="${i}">${t.cgCallBtn}</button>
            </div>`)
            .join('');
          chatLog.insertAdjacentHTML('beforeend', `<div class="msg ai">${inner}</div>`);
          scrollChat();
          track('app_cg_results', { n: cgHotels.length });
        } catch (e) {
          hideTyping();
          aiSay(t.cgFail, {});
        }
      }

      const hourOpts = (from, to, sel) => {
        let s = '';
        for (let h = from; h <= to; h++) {
          const v = String(h).padStart(2, '0') + ':00';
          s += `<option value="${v}"${v === sel ? ' selected' : ''}>${v}</option>`;
        }
        return s;
      };
      function openCallPanel(h) {
        cgTarget = h;
        $('callHotelLine').textContent = h.name;
        const d = new Date();
        const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        $('cgDate').min = iso;
        if (!$('cgDate').value) $('cgDate').value = iso;
        $('cgFrom').innerHTML = hourOpts(6, 22, '10:00');
        $('cgTo').innerHTML = hourOpts(7, 23, '18:00');
        $('cgGuests').innerHTML = Array.from({ length: 4 }, (_, i) => `<option value="${i + 1}">${i + 1}${t.ppl}</option>`).join('');
        $('cgHint').textContent = '';
        openPanel('callPanel');
        track('app_cg_form_open', { hotel: h.name });
      }
      $('callClose').addEventListener('click', () => closePanel('callPanel'));
      $('cgSubmit').addEventListener('click', async () => {
        if (!$('cgDate').value || !cgTarget) {
          $('cgHint').textContent = t.fillAll;
          return;
        }
        if ($('cgFrom').value >= $('cgTo').value) {
          $('cgHint').textContent = `${t.cgTimeFrom} < ${t.cgTimeTo}`;
          return;
        }
        $('cgSubmit').disabled = true;
        $('cgHint').textContent = t.searching;
        try {
          const guests = Number($('cgGuests').value || 1);
          // Contact-free inquiry: the free call needs no guest details; they
          // are collected only at the accept/payment step.
          const r = await fetch('/api/concierge/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              session_id: cgSessionId,
              message: '__create_call_group_direct',
              locale: isJa ? 'ja' : 'en',
              guests,
              _call_group: {
                guest_name: '',
                guest_email: '',
                guest_phone: '',
                guests,
                adults: guests,
                children: 0,
                check_in_date: $('cgDate').value,
                check_in_time: $('cgFrom').value,
                check_out_time: $('cgTo').value,
                hotels: [{
                  hotel_name: cgTarget.name,
                  hotel_phone: cgTarget.phone,
                  hotel_source: 'external',
                  recommendation_reason: 'Requested via mobile app',
                }],
              },
            }),
          });
          const d = await r.json();
          if (d.error) throw new Error(d.error);
          if (d.group_id) {
            saveInquiry({ g: d.group_id, s: cgSessionId, hotel: cgTarget.name, date: $('cgDate').value, ts: Date.now() });
          }
          closePanel('callPanel');
          if ($('chatScreen').classList.contains('open')) aiSay(t.cgDone, {});
          // Land the user where the result will appear.
          $('myBookingsBtn').click();
          track('app_cg_call_requested', { hotel: cgTarget.name });
        } catch (e) {
          $('cgHint').textContent = '⚠️ ' + t.cgFail;
        } finally {
          $('cgSubmit').disabled = false;
        }
      });

      function performAct(act) {
        if (act === 'concierge') { conciergeSearch(); return; }
        if (!lastData) return;
        if (act === 'map') {
          cameFromChat = true;
          closeChat();
          enterResults().then(() => { setSheet(1); renderView(); });
          track('app_chat_map');
          return;
        }
        if (act === 'cheaper') {
          sortBy = 'price';
          $('sortBtn').textContent = t.sortPrice + ' ⇅';
          renderView();
          aiSay(t.chatSorted, { cards: true, chips: true });
        }
        if (act === 'open') {
          openOnly = true;
          $('openBtn').classList.add('on');
          renderView();
          aiSay(t.chatOpenOnly, { cards: true, chips: true });
        }
        track('app_chat_refine', { act });
      }
      chatLog.addEventListener('click', (e) => {
        const cta = e.target.closest && e.target.closest('button.call-cta');
        if (cta) { const h = cgHotels[Number(cta.dataset.cg)]; if (h) openCallPanel(h); return; }
        const chip = e.target.closest && e.target.closest('button[data-act]');
        if (chip) { performAct(chip.dataset.act); return; }
        const a = e.target.closest && e.target.closest('a.card');
        if (a) { e.preventDefault(); openDetail(a.dataset.slug); }
      });

      // Short refinement utterances tweak the current results; anything longer
      // goes through the full search (which has its own AI intent parsing).
      async function handleUtterance(text, voice) {
        text = (text || '').trim();
        if (!text) return;
        addUserMsg(text);
        track('app_chat_msg', { voice: !!voice });

        if (lastData) {
          const short = text.length <= 12;
          if (/地図|マップ|全件|全部見|map/i.test(text) && short) { performAct('map'); return; }
          if (/安い順|もっと安|cheap/i.test(text) && short) { performAct('cheaper'); return; }
          if (/^(営業中|今すぐ|いま|open now).{0,6}$/i.test(text)) { performAct('open'); return; }
          const bm = text.match(/^\D*(\d[\d,]*)\s*(ドル|\$|dollars?|円)\D*$/i);
          if (bm && short) {
            let usd = Number(bm[1].replace(/,/g, ''));
            if (/円/.test(bm[2]) && rateJPY) usd = Math.round(usd / rateJPY);
            budget = String(usd);
            $('budgetSel').classList.add('on');
            renderView();
            aiSay(fmt(t.chatBudget, { b: usd, n: currentView.length }), { cards: true, chips: true });
            return;
          }
        }

        showTyping();
        try {
          const res = await fetch('/api/app/nearby?' + new URLSearchParams({ q: text, limit: 24 }));
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          track('app_search', { mode: data.mode, q: text });
          if (!data.hotels || !data.hotels.length) { aiSay(t.chatNoHit, { cgChip: true }); return; }
          applyIntent(data.intent);
          render(data);
          const label = (data.center && data.center.label) || text;
          lastPlaceLabel = label;
          loadExternal();
          const prices = currentView.map((h) => h.minPrice).filter((v) => v != null);
          const cheap = prices.length ? fmt(t.chatCheap, { p: Math.min(...prices) }) : '';
          aiSay(fmt(t.chatFound, { label, n: currentView.length, cheap }), { cards: true, chips: true });
        } catch (e) {
          aiSay(t.chatNoHit, {});
        }
      }

      const sendChat = () => {
        const v = $('chatInput').value.trim();
        if (!v) return;
        $('chatInput').value = '';
        handleUtterance(v, false);
      };
      $('chatSend').addEventListener('click', sendChat);
      $('chatInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') sendChat(); });

      // ---------- inputs ----------
      $('geoBtn').addEventListener('click', () => {
        $('homeStatus').textContent = t.searching;
        navigator.geolocation.getCurrentPosition(
          (pos) => search({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
          () => { $('homeStatus').textContent = t.noGeo; $('q').focus(); },
          { enableHighAccuracy: false, timeout: 8000, maximumAge: 60000 }
        );
      });

      // Text queries flow through the concierge conversation.
      const doTextSearch = () => {
        const q = $('q').value.trim();
        if (!q) return;
        $('q').value = '';
        openChat(false);
        handleUtterance(q, false);
      };
      $('goBtn').addEventListener('click', doTextSearch);
      $('q').addEventListener('keydown', (e) => { if (e.key === 'Enter') doTextSearch(); });

      document.querySelectorAll('#areas .area').forEach((b) =>
        b.addEventListener('click', () => { $('q').value = b.dataset.q; search({ q: b.dataset.q }); })
      );

      // Voice = conversation. Recognition results go through handleUtterance,
      // and speak() auto-relistens after the reply for a hands-free loop.
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      function startVoice(btn, onText) {
        if (!SR) return;
        if (window.__ddhRec) { try { window.__ddhRec.stop(); } catch (e) {} return; }
        const rec = new SR();
        window.__ddhRec = rec;
        rec.lang = isJa ? 'ja-JP' : 'en-US';
        rec.interimResults = false;
        rec.maxAlternatives = 1;
        btn.classList.add('listening');
        rec.onresult = (e) => {
          track('app_voice_search');
          onText(e.results[0][0].transcript);
        };
        rec.onend = () => { btn.classList.remove('listening'); window.__ddhRec = null; };
        rec.onerror = () => {};
        rec.start();
      }
      if (!SR) {
        $('micBtn').style.display = 'none';
        $('micFab').style.display = 'none';
        $('chatMic').style.display = 'none';
      } else {
        const voiceToChat = () => {
          openChat(true);
          startVoice($('chatMic'), (x) => handleUtterance(x, true));
        };
        $('micBtn').addEventListener('click', voiceToChat);
        $('micFab').addEventListener('click', voiceToChat);
        $('chatMic').addEventListener('click', () => startVoice($('chatMic'), (x) => handleUtterance(x, true)));
      }

      // ---------- in-app detail / booking / payment ----------
      let selHotel = null;
      let selPlan = null;
      let paypalSdkPromise = null;
      let buttonsRendered = false;

      const yenOf = (usd) => {
        if (!isJa || !rateJPY || usd == null) return '';
        const v = usd * rateJPY;
        return '約¥' + (v >= 1000 ? Math.round(v / 100) * 100 : Math.round(v / 10) * 10).toLocaleString();
      };
      const openPanel = (id) => $(id).classList.add('open');
      const closePanel = (id) => $(id).classList.remove('open');

      async function openDetail(slug) {
        track('app_card_tap', { slug });
        const cur = currentView.find((h) => h.slug === slug) || {};
        $('heroScroll').innerHTML = `<img src="${esc(cur.thumbnail || '')}" alt="" />`;
        $('heroCount').style.display = 'none';
        $('descWrap').style.display = 'none';
        $('detailName').textContent = (isJa && cur.nameJa) || cur.name || '';
        const km = cur.km != null ? (cur.km < 1 ? Math.round(cur.km * 1000) + 'm' : cur.km + 'km') : '';
        const state = cur.openNow === true ? t.openShort : cur.openNow === false ? t.closed : '';
        $('detailMeta').textContent = [cityJa(cur.city), km, state].filter(Boolean).join(' ・ ');
        $('detailWebLink').href = (isJa ? '/ja/hotel/' : '/hotel/') + encodeURIComponent(slug);
        $('detailWebLink').textContent = t.webDetail;
        $('detailWebLink').target = '';
        $('detailWebLink').style.display = '';
        $('planTitle').style.display = '';
        $('extCta').style.display = 'none';
        $('planList').innerHTML = `<div class="panel-meta">${t.searching}</div>`;
        openPanel('detailPanel');
        try {
          const r = await fetch(`/api/hotels/${encodeURIComponent(slug)}/plans${isJa ? '?lang=ja' : ''}`);
          const d = await r.json();
          if (d.error) throw new Error(d.error);
          selHotel = d.hotel;
          if (isJa && d.hotel.name_ja) $('detailName').textContent = d.hotel.name_ja;
          // photo gallery (swipe) + hotel description
          const imgs = (d.hotel.images && d.hotel.images.length ? d.hotel.images : [cur.thumbnail]).filter(Boolean);
          if (imgs.length) {
            $('heroScroll').innerHTML = imgs.map((u) => `<img src="${esc(u)}" alt="" loading="lazy" />`).join('');
            $('heroScroll').scrollLeft = 0;
            if (imgs.length > 1) {
              $('heroCount').textContent = `1/${imgs.length}`;
              $('heroCount').style.display = 'block';
              $('heroScroll').onscroll = () => {
                const i = Math.round($('heroScroll').scrollLeft / $('heroScroll').clientWidth) + 1;
                $('heroCount').textContent = `${Math.min(i, imgs.length)}/${imgs.length}`;
              };
            }
          }
          const desc = ((isJa && d.hotel.description_ja) || d.hotel.description || '').trim();
          if (desc) {
            $('detailDesc').textContent = desc;
            $('detailDesc').classList.add('clamp');
            $('descMore').style.display = '';
            $('descWrap').style.display = 'block';
          }
          const plans = d.plans || [];
          if (!plans.length) {
            $('planList').innerHTML = `<div class="panel-meta">${t.noPlans}</div>`;
            return;
          }
          $('planList').innerHTML = plans
            .map((p) => {
              const name = isJa && p.name_ja ? p.name_ja : p.name;
              const bits = [];
              if (p.check_in_time && p.check_out_time) bits.push(`${p.check_in_time}–${p.check_out_time}`);
              if (p.duration_hours) bits.push(`${p.duration_hours}${t.hrs}`);
              if (p.max_guests) bits.push(`${t.upTo}${p.max_guests}${t.ppl}`);
              return `<button class="plan" data-plan="${p.id}">
                <div class="pinfo"><div class="pname">${esc(name)}</div><div class="pmeta">${esc(bits.join(' ・ '))}</div></div>
                <div class="pprice"><div class="usd">$${p.price_usd}</div><div class="yen">${yenOf(p.price_usd)}</div></div>
                <div class="go">›</div>
              </button>`;
            })
            .join('');
          $('planList').querySelectorAll('.plan').forEach((btn) =>
            btn.addEventListener('click', () => {
              const p = plans.find((x) => String(x.id) === btn.dataset.plan);
              if (p) openBook(p);
            })
          );
        } catch (e) {
          $('planList').innerHTML = `<div class="panel-meta">⚠️ ${esc(e.message)}</div>`;
        }
      }
      $('detailClose').addEventListener('click', () => closePanel('detailPanel'));

      // Unlisted hotels get the same detail treatment (photos, rating, address)
      // before the AI-call ask — enough to decide whether it is worth calling.
      let extDetailTarget = null;
      function openExtDetail(h) {
        extDetailTarget = h;
        track('app_ext_detail', { hotel: h.name });
        const photos = h.photoUrls || [];
        $('heroScroll').innerHTML = photos.length
          ? photos.map((u) => `<img src="${esc(u)}" alt="" loading="lazy" />`).join('')
          : `<div class="mp-thumb tel" style="width:100%;height:100%;border-radius:0;font-size:44px">📞</div>`;
        $('heroScroll').scrollLeft = 0;
        if (photos.length > 1) {
          $('heroCount').textContent = `1/${photos.length}`;
          $('heroCount').style.display = 'block';
          $('heroScroll').onscroll = () => {
            const i = Math.round($('heroScroll').scrollLeft / $('heroScroll').clientWidth) + 1;
            $('heroCount').textContent = `${Math.min(i, photos.length)}/${photos.length}`;
          };
        } else {
          $('heroCount').style.display = 'none';
        }
        $('detailName').textContent = h.name || '';
        const km = h.km != null ? (h.km < 1 ? Math.round(h.km * 1000) + 'm' : h.km + 'km') : '';
        $('detailMeta').textContent = [t.cgBadge, h.rating ? '⭐' + h.rating : '', km, h.address || ''].filter(Boolean).join(' ・ ');
        $('descWrap').style.display = 'none';
        $('planTitle').style.display = 'none';
        $('planList').innerHTML = '';
        $('extNote').textContent = t.extIntro + (h.photoAttribution ? `　（${t.photoBy}: ${h.photoAttribution}）` : '');
        $('extCta').style.display = 'block';
        if (h.website) {
          $('detailWebLink').href = h.website;
          $('detailWebLink').textContent = t.extWeb;
          $('detailWebLink').target = '_blank';
          $('detailWebLink').style.display = '';
        } else {
          $('detailWebLink').style.display = 'none';
        }
        openPanel('detailPanel');
      }
      $('extCallBtn').addEventListener('click', () => {
        if (extDetailTarget) openCallPanel(extDetailTarget);
      });

      function openBook(plan) {
        selPlan = plan;
        track('app_book_open', { plan: plan.id });
        const pname = isJa && plan.name_ja ? plan.name_ja : plan.name;
        $('bookHotelLine').textContent = selHotel ? selHotel.name : '';
        const hours = plan.check_in_time && plan.check_out_time ? `${plan.check_in_time}–${plan.check_out_time}` : '';
        $('bookSummary').innerHTML =
          `<div class="row"><span class="k">${t.planLabel}</span><span>${esc(pname)}</span></div>` +
          (hours ? `<div class="row"><span class="k">${t.hoursLabel}</span><span>${esc(hours)}</span></div>` : '') +
          `<div class="row total"><span>${t.total}</span><span class="v">$${plan.price_usd} <small style="color:var(--muted);font-weight:400">${yenOf(plan.price_usd)}</small></span></div>`;
        const d = new Date();
        const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const bkDate = $('bkDate');
        bkDate.min = iso;
        if (!bkDate.value) bkDate.value = iso;
        const maxG = Math.min(plan.max_guests || 4, 8);
        $('bkGuests').innerHTML = Array.from({ length: maxG }, (_, i) => `<option value="${i + 1}">${i + 1}${t.ppl}</option>`).join('');
        openPanel('bookPanel');
        setupPay();
      }
      $('bookClose').addEventListener('click', () => closePanel('bookPanel'));

      const formValid = () =>
        !!($('bkName').value.trim() && /.+@.+\..+/.test($('bkEmail').value.trim()) && $('bkDate').value);
      function updateLock() {
        const ok = formValid();
        $('paypalBox').classList.toggle('locked', !ok);
        $('payHint').textContent = ok ? '' : t.fillAll;
      }
      ['bkName', 'bkEmail', 'bkDate'].forEach((id) => $(id).addEventListener('input', updateLock));

      const bookingPayload = () => ({
        plan_id: selPlan.id,
        guest_name: $('bkName').value.trim(),
        guest_email: $('bkEmail').value.trim(),
        guest_phone: $('bkPhone').value.trim(),
        check_in_date: $('bkDate').value,
        adults: Number($('bkGuests').value || 1),
        children: 0,
        infants: 0,
        notes: '',
      });

      function showDone(bookingId) {
        const pname = isJa && selPlan.name_ja ? selPlan.name_ja : selPlan.name;
        $('doneBox').innerHTML =
          `<div class="row"><span class="k">${t.bookingNo}</span><span>${esc(String(bookingId))}</span></div>` +
          `<div class="row"><span class="k">${t.hotelLabel}</span><span>${esc(selHotel ? selHotel.name : '')}</span></div>` +
          `<div class="row"><span class="k">${t.planLabel}</span><span>${esc(pname)}</span></div>` +
          `<div class="row"><span class="k">${t.dateLabel}</span><span>${esc($('bkDate').value)}</span></div>` +
          `<div class="row total"><span>${t.total}</span><span class="v">$${selPlan.price_usd}</span></div>`;
        openPanel('donePanel');
        saveBooking({
          id: bookingId,
          hotel: selHotel ? selHotel.name : '',
          plan: pname,
          date: $('bkDate').value,
          price: selPlan.price_usd,
        });
        track('app_booking_done', { booking: bookingId });
      }
      $('doneClose').addEventListener('click', () => {
        ['donePanel', 'bookPanel', 'detailPanel'].forEach(closePanel);
      });

      // ---------- my bookings (guest, device-local) ----------
      const BK_KEY = 'ddhBookings';
      const getBookings = () => {
        try { return JSON.parse(localStorage.getItem(BK_KEY) || '[]'); } catch (e) { return []; }
      };
      function saveBooking(b) {
        const bks = getBookings().filter((x) => x.id !== b.id);
        bks.unshift(b);
        try { localStorage.setItem(BK_KEY, JSON.stringify(bks.slice(0, 10))); } catch (e) {}
        refreshBkBtn();
      }
      const INQ_KEY = 'ddhInquiries';
      const getInquiries = () => {
        try { return JSON.parse(localStorage.getItem(INQ_KEY) || '[]'); } catch (e) { return []; }
      };
      function saveInquiry(q) {
        const list = getInquiries().filter((x) => x.g !== q.g);
        list.unshift(q);
        try { localStorage.setItem(INQ_KEY, JSON.stringify(list.slice(0, 10))); } catch (e) {}
        refreshBkBtn();
      }
      function refreshBkBtn() {
        $('myBookingsBtn').classList.toggle('show', getBookings().length + getInquiries().length > 0);
      }
      refreshBkBtn();
      $('bkListClose').addEventListener('click', () => { stopBkPolling(); closePanel('bkListPanel'); });
      $('myBookingsBtn').addEventListener('click', () => {
        const bks = getBookings();
        const inqs = getInquiries();
        openPanel('bkListPanel');
        track('app_bookings_open', { n: bks.length, inq: inqs.length });
        if (!bks.length && !inqs.length) {
          $('bkList').innerHTML = `<div class="panel-meta">${t.noBookings}</div>`;
          return;
        }
        let inqHtml = '';
        if (inqs.length) {
          inqHtml = `<div class="sec-title">${t.inqTitle}</div>` + inqs
            .map((q) => `<div class="bk-item">
              <div class="top"><div class="hname">${esc(q.hotel || '')}</div><span class="st pending" id="inq-st-${esc(String(q.g))}">${t.stChecking}</span></div>
              <div class="meta2">${esc(q.date || '')}</div>
              <div id="inq-act-${esc(String(q.g))}"></div>
            </div>`)
            .join('') + (bks.length ? `<div class="sec-title">${t.bookingsTitle}</div>` : '');
        }
        $('bkList').innerHTML = inqHtml + (bks.length ? '' : '');
        $('bkList').innerHTML += bks
          .map((b) => `<div class="bk-item">
            <div class="top"><div class="hname">${esc(b.hotel || '')}</div><span class="st pending" id="st-${esc(String(b.id))}">${t.stChecking}</span></div>
            <div class="meta2">${esc(b.plan || '')}</div>
            <div class="meta2">${esc(b.date || '')} ・ ${t.bookingNo}${esc(String(b.id))}${b.price != null ? ' ・ $' + esc(String(b.price)) : ''}</div>
          </div>`)
          .join('');
        startBkPolling();
        markInquiriesSeen();
      });

      // ── Live status polling while My Bookings is open ──────────────────────
      // Both /api/booking-status and /api/app/call-status read live D1 state
      // (booking.status, concierge_calls.status/price_quoted/accepted), so the
      // panel refreshes itself while the AI is on the phone — no reopen needed.
      // Complements the in-panel toast polling: checks quietly on load and on
      // app resume so a result that lands while the panel is closed still gets
      // surfaced, as a badge on the entry button.
      const SEEN_KEY = 'ddhInqSeen';
      const getSeen = () => { try { return JSON.parse(localStorage.getItem(SEEN_KEY) || '{}'); } catch (e) { return {}; } };
      const setSeen = (o) => { try { localStorage.setItem(SEEN_KEY, JSON.stringify(o)); } catch (e) {} };

      async function inquiryState(q) {
        const r = await fetch('/api/app/call-status?' + new URLSearchParams({ group: String(q.g), session: q.s }));
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        const calls = d.calls || [];
        if (calls.find((c) => c.accepted)) return 'accepted';
        if (calls.find((c) => c.price != null && c.accept_token)) return 'quoted';
        if (calls.length && calls.every((c) => ['unavailable', 'no_answer', 'over_budget', 'voicemail'].includes(c.outcome || ''))) return 'na';
        return 'calling';
      }

      async function checkInquiriesQuietly() {
        const inqs = getInquiries();
        if (!inqs.length || $('bkListPanel').classList.contains('open')) return;
        const seen = getSeen();
        let unseen = 0;
        for (const q of inqs) {
          try {
            const state = await inquiryState(q);
            if ((state === 'quoted' || state === 'na') && seen[q.g] !== state) unseen++;
          } catch (e) {}
        }
        const badge = $('bkBadge');
        badge.textContent = unseen ? `${t.newResult} ${unseen}` : '';
        badge.classList.toggle('show', unseen > 0);
      }
      function markInquiriesSeen() {
        const seen = getSeen();
        Promise.all(getInquiries().map(async (q) => {
          try { seen[q.g] = await inquiryState(q); } catch (e) {}
        })).then(() => setSeen(seen));
        $('bkBadge').classList.remove('show');
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') checkInquiriesQuietly();
      });
      setTimeout(checkInquiriesQuietly, 1500);

      let bkPollTimer = null;
      let bkToastEl = null;
      const bkPrev = {};
      function bkToast(msg) {
        if (!bkToastEl) {
          bkToastEl = document.createElement('div');
          bkToastEl.style.cssText = 'position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%);background:#111;color:#fff;padding:12px 18px;border-radius:12px;font-size:14px;font-weight:600;z-index:200;box-shadow:0 6px 24px rgba(0,0,0,.3);opacity:0;transition:opacity .25s;pointer-events:none;max-width:88vw;text-align:center;';
          document.body.appendChild(bkToastEl);
        }
        bkToastEl.textContent = msg;
        bkToastEl.style.opacity = '1';
        clearTimeout(bkToastEl._t);
        bkToastEl._t = setTimeout(() => { bkToastEl.style.opacity = '0'; }, 4000);
      }
      function startBkPolling() {
        stopBkPolling();
        tickBkPolling();
        bkPollTimer = setInterval(tickBkPolling, 8000);
      }
      function stopBkPolling() {
        if (bkPollTimer) { clearInterval(bkPollTimer); bkPollTimer = null; }
      }
      async function tickBkPolling() {
        let pending = false;
        try { if (await refreshBookingStatuses()) pending = true; } catch (e) {}
        try { if (await pollInquiries()) pending = true; } catch (e) {}
        if (!pending) stopBkPolling();
      }
      async function refreshBookingStatuses() {
        const bks = getBookings();
        let pending = false;
        await Promise.all(bks.map(async (b) => {
          const el = document.getElementById('st-' + b.id);
          if (!el) return;
          try {
            const r = await fetch('/api/booking-status?order=' + encodeURIComponent(b.id));
            const d = await r.json();
            const s = String(d.status || '').toLowerCase();
            const key = s === 'confirmed' || s === 'completed' ? 'confirmed'
                      : s === 'cancelled' || s === 'rejected' ? 'cancelled' : 'pending';
            el.textContent = key === 'confirmed' ? t.stConfirmed : key === 'cancelled' ? t.stCancelled : t.stPending;
            el.className = 'st ' + key;
            if (key === 'pending') pending = true;
            const pk = 'bk-' + b.id;
            if (bkPrev[pk] && bkPrev[pk] !== key && key === 'confirmed') bkToast('✓ ' + (b.hotel || '') + ' — ' + t.stConfirmed);
            if (bkPrev[pk] && bkPrev[pk] !== key && key === 'cancelled') bkToast((b.hotel || '') + ' — ' + t.stCancelled);
            bkPrev[pk] = key;
          } catch (e) {
            el.textContent = t.stPending;
            pending = true;
          }
        }));
        return pending;
      }

      // Poll inquiry-call results and surface the quote with a book CTA.
      let acceptTarget = null;
      async function pollInquiries() {
        let pending = false;
        for (const q of getInquiries()) {
          const st = document.getElementById('inq-st-' + q.g);
          const act = document.getElementById('inq-act-' + q.g);
          if (!st) continue;
          try {
            const r = await fetch('/api/app/call-status?' + new URLSearchParams({ group: String(q.g), session: q.s }));
            const d = await r.json();
            if (d.error) throw new Error(d.error);
            const calls = d.calls || [];
            const quoted = calls.find((c) => c.price != null && c.accept_token);
            const accepted = calls.find((c) => c.accepted);
            const allDead = calls.length && calls.every((c) => ['unavailable', 'no_answer', 'over_budget', 'voicemail'].includes(c.outcome || ''));
            let key;
            if (accepted) {
              key = 'accepted';
              st.textContent = t.inqAccepted;
              st.className = 'st confirmed';
              if (act) act.innerHTML = '';
            } else if (quoted) {
              key = 'quoted';
              st.textContent = t.inqQuoted;
              st.className = 'st confirmed';
              if (act) act.innerHTML = `<button class="call-cta" data-token="${esc(quoted.accept_token)}" data-hotel="${esc(quoted.hotel)}" style="margin-top:8px">${t.inqBook} — ${esc(quoted.currency || '')} ${esc(String(quoted.price))}</button>`;
            } else if (allDead) {
              key = 'na';
              st.textContent = t.inqNA;
              st.className = 'st cancelled';
              if (act) act.innerHTML = '';
            } else {
              key = 'calling';
              st.textContent = t.inqCalling;
              st.className = 'st pending';
              pending = true;
            }
            const pk = 'inq-' + q.g;
            if (bkPrev[pk] && bkPrev[pk] !== key) {
              if (key === 'quoted') bkToast('☎ ' + (q.hotel || '') + ' — ' + t.inqQuoted);
              else if (key === 'accepted') bkToast('✓ ' + (q.hotel || '') + ' — ' + t.inqAccepted);
            }
            bkPrev[pk] = key;
          } catch (e) {
            st.textContent = t.inqCalling;
            pending = true;
          }
        }
        return pending;
      }
      $('bkList').addEventListener('click', (e) => {
        const btn = e.target.closest && e.target.closest('button.call-cta');
        if (!btn) return;
        acceptTarget = { token: btn.dataset.token, hotel: btn.dataset.hotel };
        $('acceptHotelLine').textContent = acceptTarget.hotel || '';
        const g = getGuest();
        if (g.name && !$('acName').value) $('acName').value = g.name;
        if (g.email && !$('acEmail').value) $('acEmail').value = g.email;
        if (g.phone && !$('acPhone').value) $('acPhone').value = g.phone;
        $('acHint').textContent = '';
        openPanel('acceptPanel');
        track('app_inq_accept_open');
      });
      $('acceptClose').addEventListener('click', () => closePanel('acceptPanel'));
      $('acGo').addEventListener('click', async () => {
        const name = $('acName').value.trim();
        const email = $('acEmail').value.trim();
        if (!acceptTarget || !name || !/.+@.+\..+/.test(email)) {
          $('acHint').textContent = t.fillAll;
          return;
        }
        $('acGo').disabled = true;
        $('acHint').textContent = t.searching;
        try {
          saveGuest({ name, email, phone: $('acPhone').value.trim() });
          const r = await fetch('/api/app/call-contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: acceptTarget.token, name, email, phone: $('acPhone').value.trim() }),
          });
          const d = await r.json();
          if (!d.ok) throw new Error(d.error || 'failed');
          $('acHint').textContent = '';
          closePanel('acceptPanel');
          window.open('/concierge/accept?token=' + encodeURIComponent(acceptTarget.token), '_blank');
          track('app_inq_accept_go');
        } catch (e) {
          $('acHint').textContent = '⚠️ ' + t.cgFail;
        } finally {
          $('acGo').disabled = false;
        }
      });

      $('descMore').addEventListener('click', () => {
        $('detailDesc').classList.remove('clamp');
        $('descMore').style.display = 'none';
      });

      function loadPayPalSdk() {
        if (paypalSdkPromise) return paypalSdkPromise;
        paypalSdkPromise = new Promise((resolve, reject) => {
          const s = document.createElement('script');
          const locale = isJa ? 'ja_JP' : 'en_US';
          s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(paypalClientId)}&currency=USD&locale=${locale}&intent=capture&commit=true`;
          s.onload = () => (window.paypal ? resolve() : reject(new Error('paypal sdk')));
          s.onerror = () => { paypalSdkPromise = null; reject(new Error('paypal sdk')); };
          document.head.appendChild(s);
        });
        return paypalSdkPromise;
      }

      async function setupPay() {
        updateLock();
        // Test mode (?test_pay=1) or missing client id: simulator button.
        if (testPay || !paypalClientId || paypalClientId.length < 10) {
          $('paypalBox').innerHTML = `<button class="test-pay-btn" id="testPayGo">${t.testPayBtn}</button>`;
          $('testPayGo').addEventListener('click', async () => {
            if (!formValid()) { updateLock(); return; }
            $('payHint').textContent = t.paying;
            try {
              const r = await fetch('/api/payments/test-capture', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(bookingPayload()),
              });
              const d = await r.json();
              if (!d.success) throw new Error(d.error || 'failed');
              $('payHint').textContent = '';
              showDone(d.booking_id);
            } catch (e) {
              $('payHint').textContent = '⚠️ ' + t.payFailed;
            }
          });
          return;
        }
        if (buttonsRendered) return;
        try {
          await loadPayPalSdk();
        } catch (e) {
          $('payHint').textContent = '⚠️ ' + t.payFailed;
          return;
        }
        window.paypal.Buttons({
          style: { layout: 'vertical', height: 44, label: 'paypal' },
          onClick: (data, actions) => {
            if (formValid()) return actions.resolve();
            updateLock();
            return actions.reject();
          },
          createOrder: async () => {
            const r = await fetch('/api/payments/create', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ plan_id: selPlan.id }),
            });
            const d = await r.json();
            if (!d.order_id) throw new Error(d.error || 'order failed');
            return d.order_id;
          },
          onApprove: async (data) => {
            $('payHint').textContent = t.paying;
            try {
              const r = await fetch('/api/payments/capture', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_id: data.orderID, ...bookingPayload() }),
              });
              const d = await r.json();
              if (!d.success) throw new Error(d.error || 'capture failed');
              $('payHint').textContent = '';
              showDone(d.booking_id);
            } catch (e) {
              $('payHint').textContent = '⚠️ ' + t.payFailed;
            }
          },
          onError: () => { $('payHint').textContent = '⚠️ ' + t.payFailed; },
        }).render('#paypalBox');
        buttonsRendered = true;
      }

      // PWA service worker (scoped to /app so the main site is untouched)
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/app-sw.js', { scope: '/app' }).catch(() => {});
      }

      // Install promotion. Android/Chrome fires beforeinstallprompt; iOS never
      // does, so show a one-time "Add to Home Screen" walkthrough instead.
      const banner = $('installBanner');
      const standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
      const dismissed = localStorage.getItem('ddhAppInstallDismissed');
      $('installText').textContent = t.installBanner;
      $('installGo').textContent = t.installBtn;
      let deferredPrompt = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (!standalone && !dismissed) {
          banner.classList.add('show');
          track('app_install_prompt_shown');
        }
      });
      $('installGo').addEventListener('click', async () => {
        banner.classList.remove('show');
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        track('app_install_' + choice.outcome);
        deferredPrompt = null;
      });
      $('installX').addEventListener('click', () => {
        banner.classList.remove('show');
        localStorage.setItem('ddhAppInstallDismissed', '1');
        track('app_install_dismissed');
      });
      if (/iPhone|iPad|iPod/.test(navigator.userAgent) && !standalone && !dismissed) {
        $('installText').textContent = t.iosHint;
        $('installGo').style.display = 'none';
        banner.classList.add('show');
        track('app_install_ios_hint_shown');
      }
    </script>
  </body>
</html>
