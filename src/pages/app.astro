// Japan is intentionally absent — DDH does not plan to list Japanese hotels.
const areas: Array<{ label: string; q: string; img: string }> = [
  { label: isJa ? 'バンコク' : 'Bangkok', q: 'BKK', img: '/cities/bangkok.jpg' },
  { label: isJa ? 'シンガポール' : 'Singapore', q: 'SIN', img: '/cities/singapore.jpg' },
  { label: isJa ? 'クアラルンプール' : 'Kuala Lumpur', q: 'KUL', img: '/cities/kuala_lumpur.jpg' },
  { label: isJa ? 'セブ' : 'Cebu', q: 'CEB', img: '/cities/cebu.jpg' },
  { label: isJa ? '香港' : 'Hong Kong', q: 'HKG', img: '/cities/hong_kong.jpg' },
  { label: isJa ? 'バリ' : 'Bali', q: 'DPS', img: '/cities/bali.jpg' },
  { label: isJa ? 'ドバイ' : 'Dubai', q: 'DXB', img: '/cities/dubai.jpg' },
  { label: isJa ? 'プーケット' : 'Phuket', q: 'HKT', img: '/cities/phuket.jpg' },
