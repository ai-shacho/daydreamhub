---
// Mobile PWA: "find a day-use hotel right now".
// Light travel-app visual language (white surfaces, teal brand accent, photo
// area tiles). Two screens: a launcher home and a full-screen map results view
// with a draggable bottom sheet (Google Maps / Airbnb pattern).
import { resolvePayPalConfig } from '../lib/paypal';
import { VOICE_LANGS } from '../lib/voiceLangs';
import { COUNTRIES } from '../lib/data/countries';

const acceptLang = Astro.request.headers.get('accept-language') || '';
const urlLang = Astro.url.searchParams.get('lang');
// Precedence: an explicit ?lang, then the choice this device made before
// (cookie, so the server renders it directly and the page never flashes),
// then the device's own language.
const cookieLang = (Astro.request.headers.get('cookie') || '').match(/(?:^|;\s*)ddh_app_lang=(en|ja)/)?.[1];
const isJa = urlLang ? urlLang === 'ja' : cookieLang ? cookieLang === 'ja' : /(^|,)\s*ja/i.test(acceptLang);

// Remember an explicit ?lang, the same way the in-app toggle does. Arriving
// from the English site carries ?lang=en, and without this the next visit —
// including an installed app launching at the bare /app in its manifest —
// would fall back to the device's language and flip back.
if (urlLang === 'en' || urlLang === 'ja') {
  Astro.cookies.set('ddh_app_lang', urlLang, {
    path: '/', maxAge: 31536000, sameSite: 'lax',
  });
}
// Same GA4 property as the main site (Layout.astro) so app usage shows up
// alongside site traffic, distinguished by the app_* event names.
const ga4Id = ((Astro.locals as any).runtime?.env?.GA4_MEASUREMENT_ID as string) || 'G-5C6B1R3H1Q';
// In-app checkout: same server-resolved PayPal client id the booking page uses.
const paypalClientId = (resolvePayPalConfig((Astro.locals as any).runtime?.env).clientId || '').trim();
// iOS builds no splash screen from the manifest — without a startup image for
// the exact device geometry it shows a blank white screen until the page paints.
// [css width, css height, dpr]; images come from scripts/make-ios-splash.py.
const IOS_SPLASH: [number, number, number][] = [
  [440, 956, 3], [430, 932, 3], [402, 874, 3], [393, 852, 3],
  [428, 926, 3], [390, 844, 3], [375, 812, 3], [414, 896, 3],
  [414, 896, 2], [414, 736, 3], [375, 667, 2],
];
// ?test_pay=1 — staging/E2E only: replaces PayPal with the test-capture simulator.
const testPay = Astro.url.searchParams.get('test_pay') === '1';

