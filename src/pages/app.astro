      bookingNo: '予約番号',
      close: '閉じる',
      webDetail: 'Web版でレビューを見る →',
      aboutHotel: '施設について',
      more: '…もっと見る',
      myBookings: '📋 予約の確認',
      bookingsTitle: 'あなたの予約',
      stPending: 'ホテル確認待ち',
      stConfirmed: '確定',
      stCancelled: 'キャンセル',
      stChecking: '確認中…',
      noBookings: 'まだ予約はありません',
      testPayBtn: 'テスト決済を実行（PayPalなし）',
      noPlans: '現在予約できるプランがありません',
    }
  : {
      title: 'DayDreamHub — Day-use now',
      tagline: 'A place to rest, right now.',
      sub: 'Got spare time at the airport or in town? Find hourly day-use hotels instantly.',
      here: 'Search near me',
      voice: 'Search by voice',
      placeholder: 'City or airport name',
      micHint: 'Tap to speak',
      searching: 'Searching…',
      noGeo: 'Could not get your location. Try searching by place name.',
      listening: 'Listening…',
      noResults: 'No facilities found.',
      farNote: 'No facilities near you — showing the closest covered area',
      nearLabel: '',
      results: ' places',
      popular: 'Popular areas',
      openShort: 'Usable now',
      closed: 'Outside hours',
      from: 'From ',
      sortDist: 'By distance',
      sortPrice: 'By price',
      openOnly: 'Usable now',
      budgetAny: 'Any budget',
      budgetUnder: 'Under ',
      viewSite: 'Open full website',
      install: 'Add to Home Screen to use this as an app.',
      installBanner: 'Add this app to your home screen',
      installBtn: 'Install',
      iosHint: 'On iPhone: Share button (□↑) → "Add to Home Screen"',
      mapFail: 'Could not load the map',
      chatTitle: 'AI Concierge',
      chatGreeting: 'Hi! Where would you like to rest? Try "Bangkok" or "somewhere cheap near Changi Airport".',
      chatPlaceholder: 'Type a message…',
      chatFound: 'Found {n} places near {label}. {cheap}Say "cheaper" or "open now" to refine.',
      chatCheap: 'Cheapest from ${p}. ',
      chatSorted: 'Sorted by price, cheapest first.',
      chatOpenOnly: 'Showing only places within their day-use hours right now.',
      chatBudget: 'Filtered to under ${b} ({n} places).',
      chatNoHit: "Sorry, I couldn't find that. Try including a city or airport name (e.g. Bangkok, Changi Airport).",
      chatShowMap: '🗺 See all on the map',
      chipConcierge: '🤖 Search unlisted hotels',
      cgSearching: 'Searching beyond our listings… (takes 10–20s)',
      cgIntro: 'Found unlisted hotels that may offer day-use. Our AI phones them to confirm day-use, availability and price — inquiries are free; a $7 fee applies only when a booking is made.',
      cgNone: 'No extra candidates found. Try a different area name.',
      cgBadge: 'Unlisted',
      ofcBadge: 'Official',
