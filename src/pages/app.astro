---
// Mobile PWA: "find a day-use hotel right now" — geolocation + voice search.
// Standalone shell (no site header/footer) so it feels like an app when
// installed to the home screen.
const acceptLang = Astro.request.headers.get('accept-language') || '';
const urlLang = Astro.url.searchParams.get('lang');
const isJa = urlLang ? urlLang === 'ja' : /(^|,)\s*ja/i.test(acceptLang);

const t = isJa
  ? {
      title: 'DayDreamHub — 今すぐデイユース',
      tagline: 'いま休める場所を、すぐに。',
      sub: '空港や街なかで空いた時間に。時間貸しのホテルをすぐ探せます。',
      here: '現在地から探す',
      placeholder: '例：羽田空港 / バンコク',
      micHint: 'タップして話す',
      searching: '検索中…',
      noGeo: '位置情報が取得できませんでした。場所名で検索してください。',
      listening: '聞き取り中…どうぞ',
      noResults: '該当する施設が見つかりませんでした。',
      nearLabel: 'の近くのデイユース施設',
      openNow: '営業時間内',
      closed: '時間外',
      from: '〜',
      viewSite: 'Webサイト版はこちら',
      install: 'ホーム画面に追加すると、アプリとして使えます。',
    }
  : {
      title: 'DayDreamHub — Day-use now',
      tagline: 'A place to rest, right now.',
      sub: 'Got spare time at the airport or in town? Find hourly day-use hotels instantly.',
      here: 'Search near me',
      placeholder: 'e.g. Changi Airport / Bangkok',
      micHint: 'Tap to speak',
      searching: 'Searching…',
      noGeo: 'Could not get your location. Try searching by place name.',
      listening: 'Listening…',
      noResults: 'No facilities found.',
      nearLabel: ' — nearby day-use hotels',
      openNow: 'Open now',
      closed: 'Outside hours',
      from: 'From ',
      viewSite: 'Open full website',
      install: 'Add to Home Screen to use this as an app.',
    };

const quickChips: Array<{ label: string; q: string }> = isJa
  ? [
      { label: '羽田', q: 'HND' },
      { label: '成田', q: 'NRT' },
      { label: '関空', q: 'KIX' },
      { label: 'チャンギ', q: 'SIN' },
      { label: 'スワンナプーム', q: 'BKK' },
      { label: '仁川', q: 'ICN' },
      { label: 'ドバイ', q: 'DXB' },
    ]
  : [
      { label: 'Changi (SIN)', q: 'SIN' },
      { label: 'Suvarnabhumi (BKK)', q: 'BKK' },
      { label: 'KLIA (KUL)', q: 'KUL' },
      { label: 'Haneda (HND)', q: 'HND' },
      { label: 'Incheon (ICN)', q: 'ICN' },
      { label: 'Dubai (DXB)', q: 'DXB' },
    ];
---
<html lang={isJa ? 'ja' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.title}</title>
    <meta name="description" content={t.sub} />
    <link rel="manifest" href="/app-manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DayDreamHub" />
    <link rel="apple-touch-icon" href="/app-icon-180.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        --bg: #0f172a;
        --card: #1e293b;
        --accent: #38bdf8;
        --accent2: #818cf8;
        --text: #f1f5f9;
        --muted: #94a3b8;
        --ok: #34d399;
        --warn: #fbbf24;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
        min-height: 100vh;
        padding-bottom: env(safe-area-inset-bottom);
      }
      header.bar {
        display: flex; align-items: center; gap: 10px;
        padding: calc(12px + env(safe-area-inset-top)) 16px 12px;
        position: sticky; top: 0; background: rgba(15,23,42,.92);
        backdrop-filter: blur(8px); z-index: 10;
      }
      header.bar img { width: 28px; height: 28px; border-radius: 6px; }
      header.bar strong { font-size: 16px; letter-spacing: .02em; }
      main { padding: 8px 16px 40px; max-width: 560px; margin: 0 auto; }
      h1 { font-size: 24px; line-height: 1.3; margin: 10px 0 6px; }
      p.sub { color: var(--muted); font-size: 13px; margin-bottom: 18px; }
      .geo-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 16px; border: 0; border-radius: 14px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        color: #0b1120; font-size: 17px; font-weight: 700; cursor: pointer;
      }
      .geo-btn:active { transform: scale(.98); }
      .search-row { display: flex; gap: 8px; margin-top: 12px; }
      .search-row input {
        flex: 1; padding: 14px; border-radius: 12px; border: 1px solid #334155;
        background: var(--card); color: var(--text); font-size: 16px; min-width: 0;
      }
      .icon-btn {
        width: 52px; flex: none; border-radius: 12px; border: 1px solid #334155;
        background: var(--card); color: var(--text); font-size: 20px; cursor: pointer;
      }
      .icon-btn.listening { background: #b91c1c; border-color: #ef4444; animation: pulse 1s infinite; }
      @keyframes pulse { 50% { opacity: .6; } }
      .chips { display: flex; gap: 8px; overflow-x: auto; margin: 14px 0 4px; padding-bottom: 4px; }
      .chips button {
        flex: none; padding: 8px 14px; border-radius: 999px; border: 1px solid #334155;
        background: transparent; color: var(--muted); font-size: 13px; cursor: pointer;
      }
      #status { margin: 14px 0; color: var(--muted); font-size: 14px; min-height: 20px; }
      #results { display: flex; flex-direction: column; gap: 12px; }
      a.card {
        display: flex; gap: 12px; background: var(--card); border-radius: 14px;
        overflow: hidden; text-decoration: none; color: var(--text);
      }
      a.card:active { opacity: .8; }
      .thumb { width: 96px; height: 96px; flex: none; object-fit: cover; background: #334155; }
      .info { padding: 10px 12px 10px 0; min-width: 0; flex: 1; }
      .info .name { font-size: 15px; font-weight: 700; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
      .info .meta { color: var(--muted); font-size: 12px; margin-top: 4px; }
      .badges { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; align-items: center; }
      .badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 600; }
      .badge.km { background: #0c4a6e; color: #7dd3fc; }
      .badge.open { background: #064e3b; color: var(--ok); }
      .badge.closed { background: #451a03; color: var(--warn); }
      .price { font-size: 13px; color: var(--accent); font-weight: 700; margin-left: auto; }
      footer { margin-top: 28px; text-align: center; font-size: 12px; color: var(--muted); }
      footer a { color: var(--accent); }
      .install-hint { margin-top: 10px; font-size: 11px; }
    </style>
  </head>
  <body>
    <header class="bar">
      <img src="/logo.png" alt="DDH" />
      <strong>DayDreamHub</strong>
    </header>
    <main>
      <h1>{t.tagline}</h1>
      <p class="sub">{t.sub}</p>

      <button class="geo-btn" id="geoBtn">📍 {t.here}</button>

      <div class="search-row">
        <input id="q" type="search" placeholder={t.placeholder} enterkeyhint="search" />
        <button class="icon-btn" id="micBtn" title={t.micHint} aria-label={t.micHint}>🎤</button>
        <button class="icon-btn" id="goBtn" aria-label="search">🔍</button>
      </div>

      <div class="chips" id="chips">
        {quickChips.map((c) => <button data-q={c.q}>{c.label}</button>)}
      </div>

      <div id="status"></div>
      <div id="results"></div>

      <footer>
        <a href={isJa ? '/ja' : '/'}>{t.viewSite}</a>
        <div class="install-hint">{t.install}</div>
      </footer>
    </main>

    <script define:vars={{ t, isJa }}>
      const $ = (id) => document.getElementById(id);
      const status = $('status');
      const results = $('results');

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      function render(data) {
        const hotels = data.hotels || [];
        if (!hotels.length) {
          status.textContent = t.noResults;
          results.innerHTML = '';
          return;
        }
        const label = data.center && data.center.label
          ? (isJa ? `${data.center.label}${t.nearLabel}` : `${data.center.label}${t.nearLabel}`)
          : '';
        status.textContent = label;
        results.innerHTML = hotels
          .map((h) => {
            const name = isJa && h.nameJa ? h.nameJa : h.name;
            const href = (isJa ? '/ja/hotel/' : '/hotel/') + encodeURIComponent(h.slug);
            const km = h.km != null ? `<span class="badge km">${h.km < 1 ? Math.round(h.km * 1000) + 'm' : h.km + 'km'}</span>` : '';
            const open = h.openNow === true ? `<span class="badge open">${t.openNow}</span>`
                       : h.openNow === false ? `<span class="badge closed">${t.closed}</span>` : '';
            const price = h.minPrice != null ? `<span class="price">${isJa ? '$' + h.minPrice + t.from : t.from + '$' + h.minPrice}</span>` : '';
            const img = h.thumbnail ? `<img class="thumb" src="${esc(h.thumbnail)}" alt="" loading="lazy" />` : `<div class="thumb"></div>`;
            const hours = h.checkIn && h.checkOut ? ` ・ ${esc(h.checkIn)}–${esc(h.checkOut)}` : '';
            return `<a class="card" href="${href}">
              ${img}
              <div class="info">
                <div class="name">${esc(name)}</div>
                <div class="meta">${esc(h.city || '')}${h.country ? ', ' + esc(h.country) : ''}${hours}</div>
                <div class="badges">${km}${open}${price}</div>
              </div>
            </a>`;
          })
          .join('');
      }

      async function search(params) {
        status.textContent = t.searching;
        results.innerHTML = '';
        try {
          const res = await fetch('/api/app/nearby?' + new URLSearchParams(params));
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          render(data);
        } catch (e) {
          status.textContent = '⚠️ ' + e.message;
        }
      }

      $('geoBtn').addEventListener('click', () => {
        status.textContent = t.searching;
        navigator.geolocation.getCurrentPosition(
          (pos) => search({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
          () => { status.textContent = t.noGeo; $('q').focus(); },
          { enableHighAccuracy: false, timeout: 8000, maximumAge: 60000 }
        );
      });

      const doTextSearch = () => {
        const q = $('q').value.trim();
        if (q) search({ q });
      };
      $('goBtn').addEventListener('click', doTextSearch);
      $('q').addEventListener('keydown', (e) => { if (e.key === 'Enter') doTextSearch(); });

      document.querySelectorAll('#chips button').forEach((b) =>
        b.addEventListener('click', () => { $('q').value = b.dataset.q; search({ q: b.dataset.q }); })
      );

      // Voice input (Web Speech API — Safari/Chrome on mobile)
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      const micBtn = $('micBtn');
      if (!SR) {
        micBtn.style.display = 'none';
      } else {
        let rec = null;
        micBtn.addEventListener('click', () => {
          if (rec) { rec.stop(); return; }
          rec = new SR();
          rec.lang = isJa ? 'ja-JP' : 'en-US';
          rec.interimResults = false;
          rec.maxAlternatives = 1;
          micBtn.classList.add('listening');
          status.textContent = t.listening;
          rec.onresult = (e) => {
            const text = e.results[0][0].transcript;
            $('q').value = text;
            search({ q: text });
          };
          rec.onerror = () => { status.textContent = t.noGeo; };
          rec.onend = () => { micBtn.classList.remove('listening'); rec = null; };
          rec.start();
        });
      }

      // PWA service worker (scoped to /app so the main site is untouched)
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/app-sw.js', { scope: '/app' }).catch(() => {});
      }
    </script>
  </body>
</html>
