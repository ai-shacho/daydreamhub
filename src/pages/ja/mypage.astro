---
import MyBookings from '../../components/MyBookings.astro';
import { getGuestSession } from '../../lib/guestSession';

const env = (Astro.locals as any).runtime?.env;
const currentUser = await getGuestSession(Astro.request, env);
if (!currentUser) return Astro.redirect('/ja/login?redirect=/ja/mypage');
---

<MyBookings currentUser={currentUser} />
