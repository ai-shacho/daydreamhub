---
import Layout from '../../layouts/Layout.astro';
import { resolvePayPalConfig } from '../../lib/paypal';
import ConciergeHero from '../../components/ConciergeHero.astro';

const runtime = (Astro.locals as any).runtime;
const paypalClientId = resolvePayPalConfig(runtime?.env).clientId;
---

<Layout title="AIコンシェルジュ - DayDreamHub" description="AIがホテルに電話して予約。世界85都市のデイユースホテル。">
  <ConciergeHero locale="ja" paypalClientId={paypalClientId} />
</Layout>
